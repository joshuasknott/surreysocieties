---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import AssistantWidget from '@surreysocieties/ui/components/AssistantWidget';
import { ASSISTANT_CONFIGS } from '@surreysocieties/ui';
import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import neurotechLogo from '../assets/neurotech-logo.png';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const society = getSocietyById('neurotech')!;
const assistantConfig = ASSISTANT_CONFIGS.neurotech;
const siteName = society.name;
const fullTitle = `${title} | ${siteName}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/committee', label: 'Committee' },
];

const isCurrent = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="bg-neuro-ivory text-neuro-ink font-sans min-h-screen flex flex-col"
  extraFontHrefs={[
    'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,650;9..144,750;9..144,850&display=swap',
  ]}
>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-neuro-paper focus:text-neuro-ink focus:font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-neuro-gold shadow-lg rounded-md">
    Skip to content
  </a>

  <nav class="neuro-site-nav sticky top-0 z-50" role="navigation" aria-label="Main navigation">
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-6">
      <a href="/" class="flex min-w-0 items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neuro-gold" aria-label="Surrey Neurotech Society home">
        <Image
          src={neurotechLogo}
          alt=""
          width={92}
          height={92}
          class="h-11 w-11 shrink-0 rounded-md object-contain"
        />
        <span class="neuro-site-nav__brand hidden min-w-0 whitespace-nowrap text-sm font-extrabold uppercase sm:block lg:text-base">
          Surrey Neurotech Society
        </span>
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-bold uppercase transition-colors',
              isCurrent(link.href)
                ? 'bg-neuro-gold/15 text-neuro-gold'
                : 'text-neuro-on-dark-muted hover:text-neuro-gold',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href="/join" class="neuro-btn-primary ml-3 px-5 py-2 text-xs">
          Join the society
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="rounded-md p-3 text-neuro-on-dark-muted transition-colors hover:text-neuro-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neuro-gold md:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" id="hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-neuro-line-dark bg-neuro-deep md:hidden">
      <div class="flex flex-col px-5 py-3">
        {navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-3 text-sm font-bold uppercase transition-colors',
              isCurrent(link.href)
                ? 'bg-neuro-gold/15 text-neuro-gold'
                : 'text-neuro-on-dark-muted hover:text-neuro-gold',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href="/join" class="neuro-btn-primary mt-3 w-full text-sm">
          Join
        </a>
      </div>
    </div>
  </nav>

  <main id="main-content" class="flex-1" tabindex="-1">
    <slot />
  </main>

  <footer class="border-t border-neuro-line-dark bg-neuro-deep text-neuro-on-dark-muted">
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="mb-6 flex items-center gap-4">
            <Image src={neurotechLogo} alt="" width={100} height={100} class="h-12 w-12 rounded-md object-contain" loading="lazy" />
            <div>
              <p class="neuro-serif text-2xl text-neuro-on-dark">Surrey Neurotech Society</p>
              <p class="mt-1 text-sm text-neuro-gold">Established {society.establishedYear}</p>
            </div>
          </div>
          <p class="max-w-md border-l border-neuro-gold/60 pl-5 text-sm leading-7">
            A student-led neurotechnology society connecting students across psychology, computing, engineering, and beyond with neuroscience, artificial intelligence, and responsible innovation.
          </p>
        </div>

        <div class="lg:col-span-3 lg:col-start-7">
          <h2 class="mb-4 text-sm font-extrabold uppercase text-neuro-gold">Explore</h2>
          <div class="flex flex-col items-start gap-3">
            {navLinks.map((link) => (
              <a href={link.href} class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">{link.label}</a>
            ))}
            <a href="/join" class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">Join</a>
          </div>
        </div>

        <div class="lg:col-span-3">
          <h2 class="mb-4 text-sm font-extrabold uppercase text-neuro-gold">Connect</h2>
          <div class="flex flex-col items-start gap-3">
            {society.socials.instagram && (
              <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">Instagram</a>
            )}
            {society.socials.linkedin && (
              <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">LinkedIn</a>
            )}
            <a href={`mailto:${society.contactEmail}`} class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">Email</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">Students' Union</a>
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold transition-colors hover:text-neuro-on-dark">Membership</a>
          </div>
        </div>
      </div>

      <div class="mt-12 flex flex-col gap-3 border-t border-neuro-line-dark pt-8 text-xs sm:flex-row sm:items-center sm:justify-between">
        <p>&copy; {new Date().getFullYear()} Surrey Neurotech Society. A society of Surrey Students' Union.</p>
        <p class="font-semibold text-neuro-gold/80">{society.domain}</p>
      </div>
    </div>
  </footer>

  <AssistantWidget config={assistantConfig} endpoint="/api/assistant/chat" />

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    btn?.addEventListener('click', () => {
      const willOpen = menu?.classList.contains('hidden') ?? false;
      menu?.classList.toggle('hidden', !willOpen);
      hamburger?.classList.toggle('hidden', willOpen);
      closeIcon?.classList.toggle('hidden', !willOpen);
      btn.setAttribute('aria-expanded', String(willOpen));
      btn.setAttribute('aria-label', willOpen ? 'Close navigation menu' : 'Open navigation menu');
    });

    const revealElements = Array.from(document.querySelectorAll<HTMLElement>('.reveal'))
      .filter((element) => !element.closest('.neuro-hero'));

    const revealElement = (element: HTMLElement) => {
      element.classList.add('visible');

    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) {
            revealElement(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }),
        { threshold: 0.12 }
      );
      revealElements.forEach((element) => observer.observe(element));
    } else {
      revealElements.forEach((element) => element.classList.add('visible'));
    }
  </script>
</BaseLayout>
