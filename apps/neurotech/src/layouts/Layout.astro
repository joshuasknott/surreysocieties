---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import { getSocietyById } from '@surreysocieties/admin/config';

interface Props {
  title: string;
  description: string;
  /** Absolute URL to OG share image. Defaults to site-wide fallback. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const society = getSocietyById('neurotech')!;
const siteName = society.name;
const fullTitle = `${title} — ${siteName}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/committee', label: 'Committee' },
  { href: '/events', label: 'Events' },
  { href: '/join', label: 'Join' },
];
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="bg-primary text-text-primary font-sans min-h-screen flex flex-col transition-colors duration-300"
>
  <!-- Theme Init Script — runs before paint to prevent FOUC -->
  <script is:inline>
    const getTheme = () => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('surrey-neurotech-theme')) {
        return localStorage.getItem('surrey-neurotech-theme');
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    const theme = getTheme();
    document.documentElement.setAttribute('data-theme', theme);
  </script>
  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-primary border-b-2 border-gold/30">
    <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img
          src="/logos/neurotech-logo.png"
          alt="Surrey Neurotech Society"
          width="36"
          height="36"
          class="h-9 w-9 rounded-full ring-2 ring-gold/30"
        />
        <span class="text-text-on-dark font-bold text-lg tracking-tight hidden sm:block">
          Surrey <span class="text-gold">Neurotech</span> Society
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-lg transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold bg-gold/10'
                : 'text-text-on-dark-secondary hover:text-text-on-dark hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
        
        <!-- Theme Toggle -->
        <button
          type="button"
          id="theme-toggle"
          aria-label="Switch to dark mode"
          class="px-4 py-2 flex items-center text-text-on-dark-secondary hover:text-text-on-dark transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded-lg hover:bg-white/5"
        >
          <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-text-on-dark p-2 hover:bg-white/10 rounded-lg transition-colors"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gold/20 bg-primary">
      <div class="px-6 py-3 flex flex-col gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2.5 text-sm font-medium rounded-lg transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold bg-gold/10'
                : 'text-text-on-dark-secondary hover:text-text-on-dark hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-primary-deep text-text-on-dark-secondary border-t border-gold/20">
    <div class="circuit-trace"></div>
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid sm:grid-cols-3 gap-8 mb-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <img
              src="/logos/neurotech-logo.png"
              alt=""
              width="32"
              height="32"
              class="h-8 w-8 rounded-full"
            />
            <span class="text-text-on-dark font-bold">Surrey Neurotech Society</span>
          </div>
          <p class="text-sm leading-relaxed">
            A student-led society under Surrey Students' Union. Exploring neuroscience, technology, brain-computer interfaces, and human-centred innovation.
          </p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-gold">Established {society.establishedYear}</p>
        </div>
        <div>
          <h4 class="text-text-on-dark font-semibold mb-3 text-sm uppercase tracking-wider">Pages</h4>
          <div class="flex flex-col gap-2">
            {navLinks.map(link => (
              <a href={link.href} class="text-sm hover:text-gold transition-colors">{link.label}</a>
            ))}
          </div>
        </div>
        <div>
          <h4 class="text-text-on-dark font-semibold mb-3 text-sm uppercase tracking-wider">Connect</h4>
          <div class="flex flex-col gap-2 text-sm">
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">Instagram</a>
            <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">LinkedIn</a>
            <a href={`mailto:${society.contactEmail}`} class="hover:text-gold transition-colors">Email</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">Surrey Students' Union</a>
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition-colors">Membership</a>
          </div>
        </div>
      </div>
      <div class="border-t border-gold/20 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
        <p>&copy; 2025 Surrey Neurotech Society. A student society at the University of Surrey.</p>
        <p class="text-gold/60">{society.domain}</p>
      </div>
    </div>
  </footer>

  <!--
    Neurotech-specific: Lenis fluid scroll + GSAP ScrollTrigger integration.
    Kept here (not in BaseLayout) because it is unique to this app.
    The mobile-menu toggle from BaseLayout runs first; this script runs after.
  -->
  <script>
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    // ── Theme toggle ──
    const themeBtn = document.getElementById('theme-toggle');
    const iconDark = document.getElementById('theme-icon-dark');
    const iconLight = document.getElementById('theme-icon-light');

    function updateThemeUI(theme: string) {
      const isDark = theme === 'dark';

      document.documentElement.setAttribute('data-theme', theme);

      iconDark?.classList.toggle('hidden', !isDark);
      iconLight?.classList.toggle('hidden', isDark);

      themeBtn?.setAttribute(
        'aria-label',
        isDark ? 'Switch to light mode' : 'Switch to dark mode'
      );
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      localStorage.setItem('surrey-neurotech-theme', newTheme);
      updateThemeUI(newTheme);
    });

    gsap.registerPlugin(ScrollTrigger);

    // Initialize Lenis for fluid, organic scrolling
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      direction: 'vertical',
      gestureDirection: 'vertical',
      smooth: true,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // Sync GSAP with Lenis
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0, 0);
  </script>
</BaseLayout>
