---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import AssistantWidget from '@surreysocieties/ui/components/AssistantWidget';
import { ASSISTANT_CONFIGS } from '@surreysocieties/ui';
import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import { Menu, X } from 'lucide-astro';
import neurotechMark from '../assets/neurotech-logo.png';
import defaultOgImage from '../assets/showcase/neurotech-hero-lab.png';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const society = getSocietyById('neurotech')!;
const assistantConfig = ASSISTANT_CONFIGS.neurotech;
const fullTitle = `${title} | ${society.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage ?? new URL(defaultOgImage.src, Astro.site).toString();

const navLinks = [
  { href: '/#activities', label: 'What we do' },
  { href: '/#updates', label: 'Updates' },
  { href: '/#contact', label: 'Contact' },
];
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={resolvedOgImage}
  canonicalUrl={canonicalUrl}
  htmlClass="nt-scroll"
  bodyClass="nt-body"
  extraFontHrefs={[
    'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap',
  ]}
>
  <a href="#main-content" class="nt-skip">Skip to content</a>

  <header class="nt-header">
    <div class="nt-header__inner">
      <a href="/" class="nt-brand" aria-label="Surrey Neurotech Society home">
        <Image
          src={neurotechMark}
          alt=""
          width={96}
          height={96}
          loading="eager"
          class="nt-brand__mark"
        />
        <span class="nt-brand__name" aria-hidden="true">Surrey Neurotech Society</span>
      </a>

      <nav class="nt-nav" aria-label="Main navigation">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="nt-button nt-button--yellow nt-nav__join" href={society.membershipUrl} target="_blank" rel="noopener noreferrer">Join</a>
      </nav>

      <button
        id="nt-menu-button"
        class="nt-menu-button"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="nt-mobile-menu"
      >
        <Menu class="nt-menu-icon nt-menu-icon--open" size={24} aria-hidden="true" />
        <X class="nt-menu-icon nt-menu-icon--close" size={24} aria-hidden="true" />
      </button>
    </div>

    <nav id="nt-mobile-menu" class="nt-mobile-menu" aria-label="Mobile navigation" hidden>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nt-button nt-button--yellow" href={society.membershipUrl} target="_blank" rel="noopener noreferrer">Join the society</a>
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <footer id="contact" class="nt-footer">
    <div class="nt-footer__inner">
      <a href="/" class="nt-footer__brand" aria-label="Surrey Neurotech Society home">
        <Image src={neurotechMark} alt="" width={68} height={68} loading="lazy" class="nt-footer__mark" />
        <span class="nt-brand__name" aria-hidden="true">Surrey Neurotech Society</span>
      </a>
      <div class="nt-footer__links">
        <a href={`mailto:${society.contactEmail}`}>{society.contactEmail}</a>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer">@SurreyNeurotech</a>
        <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer">Surrey Neurotech</a>
        <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer">Students' Union</a>
      </div>
    </div>
    <div class="nt-footer__legal">© {new Date().getFullYear()} Surrey Neurotech Society</div>
  </footer>

  <AssistantWidget config={assistantConfig} endpoint="/api/assistant/chat" />

  <script>
    document.documentElement.classList.add('js-enabled');

    const menuButton = document.getElementById('nt-menu-button');
    const mobileMenu = document.getElementById('nt-mobile-menu');

    const setMenuOpen = (open: boolean) => {
      if (!menuButton || !mobileMenu) return;
      mobileMenu.hidden = !open;
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      menuButton.classList.toggle('is-open', open);
    };

    menuButton?.addEventListener('click', () => {
      setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      revealElements.forEach((element) => element.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
      revealElements.forEach((element) => observer.observe(element));
    }
  </script>
</BaseLayout>
