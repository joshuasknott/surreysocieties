---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import AssistantWidget from '@surreysocieties/ui/components/AssistantWidget';
import { ASSISTANT_CONFIGS } from '@surreysocieties/ui';
import { getSocietyById } from '@surreysocieties/admin/config';

interface Props {
  title: string;
  description: string;
  /** Absolute URL to OG share image. Defaults to site-wide fallback. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const society = getSocietyById('neurotech')!;
const assistantConfig = ASSISTANT_CONFIGS.neurotech;
const siteName = society.name;
const fullTitle = `${title} — ${siteName}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/committee', label: 'Committee' },
  { href: '/events', label: 'Events' },
  { href: '/join', label: 'Join' },
];
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="bg-navy-950 text-slate-100 font-sans min-h-screen flex flex-col smooth-transition"
>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-navy-900 focus:text-gold-500 focus:font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 shadow-lg rounded-lg border border-gold-500/20">
    Skip to content
  </a>

  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-navy-950/85 backdrop-blur-md border-b border-navy-800" aria-label="Main navigation">
    <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/logos/neurotech-logo.png"
          alt="Surrey Neurotech Society"
          width="36"
          height="36"
          class="h-9 w-9 rounded-full ring-2 ring-gold-500/30 group-hover:ring-gold-500/60 transition-all duration-300"
        />
        <span class="text-white font-bold text-lg tracking-tight hidden sm:block">
          Surrey <span class="text-gold-500">Neurotech</span> Society
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 border',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold-500 bg-gold-500/10 border-gold-500/25 shadow-[0_0_12px_rgba(212,175,55,0.05)]'
                : 'text-slate-300 border-transparent hover:text-gold-300 hover:bg-white/5 hover:border-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-slate-200 p-2 hover:bg-navy-800 hover:text-white rounded-lg transition-colors border border-transparent active:border-navy-700"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-navy-800 bg-navy-900">
      <div class="px-6 py-4 flex flex-col gap-1.5">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3 text-sm font-medium rounded-lg transition-all duration-200 border',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold-500 bg-gold-500/10 border-gold-500/20'
                : 'text-slate-300 border-transparent hover:text-gold-300 hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main id="main-content" class="flex-1" tabindex="-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-navy-950/40 text-slate-300 border-t border-navy-800">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid sm:grid-cols-3 gap-8 mb-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <img
              src="/logos/neurotech-logo.png"
              alt=""
              width="32"
              height="32"
              class="h-8 w-8 rounded-full"
            />
            <span class="text-white font-bold">Surrey Neurotech Society</span>
          </div>
          <p class="text-sm leading-relaxed text-slate-400">
            A student-led society under Surrey Students' Union. Exploring neuroscience, technology, brain-computer interfaces, and human-centred innovation.
          </p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-gold-500">Established {society.establishedYear}</p>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">Pages</h4>
          <div class="flex flex-col gap-2">
            {navLinks.map(link => (
              <a href={link.href} class="text-sm text-slate-400 hover:text-gold-400 transition-colors">{link.label}</a>
            ))}
          </div>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">Connect</h4>
          <div class="flex flex-col gap-2 text-sm text-slate-400">
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">Instagram</a>
            <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">LinkedIn</a>
            <a href={`mailto:${society.contactEmail}`} class="hover:text-gold-400 transition-colors">Email</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">Surrey Students' Union</a>
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-400 transition-colors">Membership</a>
          </div>
        </div>
      </div>
      <div class="border-t border-navy-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} Surrey Neurotech Society. A student society at the University of Surrey.</p>
        <p>{society.domain}</p>
      </div>
    </div>
  </footer>

  <AssistantWidget config={assistantConfig} endpoint="/api/assistant/chat" />

  <!--
    Neurotech-specific: Lenis fluid scroll + GSAP ScrollTrigger integration.
    Kept here (not in BaseLayout) because it is unique to this app.
    The mobile-menu toggle from BaseLayout runs first; this script runs after.
  -->
  <script>
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    // No theme logic needed
    const mobileMenuButton = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuButton?.addEventListener('click', () => {
      const isOpen = mobileMenu?.classList.toggle('hidden') === false;
      mobileMenuButton.setAttribute('aria-expanded', String(isOpen));
      mobileMenuButton.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    });

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      // Initialize Lenis for fluid, organic scrolling
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
      });

      // Sync GSAP with Lenis
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0, 0);
    }
  </script>
</BaseLayout>

