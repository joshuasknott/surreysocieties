---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="404 - Page Not Found"
  description="The page you're looking for does not exist on the Surrey Neurotech Society website."
>
  <section class="neuro-hero min-h-[72vh]" aria-labelledby="not-found-title">
    <div class="neuro-hero__inner flex min-h-[72vh] items-center">
      <div class="max-w-2xl">
        <div class="reveal">
          <h1 id="not-found-title" class="neuro-serif neuro-hero-title">
            No signal.
          </h1>
          <p class="neuro-hero-copy">
            This page was not found on the society site. Head back to the homepage or check the confirmed events page.
          </p>
          <div class="neuro-action-row">
            <a href="/" class="neuro-btn-primary">Return home</a>
            <a href="/events" class="neuro-btn-dark">View events</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
