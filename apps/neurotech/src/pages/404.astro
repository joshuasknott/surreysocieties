---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist on the Surrey Neurotech Society website."
>
  <section class="bg-slate-900 text-white relative overflow-hidden flex items-center justify-center min-h-[70vh] gradient-dark">
    <div class="absolute top-0 right-0 w-96 h-96 bg-teal-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-500/5 rounded-full blur-2xl pointer-events-none"></div>

    <div class="mx-auto max-w-3xl px-6 py-24 text-center relative z-10">
      <span class="text-teal-500 text-xs font-semibold uppercase tracking-wider mb-6 block">Error 404</span>

      <h1 class="text-7xl sm:text-9xl lg:text-[10rem] font-black tracking-tight leading-none mb-6">
        <span class="text-teal-500 [text-shadow:0_0_15px_rgba(20,184,166,0.4)]">404</span>
      </h1>

      <p class="text-slate-300 text-lg leading-relaxed max-w-xl mx-auto border-l-2 border-teal-500/40 pl-4 text-left mb-10">
        This neural pathway doesn't lead anywhere. The page you're looking for couldn't be found. Try one of the links below to get back on track.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-flex items-center justify-center px-8 py-4 bg-teal-500 hover:bg-teal-600 text-white font-bold rounded-xl transition-all shadow-[0_4px_20px_rgba(20,184,166,0.3)] hover:shadow-[0_8px_30px_rgba(20,184,166,0.4)] text-sm uppercase tracking-wide">
          Return Home
        </a>
        <a href="/events" class="inline-flex items-center justify-center px-8 py-4 bg-transparent hover:bg-white/5 text-white font-bold rounded-xl border border-teal-500/30 transition-all text-sm uppercase tracking-wide">
          View Events
        </a>
      </div>
    </div>
  </section>
</Layout>
