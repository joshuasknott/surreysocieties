---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { committeeRoles } from '../../data/committeeRoles';
import { committeeApplicationsClosed } from '@surreysocieties/ui/committeeDeadline';
import '../../styles/global.css';
import '../../styles/committeeApplications.css';

const applicationsClosed = committeeApplicationsClosed();
const applicationsOpen = !applicationsClosed && Boolean(import.meta.env.RESEND_API_KEY && (import.meta.env.COMMITTEE_FROM_EMAIL || import.meta.env.CONTACT_FROM_EMAIL));
---

<Layout
  title="Committee applications 2026–27"
  description="Apply to join the Surrey Neurotech Society committee for 2026–27. Explore four roles in events, workshops, partnerships and content."
  bodyClass="committee-page"
>
  <div class="committee-shell">
    <section class="committee-intro" aria-labelledby="committee-title">
      <h1 id="committee-title">Join the committee.</h1>
      <p class="committee-year">Committee applications 2026–27</p>
      <p class="committee-lede">Help shape a welcoming, curious neurotech community at Surrey.</p>
    </section>

    <section class="committee-roles" aria-labelledby="roles-title">
      <h2 id="roles-title" class="sr-only">Open committee roles</h2>
      <div class="committee-card-grid">
        {committeeRoles.map((role, index) => <a class="committee-role-card" href={`/committee-applications/${role.slug}`} aria-label={`View ${role.title} application`}>
          <span class="committee-card-top"><span>{String(index + 1).padStart(2, '0')}</span><span class="committee-card-arrow" aria-hidden="true">↗</span></span>
          <span class="committee-card-copy"><strong>{role.title}</strong><span>{role.summary}</span></span>
        </a>)}
      </div>
      {!applicationsOpen && <p class="committee-status" role="status">{applicationsClosed ? 'Applications have closed. You can still explore the role briefs.' : 'Applications are being prepared. You can explore the roles now; submissions will open once email delivery is connected.'}</p>}
    </section>
  </div>
</Layout>
