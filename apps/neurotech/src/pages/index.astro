---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Home" description="Surrey Neurotech Society — A student-led community exploring neuroscience, technology, brain-computer interfaces, and human-centred innovation at the University of Surrey.">

  <!-- Hero -->
  <section class="bg-primary text-text-on-dark relative overflow-hidden neural-wave-bg-dark curve-bottom pb-8">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32 relative z-10">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
        <img src="/logos/neurotech-logo.png" alt="Surrey Neurotech Society logo" class="w-28 h-28 sm:w-36 sm:h-36 rounded-full mb-8 shadow-xl shadow-accent/20 ring-4 ring-white/5" />
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1]">
          Where neuroscience, <br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-light to-secondary-light">technology & curiosity</span> meet.
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-text-on-dark-secondary leading-relaxed max-w-2xl">
          A student-led community exploring the future of brain-computer interfaces and human-centred innovation at the University of Surrey.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="/join" class="px-8 py-3.5 bg-accent hover:bg-accent-dark text-white font-semibold rounded-full transition-all hover:shadow-lg hover:shadow-accent/30 hover:-translate-y-0.5">
            Join the Society
          </a>
          <a href="/events" class="px-8 py-3.5 bg-white/5 hover:bg-white/10 text-text-on-dark font-semibold rounded-full border border-white/10 transition-all backdrop-blur-sm">
            View Events
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Explore -->
  <section class="py-20 sm:py-24 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span class="w-12 h-px bg-gradient-to-r from-accent/60 to-transparent"></span>
          <span class="text-accent text-sm font-semibold uppercase tracking-wider mx-2">What We Explore</span>
          <span class="w-12 h-px bg-gradient-to-l from-accent/60 to-transparent"></span>
          <span class="w-2 h-2 rounded-full bg-accent"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold">Where Brain Meets Machine</h2>
        <p class="mt-4 text-text-secondary max-w-xl mx-auto">Neuroscience, engineering, and computing — brought together by curiosity and a desire to understand the brain.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card rounded-2xl p-6 border-transparent hover:border-accent/30 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-accent-muted flex items-center justify-center text-accent mb-5 text-xl">🧠</div>
          <h3 class="font-semibold text-lg mb-2">Neuroscience</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Understanding the brain — from neural pathways to cognitive processes and beyond.</p>
        </div>
        <div class="glass-card rounded-2xl p-6 border-transparent hover:border-secondary/30 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center text-secondary mb-5 text-xl">⚡</div>
          <h3 class="font-semibold text-lg mb-2">Brain-Computer Interfaces</h3>
          <p class="text-text-secondary text-sm leading-relaxed">EEG, neural signal processing, and the technology bridging thought and action.</p>
        </div>
        <div class="glass-card rounded-2xl p-6 border-transparent hover:border-accent/30 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-accent-muted flex items-center justify-center text-accent mb-5 text-xl">🔬</div>
          <h3 class="font-semibold text-lg mb-2">Research</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Reading groups, journal clubs, and engagement with current neurotech research.</p>
        </div>
        <div class="glass-card rounded-2xl p-6 border-transparent hover:border-secondary/30 transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center text-secondary mb-5 text-xl">🤝</div>
          <h3 class="font-semibold text-lg mb-2">Human-Centred</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Technology should serve people. We focus on ethics, wellbeing, and responsible innovation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Preview -->
  <section class="bg-surface-alt py-20 sm:py-24 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="w-8 h-px bg-gradient-to-r from-accent/60 to-transparent"></span>
            <span class="text-accent text-sm font-semibold uppercase tracking-wider">Events</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold">What's Coming Up</h2>
        </div>
        <a href="/events" class="text-accent hover:text-accent-dark text-sm font-semibold transition-colors">
          View all events →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="glass-card rounded-2xl p-6 hover:shadow-md transition-shadow">
          <span class="inline-block text-xs font-medium text-accent bg-accent-muted px-3 py-1 rounded-full mb-4">Coming Soon</span>
          <h3 class="font-semibold text-lg mb-2">Intro to Neurotech</h3>
          <p class="text-text-secondary text-sm">What is neurotechnology? Why does it matter? An accessible introduction for students from any background.</p>
        </div>
        <div class="glass-card rounded-2xl p-6 hover:shadow-md transition-shadow">
          <span class="inline-block text-xs font-medium text-secondary bg-secondary/10 px-3 py-1 rounded-full mb-4">Planned Format</span>
          <h3 class="font-semibold text-lg mb-2">Brain-Computer Interfaces 101</h3>
          <p class="text-text-secondary text-sm">A beginner-friendly session on BCIs — how they work, what they're used for, and where the field is heading.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Committee Preview -->
  <section class="py-20 sm:py-24 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span class="w-12 h-px bg-gradient-to-r from-accent/60 to-transparent"></span>
          <span class="text-accent text-sm font-semibold uppercase tracking-wider mx-2">Our Team</span>
          <span class="w-12 h-px bg-gradient-to-l from-accent/60 to-transparent"></span>
          <span class="w-2 h-2 rounded-full bg-accent"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold">Meet the Committee</h2>
        <p class="mt-4 text-text-secondary max-w-lg mx-auto">The students behind Surrey Neurotech Society.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {['President', 'Vice President', 'Treasurer', 'Academic Lead', 'Events Lead'].map(role => (
          <div class="text-center p-4">
            <div class="w-16 h-16 rounded-full bg-surface-alt border border-accent/20 mx-auto mb-3 flex items-center justify-center text-accent text-sm font-bold shadow-sm">
              {role.split(' ').map(w => w[0]).join('')}
            </div>
            <p class="text-sm font-semibold">{role}</p>
            <p class="text-xs text-text-muted mt-1">Name TBC</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a href="/committee" class="text-accent hover:text-accent-dark text-sm font-semibold transition-colors">
          View full committee →
        </a>
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="bg-primary text-text-on-dark py-24 sm:py-32 px-6 curve-bottom mt-10 neural-wave-bg-dark relative overflow-hidden">
    <div class="absolute inset-x-0 top-0"><div class="neural-pathway"></div></div>
    <div class="mx-auto max-w-3xl text-center relative z-10 pt-10">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">Curious about the brain?</h2>
      <p class="text-text-on-dark-secondary text-lg mb-10">
        Whether you're studying neuroscience, computer science, psychology, engineering, or anything else — if you're curious about the intersection of brain and technology, you belong here.
      </p>
      <a href="/join" class="inline-block px-8 py-4 bg-secondary hover:bg-secondary-dark text-primary-deep font-bold rounded-full transition-all hover:shadow-lg hover:shadow-secondary/20 hover:-translate-y-0.5">
        Join Surrey Neurotech Society
      </a>
    </div>
  </section>

</Layout>
