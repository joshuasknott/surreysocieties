---
export const prerender = false;

import { Image } from 'astro:assets';
import { BrainCircuit, ExternalLink, Instagram, Linkedin, Mail } from 'lucide-astro';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/showcase/neurotech-hero-lab.png';
import workshopImage from '../assets/showcase/neurotech-workshop-bci.png';
import talkImage from '../assets/showcase/neurotech-journal-talk.png';
import communityImage from '../assets/showcase/neurotech-community.png';
import pipelineImage from '../assets/showcase/neurotech-bci-pipeline.png';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

const events: any[] = await queryPublicConvex(
  api.events.listPublished,
  { societySlug: SOCIETY_ID },
  [],
);

const updateCopy = events[0]?.title
  ? `Next confirmed session: ${events[0].title}`
  : 'Upcoming sessions are announced on Instagram and the Students\' Union.';

const activityRows = [
  {
    number: '01',
    label: 'Make',
    title: 'Workshops and BCI projects',
    copy: 'Hands-on practical sessions with EEG, signal processing and other neurotechnology tools. Work with other students to turn an idea into a prototype.',
    image: workshopImage,
    alt: 'Students working with an EEG cap and neural signal software in a lab.',
    reverse: false,
  },
  {
    number: '02',
    label: 'Discuss',
    title: 'Journal clubs and talks',
    copy: 'Read and discuss current research, then hear from speakers across academia, startups and industry about neurotechnology in practice.',
    image: talkImage,
    alt: 'A neurotechnology talk with students viewing EEG and neuroimaging material.',
    reverse: true,
  },
  {
    number: '03',
    label: 'Connect',
    title: 'Collaborate, network and socialise',
    copy: 'Take part in planned hackathons, inter-university collaboration, networking and socials. Meet students from different disciplines and share what interests you.',
    image: communityImage,
    alt: 'Students talking together around a neurotechnology project in a campus space.',
    reverse: false,
  },
];
---

<Layout
  title="Home"
  description="Take part in neurotechnology at Surrey through practical workshops, brain-computer interface projects, journal clubs, talks, collaborations and socials."
>
  <section class="nt-hero" aria-labelledby="nt-hero-title">
    <div class="nt-hero__inner">
      <div class="nt-hero__copy" data-reveal>
        <h1 id="nt-hero-title">Take part in neurotechnology at Surrey.</h1>
        <p class="nt-hero__intro">
          Practical sessions with EEG and brain-computer interfaces, project work, journal clubs, talks and socials. Open to all students.
        </p>
        <div class="nt-actions">
          <a class="nt-button nt-button--yellow" href={society.membershipUrl} target="_blank" rel="noopener noreferrer">
            Join the society
          </a>
          <a class="nt-button nt-button--outline" href={society.socials.instagram} target="_blank" rel="noopener noreferrer">
            <Instagram size={18} aria-hidden="true" /> Follow @SurreyNeurotech
          </a>
        </div>
        <p class="nt-hero__fact"><span>Established 2024</span><span>Surrey's first student neurotechnology society</span></p>
      </div>

      <div class="nt-hero__visual">
        <Image
          src={heroImage}
          alt="Students running an EEG session in a university laboratory."
          widths={[720, 960, 1200, 1600]}
          sizes="(min-width: 1440px) 907px, (min-width: 900px) 63vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={82}
        />
      </div>
    </div>
  </section>

  <section id="activities" class="nt-activities" aria-labelledby="nt-activities-title">
    <div class="nt-section-heading" data-reveal>
      <h2 id="nt-activities-title">What happens in the society</h2>
      <p>Three direct ways to take part in neurotechnology at Surrey.</p>
    </div>

    <div class="nt-activity-list">
      {activityRows.map((activity) => (
        <article class:list={['nt-activity', activity.reverse && 'nt-activity--reverse']}>
          <div class="nt-activity__image" data-reveal>
            <Image
              src={activity.image}
              alt={activity.alt}
              widths={[640, 960, 1200, 1400]}
              sizes="(min-width: 760px) 52vw, 100vw"
              loading="lazy"
              decoding="async"
              quality={80}
            />
          </div>
          <div class="nt-activity__copy" data-reveal>
            <p class="nt-step-label"><span>{activity.number}</span>{activity.label}</p>
            <h3>{activity.title}</h3>
            <p>{activity.copy}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="nt-pipeline" aria-labelledby="nt-pipeline-title">
    <div class="nt-section-heading nt-section-heading--tight" data-reveal>
      <h2 id="nt-pipeline-title">A brain-computer interface, step by step</h2>
      <p>From neural signals to an assistive action.</p>
    </div>

    <div class="nt-pipeline__visual" data-reveal>
      <Image
        src={pipelineImage}
        alt="An EEG cap, amplifier, neural data screens and an assistive robotic hand arranged on a laboratory bench."
        widths={[960, 1440, 1800]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        quality={82}
      />
      <div class="nt-pipeline__labels" aria-label="Brain-computer interface stages">
        <div><span>1</span><strong>EEG cap</strong><small>Measure electrical activity from the scalp.</small></div>
        <div><span>2</span><strong>Amplifier and data</strong><small>Process signals into usable information.</small></div>
        <div><span>3</span><strong>Assistive control</strong><small>Translate intent into an action.</small></div>
      </div>
    </div>
  </section>

  <section id="about" class="nt-facts" aria-labelledby="nt-facts-title">
    <div class="nt-facts__inner" data-reveal>
      <BrainCircuit size={76} strokeWidth={1.5} aria-hidden="true" />
      <div>
        <h2 id="nt-facts-title">First at Surrey. Fourth in the country. Open to all.</h2>
        <p>
          Established in 2024 as Surrey's first student group dedicated to neurotechnology. Students from psychology, computer science, engineering, biomedical sciences and more learn and build together.
        </p>
      </div>
    </div>
  </section>

  <section id="updates" class="nt-updates" aria-labelledby="nt-updates-title">
    <div class="nt-updates__inner">
      <div class="nt-updates__copy" data-reveal>
        <h2 id="nt-updates-title">Stay in the loop</h2>
        <p>{updateCopy}</p>
      </div>
      <div class="nt-updates__links" data-reveal>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer">
          <Instagram size={34} aria-hidden="true" />
          <span><strong>Instagram</strong><small>@SurreyNeurotech</small></span>
        </a>
        <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer">
          <ExternalLink size={30} aria-hidden="true" />
          <span><strong>Students' Union</strong><small>Official society page</small></span>
        </a>
      </div>
    </div>
  </section>

  <section id="join" class="nt-join" aria-labelledby="nt-join-title">
    <div class="nt-join__inner">
      <div data-reveal>
        <h2 id="nt-join-title">Open to every Surrey student.</h2>
        <p>No experience needed.</p>
      </div>
      <div class="nt-join__actions" data-reveal>
        <a class="nt-button nt-button--yellow" href={society.membershipUrl} target="_blank" rel="noopener noreferrer">Join the society <ExternalLink size={16} aria-hidden="true" /></a>
        <a class="nt-button nt-button--outline" href={society.socials.instagram} target="_blank" rel="noopener noreferrer"><Instagram size={18} aria-hidden="true" /> Follow @SurreyNeurotech</a>
      </div>
    </div>
  </section>

  <section class="nt-contact-links" aria-label="Contact links">
    <div class="nt-contact-links__inner">
      <a href={`mailto:${society.contactEmail}`}><Mail size={19} aria-hidden="true" /> {society.contactEmail}</a>
      <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer"><Instagram size={19} aria-hidden="true" /> @SurreyNeurotech</a>
      <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer"><Linkedin size={19} aria-hidden="true" /> Surrey Neurotech</a>
    </div>
  </section>
</Layout>
