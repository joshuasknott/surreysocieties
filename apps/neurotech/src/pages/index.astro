              <div class="mb-4 text-cyan">&gt;&gt;&gt; model.predict(eeg_stream)</div>
              <div class="space-y-2">
                 <div class="flex justify-between items-center"><span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-gold"></span> Extracting features...</span> <span class="text-gold opacity-80">[OK]</span></div>
                 <div class="flex justify-between items-center"><span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-gold"></span> Spatial filtering...</span> <span class="text-gold opacity-80">[OK]</span></div>
                 <div class="flex justify-between items-center"><span class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-cyan animate-pulse"></span> Classification...</span> <span class="text-cyan animate-pulse">Running</span></div>
              </div>
              <div class="mt-6 border-t border-border-dark pt-4">
                 <span class="text-text-on-dark">Predicted Intent:</span> <span class="text-gold font-bold ml-2">Motor_Execute_Left</span> <span class="text-xs text-text-on-dark-secondary ml-1">(94.2%)</span>
              </div>
            </div>
          </div>

          <!-- Panel 3: Human-Centred -->
          <div id="panel-3" role="tabpanel" aria-labelledby="tab-3" class="visual-panel absolute inset-0 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-500">
            <div class="text-center px-8 flex flex-col items-center">
               <div class="w-16 h-16 rounded-full border border-gold flex items-center justify-center mb-6 shadow-[0_0_20px_rgba(245,158,11,0.15)] bg-gold/5">
                  <svg class="w-8 h-8 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                  </svg>
               </div>
               <h4 class="text-text-on-dark font-semibold mb-2 text-lg">Privacy &amp; Accessibility</h4>
               <p class="text-text-on-dark-secondary text-sm max-w-[250px]">Ensuring neurotechnology empowers individuals without compromising cognitive privacy.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Preview -->
  <section class="bg-surface-dark py-20 sm:py-24 px-6 nav-grid-dark">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <div class="inline-flex items-center gap-3 mb-4">
            <div class="gold-dot"></div>
            <span class="text-gold text-xs font-semibold uppercase tracking-wider">Events</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-text-on-dark">What's Coming Up</h2>
        </div>
        <a href="/events" class="text-gold hover:text-gold-light text-sm font-semibold transition-colors">
          View all events →
        </a>
      </div>

      <div class="relative pl-8 sm:pl-12">
        <!-- Vertical Neural Pathway Line -->
        <div class="absolute left-2.5 sm:left-4 top-6 bottom-6 w-0.5 bg-gradient-to-b from-cyan/80 via-gold/50 to-transparent"></div>

        {events.length === 0 ? (
          <div class="relative">
            <div class="absolute -left-8 sm:-left-12 top-6 w-6 h-6 flex items-center justify-center">
              <div class="absolute w-full h-full bg-cyan rounded-full animate-pulse opacity-40"></div>
              <div class="w-2.5 h-2.5 bg-cyan rounded-full shadow-[0_0_12px_#22D3EE] z-10 relative"></div>
            </div>
            <div class="bg-primary/20 backdrop-blur-md border border-cyan/20 p-6 sm:p-8 rounded-2xl shadow-[0_4px_24px_rgba(0,0,0,0.2)]">
              <h3 class="font-semibold text-xl mb-2 text-text-on-dark">No published events yet</h3>
              <p class="text-text-on-dark-secondary text-sm leading-relaxed">Check back soon for upcoming Surrey Neurotech Society events.</p>
            </div>
          </div>
        ) : (
          <div class="space-y-8 relative">
            {events.map((event: any, i: number) => (
              <div class="relative">
                <div class="absolute -left-8 sm:-left-12 top-6 w-6 h-6 flex items-center justify-center">
                  <div class={`absolute w-full h-full rounded-full animate-pulse opacity-40 ${i % 2 === 0 ? 'bg-cyan' : 'bg-gold'}`}></div>
                  <div class={`w-2.5 h-2.5 rounded-full z-10 relative ${i % 2 === 0 ? 'bg-cyan shadow-[0_0_12px_#22D3EE]' : 'bg-gold shadow-[0_0_12px_#F59E0B]'}`}></div>
                </div>
                <div class="bg-primary/20 backdrop-blur-md border border-cyan/20 p-6 sm:p-8 rounded-2xl hover:border-cyan/40 transition-colors shadow-[0_4px_24px_rgba(0,0,0,0.2)]">
                  <div class="flex items-center gap-3 mb-4">
                    <span class="inline-block text-xs font-medium text-gold bg-gold/10 border border-gold/30 px-3 py-1 rounded-lg">{event.category || 'Event'}</span>
                    <span class="text-xs text-text-muted">{formatEventDate(event.date)}</span>
                  </div>
                  <h3 class="font-semibold text-xl mb-2 text-text-on-dark">{event.title}</h3>
                  <p class="text-text-on-dark-secondary text-sm leading-relaxed">{event.description || 'Details coming soon.'}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Committee — Flat Grid (no "View full committee" link) -->
  <section class="py-20 sm:py-24 px-6 bg-surface nav-grid-light">
    <div class="mx-auto max-w-6xl">
      <div class="mb-14">
        <div class="inline-flex items-center gap-3 mb-4">
          <div class="gold-dot"></div>
          <span class="text-gold text-xs font-semibold uppercase tracking-wider">Our Team</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary">Meet the Committee</h2>
        <p class="mt-3 text-text-secondary">The students behind Surrey Neurotech Society.</p>
      </div>

      {committee.length === 0 ? (
        <div class="neuro-card p-8 text-center">
          <h3 class="font-semibold text-lg mb-2 text-text-primary">Committee details coming soon</h3>
          <p class="text-text-secondary text-sm leading-relaxed max-w-xl mx-auto">Check back soon to meet the Surrey Neurotech Society committee.</p>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 sm:gap-10">
          {committee.map(member => (
            <div class="flex flex-col items-center text-center group">
              <div class="w-24 h-24 sm:w-28 sm:h-28 shape-organic bg-primary-deep border border-cyan/30 mb-4 flex items-center justify-center text-cyan text-lg font-bold shadow-[0_0_15px_rgba(34,211,238,0.15)] group-hover:shadow-[0_0_25px_rgba(34,211,238,0.4)] group-hover:border-cyan/60 transition-all duration-300">
                {getInitials(member.name, member.role)}
              </div>
              <p class="text-sm font-semibold text-text-primary">{member.name}</p>
              <p class="text-xs text-text-muted mt-1">{member.role}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Join CTA -->
  <section class="bg-surface-dark text-text-on-dark py-24 sm:py-32 px-6 relative overflow-hidden nav-grid-dark border-t-2 border-gold/20">
    <div class="absolute top-0 right-0 w-80 h-80 bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="mx-auto max-w-3xl text-center relative z-10">
      <div class="inline-flex items-center gap-3 mb-6">
        <div class="gold-dot"></div>
        <span class="text-gold text-xs font-semibold uppercase tracking-wider">Get Involved</span>
        <div class="gold-dot"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold mb-6">Curious about the brain?</h2>
      <p class="text-text-on-dark-secondary text-lg mb-10 max-w-xl mx-auto border-l-2 border-gold/40 pl-4 text-left">
        Whether you're studying neuroscience, computer science, psychology, engineering, or anything else — if you're curious about the intersection of brain and technology, you belong here.
      </p>
      <a href="/join" class="btn-trace inline-block px-8 py-4 bg-gold hover:bg-gold-light text-primary-deep font-bold rounded-xl transition-all shadow-[0_4px_24px_rgba(201,168,76,0.35)] hover:shadow-[0_6px_32px_rgba(201,168,76,0.5)] text-sm uppercase tracking-wide">
        Join Surrey Neurotech Society
      </a>
    </div>
  </section>

</Layout>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/dist/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // --- Organic Section Transitions ---
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  if (!prefersReducedMotion) {
    const sections = document.querySelectorAll('section');
    sections.forEach((section, index) => {
      if (index === 0) return; // Skip Hero
      gsap.fromTo(
        section,
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 85%',
          },
        }
      );
    });
  }

  // --- Three.js Bio-Tech Brain Hemispheres ---
  const initHeroCanvas = () => {
    const canvasContainer = document.getElementById('hero-canvas-container');
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas || !canvasContainer) return;

    const getDimensions = () => ({
      width: canvasContainer.clientWidth,
      height: canvasContainer.clientHeight
    });

    let { width, height } = getDimensions();

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, width / height, 0.1, 1000);
    camera.position.z = 180;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const brainGroup = new THREE.Group();
    scene.add(brainGroup);

    const particleCount = 800;
    const particles = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    
    const radius = 60;
    const gap = 5;

    // Generate two hemispheres (stylized brain)
    for (let i = 0; i < particleCount; i++) {
      const isLeft = i % 2 === 0;
      const sign = isLeft ? -1 : 1;
      
      let u = Math.random();
      let v = Math.random();
      let theta = u * 2.0 * Math.PI;
      let phi = Math.acos(2.0 * v - 1.0);
      let r = Math.cbrt(Math.random()) * radius;

      let x = r * Math.sin(phi) * Math.cos(theta);
      let y = r * Math.sin(phi) * Math.sin(theta);
      let z = r * Math.cos(phi);

      // Squash to form brain shape
      z *= 0.7;
      y *= 0.85;

      // Split into hemispheres
      x = Math.abs(x) + gap;
      x *= sign;

      positions[i * 3] = x;
      positions[i * 3 + 1] = y;
      positions[i * 3 + 2] = z;
    }

    particles.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Base particles
    const pMaterial = new THREE.PointsMaterial({
      color: 0x22D3EE, // Cyan
      size: 1.5,
      transparent: true,
      opacity: 0.6,
      blending: THREE.AdditiveBlending
    });
    const particleSystem = new THREE.Points(particles, pMaterial);
    brainGroup.add(particleSystem);

    // Faint base connections
    const linePositions = [];
    for (let i = 0; i < particleCount; i++) {
      const p1x = positions[i*3], p1y = positions[i*3+1], p1z = positions[i*3+2];
      for (let j = i + 1; j < Math.min(i + 20, particleCount); j++) {
        const p2x = positions[j*3], p2y = positions[j*3+1], p2z = positions[j*3+2];
        const distSq = (p1x-p2x)*(p1x-p2x) + (p1y-p2y)*(p1y-p2y) + (p1z-p2z)*(p1z-p2z);
        if (distSq < 400) {
          linePositions.push(p1x, p1y, p1z, p2x, p2y, p2z);
        }
      }
    }
    const baseLinesGeo = new THREE.BufferGeometry();
    baseLinesGeo.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
    const baseLinesMat = new THREE.LineBasicMaterial({ 
      color: 0x22D3EE, 
      transparent: true, 
      opacity: 0.08,
      blending: THREE.AdditiveBlending 
    });
    const baseLines = new THREE.LineSegments(baseLinesGeo, baseLinesMat);
    brainGroup.add(baseLines);

    // Firing synapses system
    const synapseGroup = new THREE.Group();
    brainGroup.add(synapseGroup);
    
    const activeSynapses: { mesh: THREE.Line, life: number, decay: number }[] = [];
    const matGold = new THREE.LineBasicMaterial({ color: 0xF59E0B, transparent: true, opacity: 1, blending: THREE.AdditiveBlending, linewidth: 2 });
    const matCyan = new THREE.LineBasicMaterial({ color: 0x22D3EE, transparent: true, opacity: 1, blending: THREE.AdditiveBlending, linewidth: 2 });

    function spawnSynapse() {
      const i1 = Math.floor(Math.random() * particleCount);
      let closest = -1;
      const p1x = positions[i1*3], p1y = positions[i1*3+1], p1z = positions[i1*3+2];
      
      // Find random nearby particle
      for(let i=0; i<40; i++) {
        const j = Math.floor(Math.random() * particleCount);
        if(i1 === j) continue;
        const dx = positions[j*3] - p1x;
        const dy = positions[j*3+1] - p1y;
        const dz = positions[j*3+2] - p1z;
        if(dx*dx + dy*dy + dz*dz < 1500) {
          closest = j;
          break;
        }
      }
      
      if (closest !== -1) {
        const isGold = Math.random() > 0.4;
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.Float32BufferAttribute([
          p1x, p1y, p1z,
          positions[closest*3], positions[closest*3+1], positions[closest*3+2]
        ], 3));
        
        const line = new THREE.Line(geo, isGold ? matGold.clone() : matCyan.clone());
        synapseGroup.add(line);
        
        activeSynapses.push({
          mesh: line,
          life: 1.0,
          decay: 0.03 + Math.random() * 0.04 // fast flash
        });
      }
    }

    // Mouse Interaction
    let targetRotationX = 0;
    let targetRotationY = 0;
    
    window.addEventListener('mousemove', (event) => {
      const x = (event.clientX / window.innerWidth) * 2 - 1;
      const y = -(event.clientY / window.innerHeight) * 2 + 1;
      targetRotationY = x * 0.5;
      targetRotationX = -y * 0.5;
    });

    window.addEventListener('resize', () => {
      const newDim = getDimensions();
      camera.aspect = newDim.width / newDim.height;
      camera.updateProjectionMatrix();
      renderer.setSize(newDim.width, newDim.height);
    });

    const animate = () => {
      requestAnimationFrame(animate);

      // Smooth rotate towards mouse
      brainGroup.rotation.y += (targetRotationY - brainGroup.rotation.y) * 0.05;
      brainGroup.rotation.x += (targetRotationX - brainGroup.rotation.x) * 0.05;
      
      // Constant slow idle rotation
      brainGroup.rotation.y += 0.002;

      // Handle synapses
      if (Math.random() < 0.3) { // 30% chance per frame to spawn a synapse
        spawnSynapse();
      }

      for (let i = activeSynapses.length - 1; i >= 0; i--) {
        const s = activeSynapses[i];
        s.life -= s.decay;
        if (s.life <= 0) {
          synapseGroup.remove(s.mesh);
          s.mesh.geometry.dispose();
          (s.mesh.material as THREE.Material).dispose();
          activeSynapses.splice(i, 1);
        } else {
          (s.mesh.material as THREE.Material).opacity = s.life;
        }
      }

      renderer.render(scene, camera);
    };

    animate();
  };

  // Run on mount based on reduced motion setting
  if (prefersReducedMotion) {
    const canvas = document.getElementById('hero-canvas');
    const fallback = document.getElementById('hero-fallback');
    if (canvas) canvas.style.display = 'none';
    if (fallback) fallback.classList.remove('hidden');
    if (fallback) fallback.classList.add('flex');
  } else {
    initHeroCanvas();
  }

  // --- Interactive Tabs Logic ---
  const tabs = document.querySelectorAll('.focus-tab');
  const panels = document.querySelectorAll('.visual-panel');

  const activateTab = (index: number) => {
    tabs.forEach((t, i) => {
      const isSelected = i === index;
      t.setAttribute('aria-selected', isSelected.toString());
      if (isSelected) {
        t.classList.add('border-cyan/40', 'bg-cyan/5', 'shadow-[0_0_15px_rgba(34,211,238,0.1)]');
        t.classList.remove('border-transparent', 'opacity-70');
      } else {
        t.classList.remove('border-cyan/40', 'bg-cyan/5', 'shadow-[0_0_15px_rgba(34,211,238,0.1)]');
        t.classList.add('border-transparent', 'opacity-70');
      }
    });

    panels.forEach((p, i) => {
      if (i === index) {
        p.classList.remove('opacity-0', 'pointer-events-none');
        p.classList.add('opacity-100');
      } else {
        p.classList.remove('opacity-100');
        p.classList.add('opacity-0', 'pointer-events-none');
      }
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(index));
    tab.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      let newIndex = index;
      if (keyEvent.key === 'ArrowDown' || keyEvent.key === 'ArrowRight') {
        newIndex = (index + 1) % tabs.length;
        keyEvent.preventDefault();
      } else if (keyEvent.key === 'ArrowUp' || keyEvent.key === 'ArrowLeft') {
        newIndex = (index - 1 + tabs.length) % tabs.length;
        keyEvent.preventDefault();
      }
      if (newIndex !== index) {
        (tabs[newIndex] as HTMLElement).focus();
        activateTab(newIndex);
      }
    });
  });
</script>
