              </div>
            </div>
          </div>
        </div>

        <!-- AI/ML Explainer -->
        <div class="flex flex-col lg:flex-row items-center gap-16">
          <div class="flex-1 lg:pr-12">
            <h3 class="text-3xl font-bold text-slate-900 mb-6">Recognize Patterns</h3>
            <p class="text-lg text-slate-600 mb-8 leading-relaxed">
              Artificial Intelligence helps us make sense of the noise. By applying machine learning, we can find distinct patterns in chaotic brain data to understand what a person is intending to do.
            </p>
            <div class="inline-flex items-center gap-2 text-gold-600 font-medium bg-amber-50 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
              Drag the slider to find patterns
            </div>
          </div>
