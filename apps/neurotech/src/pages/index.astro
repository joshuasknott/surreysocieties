---
export const prerender = false;
import { Image } from 'astro:assets';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import { Brain, Cpu, Dna, Lightbulb, PencilRuler, Scale } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import homeHero from '../assets/generated/neurotech-home-neural-hero.png';
import talksThumb from '../assets/generated/neurotech-talks-thumb.png';
import workshopsThumb from '../assets/generated/neurotech-workshops-thumb.png';
import projectsThumb from '../assets/generated/neurotech-projects-thumb.png';
import socialsThumb from '../assets/generated/neurotech-socials-thumb.png';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;

const events: any[] = (
  await queryPublicConvex(api.events.listPublished, { societySlug: SOCIETY_ID }, [])
).filter((event: any) => event.status === 'published');

const eventMessage = events[0]?.title || 'Confirmed society updates will appear here first.';

const approachSteps = [
  {
    title: 'Learn',
    copy: 'Friendly talks, workshops, and explainers when confirmed.',
    href: '/events',
  },
  {
    title: 'Meet',
    copy: 'Connect with curious students from every course.',
    href: '/committee',
  },
  {
    title: 'Build responsibly',
    copy: 'Ethics, inclusion, and wellbeing stay at the centre.',
    href: '/about',
  },
];

const disciplines = [
  { title: 'Psychology', copy: 'Understanding minds and behaviour.', icon: Brain },
  { title: 'Computing', copy: 'Algorithms, data, artificial intelligence and intelligent systems.', icon: Cpu },
  { title: 'Bioscience', copy: 'Cells, systems and the biology of the brain.', icon: Dna },
  { title: 'Design', copy: 'Human-centred design and creative solutions.', icon: PencilRuler },
  { title: 'Ethics', copy: 'Questions of fairness, privacy, consent and impact.', icon: Scale },
  { title: 'Curious beginners', copy: "You don't need experience — just curiosity.", icon: Lightbulb },
];

const activityCards = [
  {
    title: 'Talks & Events',
    copy: 'A clear place to discover talks, explainers and emerging ideas in neurotech, artificial intelligence and cognitive science.',
    image: talksThumb,
    alt: 'Students listening to a neurotechnology discussion.',
    number: '01',
  },
  {
    title: 'Workshops',
    copy: 'Workshop and journal club updates will be listed here once confirmed.',
    image: workshopsThumb,
    alt: 'Students collaborating at a workshop table.',
    number: '02',
  },
  {
    title: 'Inter-University Collaborations',
    copy: 'Future collaborations, projects and networking opportunities will be gathered into one student-friendly space.',
    image: projectsThumb,
    alt: 'Students presenting at a neurotechnology event.',
    number: '03',
  },
  {
    title: 'Socials & Community',
    copy: 'Socials and community updates will help curious students find their way into the society.',
    image: socialsThumb,
    alt: 'Students chatting at a society social.',
    number: '04',
  },
];
---

<Layout
  title="Home"
  description="Surrey Neurotech Society - a student-led University of Surrey society for curious students exploring neuroscience, artificial intelligence, brain-computer interfaces, signals, ethics, and responsible innovation."
>
  <section class="neuro-home-hero" aria-labelledby="neuro-hero-title">
    <Image
      src={homeHero}
      alt=""
      aria-hidden="true"
      class="neuro-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={90}
    />
    <div class="neuro-home-hero__inner">
      <div class="neuro-home-hero__copy reveal">
        <span class="neuro-home-kicker">Student-led neurotech at Surrey</span>
        <h1 id="neuro-hero-title" class="neuro-serif">
          Neurotech,<br /><span>for good.</span>
        </h1>
        <div class="neuro-home-title-rule" aria-hidden="true"></div>
        <p>
          Welcome to Surrey Neurotech Society's online home: a place for students curious about neuroscience, artificial intelligence, brain-computer interfaces, ethics, and responsible innovation.
        </p>
        <div class="neuro-home-hero-actions">
          <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-home-btn neuro-home-btn--gold">
            Join the society <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="#what-we-explore" class="neuro-home-btn neuro-home-btn--outline">
            Explore topics <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="neuro-home-open-note">Open to all students. All backgrounds. All levels.</p>
      </div>

      <a href="/events" class="neuro-home-event-strip reveal" aria-label="View confirmed events">
        <span class="neuro-home-event-strip__mark" aria-hidden="true">Now</span>
        <span><strong>What's happening</strong><span class="neuro-home-event-strip__message">{eventMessage}</span></span>
        <span class="neuro-home-event-strip__link">See events &rarr;</span>
      </a>

      <nav class="neuro-home-route-list reveal" aria-label="How to get involved">
        {approachSteps.map((step, index) => (
          <a href={step.href} class="neuro-home-route">
            <span class="neuro-home-route__index" aria-hidden="true">0{index + 1}</span>
            <span><strong>{step.title}</strong><small>{step.copy}</small></span>
            <span class="neuro-home-route__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </nav>

    </div>
  </section>

  <section id="what-we-explore" class="neuro-home-pathways" aria-labelledby="pathways-title">
    <div class="neuro-home-pathways__inner">
      <div class="neuro-home-pathways__heading reveal">
        <span class="neuro-home-kicker">Many doors into neurotech</span>
        <h2 id="pathways-title" class="neuro-serif">Different paths. Shared curiosity.</h2>
        <div class="neuro-home-title-rule" aria-hidden="true"></div>
      </div>
      <div class="neuro-home-pathway-track">
        {disciplines.map((discipline) => {
          const Icon = discipline.icon;
          return (
            <article class="neuro-home-pathway reveal">
              <span class="neuro-home-pathway__mark"><Icon size={28} strokeWidth={1.45} aria-hidden="true" /></span>
              <h3>{discipline.title}</h3>
              <p>{discipline.copy}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="neuro-home-activities" aria-labelledby="activities-title">
    <div class="neuro-home-activities__inner">
      <div class="neuro-home-activities__intro reveal">
        <span class="neuro-home-kicker neuro-home-kicker--blue">What the society brings together</span>
        <h2 id="activities-title" class="neuro-serif">Explore. Discuss.<br />Create. Together.</h2>
        <div class="neuro-home-title-rule" aria-hidden="true"></div>
        <p>
          This website makes it easier to find talks, workshops, socials, updates, resources, and ways to get involved once details are confirmed.
        </p>
        <a href="/events" class="neuro-home-btn neuro-home-btn--blue">See all events <span aria-hidden="true">&rarr;</span></a>
      </div>

      <div class="neuro-home-activity-list">
        {activityCards.map((activity) => (
          <article class="neuro-home-activity reveal">
            <span class="neuro-home-activity__number" aria-hidden="true">{activity.number}</span>
            <div class="neuro-home-activity__copy">
              <h3 class="neuro-serif">{activity.title}</h3>
              <p>{activity.copy}</p>
            </div>
            <Image
              src={activity.image}
              alt={activity.alt}
              widths={[360, 600, 960, 1440]}
              sizes="(min-width: 761px) 16rem, calc(100vw - 4.6rem)"
              loading="lazy"
              format="webp"
              quality={90}
            />
            <a href="/events" aria-label={`Learn more about ${activity.title}`} class="neuro-home-activity__arrow">
              <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-home-action-rail" aria-label="More ways to get involved">
    <div class="neuro-home-action-rail__inner">
      <a href="/events" class="neuro-home-action-rail__item">
        <span class="neuro-home-action-rail__index" aria-hidden="true">01</span>
        <span><strong>Events</strong><small>Follow confirmed updates, talks, workshops and socials.</small><em>See events &rarr;</em></span>
      </a>
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-home-action-rail__item">
        <span class="neuro-home-action-rail__index" aria-hidden="true">02</span>
        <span><strong>Join</strong><small>Become a member and stay close to society updates.</small><em>Join the society &rarr;</em></span>
      </a>
      <a href="/committee" class="neuro-home-action-rail__item">
        <span class="neuro-home-action-rail__index" aria-hidden="true">03</span>
        <span><strong>Committee</strong><small>Meet the student team leading the society.</small><em>Meet the committee &rarr;</em></span>
      </a>
    </div>
  </section>
</Layout>
