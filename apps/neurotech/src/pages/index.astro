            <div class="rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl p-8 h-[350px] flex flex-col text-white">
              <div class="flex-1 relative mb-6" id="ai-scatter-container">
                <!-- Dots injected via JS -->
              </div>
              <div class="flex items-center gap-4">
                <span class="text-sm font-medium text-slate-400">Raw Data</span>
                <input type="range" id="ai-slider" min="0" max="100" value="0" class="flex-1 h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-amber-500">
                <span class="text-sm font-medium text-gold-400">Clustered</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Ethics Explainer -->
        <div class="flex flex-col lg:flex-row-reverse items-center gap-16">
          <div class="flex-1 lg:pl-12">
            <h3 class="text-3xl font-bold text-slate-900 mb-6">Innovate Responsibly</h3>
            <p class="text-lg text-slate-600 mb-8 leading-relaxed">
              With the power to read the mind comes the responsibility to protect it. We champion human-centred design, ensuring cognitive privacy, accessibility, and wellbeing are never an afterthought.
            </p>
            <div class="inline-flex items-center gap-2 text-gold-600 font-medium bg-amber-50 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
              Adjust priorities
            </div>
          </div>
          <div class="flex-1 w-full">
            <div class="rounded-3xl bg-slate-900 p-8 border border-slate-800 shadow-2xl text-white">
              <div class="space-y-8 relative">
                <!-- Speed Slider -->
                <div>
                  <div class="flex justify-between mb-2">
                    <label for="eth-speed" class="text-sm font-semibold text-slate-300">Speed of Innovation</label>
                    <span id="eth-speed-val" class="text-sm text-gold-400 font-mono">50%</span>
                  </div>
                  <input type="range" id="eth-speed" min="0" max="100" value="50" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-amber-500">
                </div>
                
                <!-- Privacy Indicator -->
                <div>
                  <div class="flex justify-between mb-2">
                    <span class="text-sm font-semibold text-slate-300">Data Privacy</span>
                    <span id="eth-privacy-val" class="text-sm text-blue-400 font-mono">100%</span>
                  </div>
                  <div class="w-full h-4 bg-slate-700 rounded-full overflow-hidden">
                    <div id="eth-privacy-bar" class="h-full bg-blue-500 rounded-full w-full transition-all duration-300"></div>
                  </div>
                </div>

                <!-- Wellbeing Indicator -->
                <div>
                  <div class="flex justify-between mb-2">
                    <span class="text-sm font-semibold text-slate-300">User Wellbeing</span>
                    <span id="eth-well-val" class="text-sm text-green-400 font-mono">100%</span>
                  </div>
                  <div class="w-full h-4 bg-slate-700 rounded-full overflow-hidden">
                    <div id="eth-well-bar" class="h-full bg-green-500 rounded-full w-full transition-all duration-300"></div>
                  </div>
                </div>

                <div id="eth-warning" class="absolute -bottom-4 left-0 right-0 bg-red-500/10 border border-red-500/20 text-red-400 text-sm p-4 rounded-xl text-center opacity-0 transition-opacity pointer-events-none mt-4">
                  Moving too fast compromises privacy and user wellbeing.
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Events Preview -->
  <section class="py-24 px-6 bg-white border-t border-slate-200">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-6">
        <div>
          <h2 class="text-4xl font-bold text-slate-900 tracking-tight">Upcoming Sessions</h2>
          <p class="mt-4 text-lg text-slate-600">Join us for deep dives, workshops, and discussions.</p>
        </div>
        <a href="/events" class="inline-flex items-center justify-center px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-900 font-semibold rounded-xl transition-colors">
          View All Events
        </a>
      </div>

      <div class="flex flex-col gap-6">
        {events.length === 0 ? (
          <div class="bg-slate-50 border border-slate-200 p-10 rounded-3xl text-center">
            <div class="w-16 h-16 bg-amber-100 text-gold-600 rounded-2xl flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-3">Our Event Formats</h3>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-8">
              We host a variety of sessions designed for all experience levels. Here's what you can expect:
            </p>
            <div class="grid sm:grid-cols-3 gap-6 text-left">
              <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h4 class="font-bold text-slate-900 mb-2">Beginner Workshops</h4>
                <p class="text-slate-600 text-sm">Hands-on introductions to signal processing and machine learning.</p>
              </div>
              <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h4 class="font-bold text-slate-900 mb-2">Guest Lectures</h4>
                <p class="text-slate-600 text-sm">Insights from industry leaders and researchers in neurotech.</p>
              </div>
              <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h4 class="font-bold text-slate-900 mb-2">Ethics Panels</h4>
                <p class="text-slate-600 text-sm">Discussions on the societal and ethical impact of cognitive interfaces.</p>
              </div>
            </div>
          </div>
        ) : (
          events.slice(0, 3).map((event: any) => (
            <div class="group flex flex-col sm:flex-row gap-6 p-6 sm:p-8 rounded-3xl border border-slate-200 bg-white hover:border-amber-200 hover:shadow-xl transition-all duration-300">
              <div class="flex-shrink-0 w-24">
                <span class="block text-sm font-bold text-gold-600 mb-1">{formatEventDate(event.date)}</span>
                <span class="inline-block text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full">{event.category || 'Event'}</span>
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-gold-600 transition-colors">{event.title}</h3>
                <p class="text-slate-600 leading-relaxed text-lg">{event.description || 'Details coming soon.'}</p>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="bg-slate-900 text-white py-32 px-6 text-center">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-6">Ready to explore the mind?</h2>
      <p class="text-xl text-slate-400 mb-10 leading-relaxed">
        Join our community of students building the future of human-computer interaction. No prior experience needed.
      </p>
      <a href="/join" class="inline-flex items-center justify-center px-10 py-5 bg-gold-500 hover:bg-gold-600 text-white font-bold rounded-2xl transition-all shadow-[0_8px_30px_rgba(201,168,76,0.3)] hover:shadow-[0_12px_40px_rgba(201,168,76,0.4)] text-lg">
        Join the Society Today
      </a>
    </div>
  </section>

</Layout>

<script>
  import * as THREE from 'three';
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- Three.js Fluid Network Brain (Hero) ---
  const initHeroCanvas = () => {
    const canvasContainer = document.getElementById('hero-canvas-container');
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas || !canvasContainer) return;

    const getDimensions = () => ({
      width: canvasContainer.clientWidth,
      height: canvasContainer.clientHeight
    });

    let { width, height } = getDimensions();

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 200;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const brainGroup = new THREE.Group();
    scene.add(brainGroup);

    const particleCount = 1000;
    const particles = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const originalPositions = new Float32Array(particleCount * 3);
    const phases = new Float32Array(particleCount);
    
    const radius = 65;
    const gap = 3;

    // Generate flowing construct
    for (let i = 0; i < particleCount; i++) {
      const isLeft = i % 2 === 0;
      const sign = isLeft ? -1 : 1;
      
      let u = Math.random();
      let v = Math.random();
      let theta = u * 2.0 * Math.PI;
      let phi = Math.acos(2.0 * v - 1.0);
      let r = Math.cbrt(Math.random()) * radius;

      let x = r * Math.sin(phi) * Math.cos(theta);
      let y = r * Math.sin(phi) * Math.sin(theta);
      let z = r * Math.cos(phi);

      z *= 0.75;
      y *= 0.9;
      x = Math.abs(x) + gap;
      x *= sign;

      positions[i * 3] = x;
      positions[i * 3 + 1] = y;
      positions[i * 3 + 2] = z;
      
      originalPositions[i * 3] = x;
      originalPositions[i * 3 + 1] = y;
      originalPositions[i * 3 + 2] = z;
      
      phases[i] = Math.random() * Math.PI * 2;
    }

    particles.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    // Pure soft white and Gold particles
    const pMaterial = new THREE.PointsMaterial({
      color: 0xFAFAFA,
      size: 1.5,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending
    });
    
    const pMaterialGold = new THREE.PointsMaterial({
      color: 0xC9A84C,
      size: 2.0,
      transparent: true,
      opacity: 0.6,
      blending: THREE.AdditiveBlending
    });

    const particleSystem = new THREE.Points(particles, pMaterial);
    brainGroup.add(particleSystem);
    
    // Add some gold highlight particles
    const highlightGeo = new THREE.BufferGeometry();
    const highlightCount = 200;
    const highlightPos = new Float32Array(highlightCount * 3);
    for(let i=0; i<highlightCount; i++) {
        highlightPos[i*3] = positions[i*3];
        highlightPos[i*3+1] = positions[i*3+1];
        highlightPos[i*3+2] = positions[i*3+2];
    }
    highlightGeo.setAttribute('position', new THREE.BufferAttribute(highlightPos, 3));
    const goldSystem = new THREE.Points(highlightGeo, pMaterialGold);
    brainGroup.add(goldSystem);

    // Mouse Interaction
    let targetRotationX = 0;
    let targetRotationY = 0;
    
    canvasContainer.addEventListener('mousemove', (event) => {
      const rect = canvasContainer.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      const y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      targetRotationY = x * 0.3;
      targetRotationX = -y * 0.3;
    });

    window.addEventListener('resize', () => {
      const newDim = getDimensions();
      camera.aspect = newDim.width / newDim.height;
      camera.updateProjectionMatrix();
      renderer.setSize(newDim.width, newDim.height);
    });

    let time = 0;
    const animate = () => {
      requestAnimationFrame(animate);
      time += 0.01;

      brainGroup.rotation.y += (targetRotationY - brainGroup.rotation.y) * 0.05;
      brainGroup.rotation.x += (targetRotationX - brainGroup.rotation.x) * 0.05;
      brainGroup.rotation.y += 0.001;

      // Gentle wave motion
      const posAttribute = particles.getAttribute('position');
      for (let i = 0; i < particleCount; i++) {
         const ox = originalPositions[i*3];
         const oy = originalPositions[i*3+1];
         const oz = originalPositions[i*3+2];
         const phase = phases[i];
         
         const offset = Math.sin(time * 2 + phase) * 1.5;
         
         // Normalize
         const len = Math.sqrt(ox*ox + oy*oy + oz*oz);
         if(len > 0) {
             posAttribute.setXYZ(i, ox + (ox/len)*offset, oy + (oy/len)*offset, oz + (oz/len)*offset);
         }
      }
      posAttribute.needsUpdate = true;

      renderer.render(scene, camera);
    };

    animate();
  };

  if (prefersReducedMotion) {
    const canvas = document.getElementById('hero-canvas');
    const fallback = document.getElementById('hero-fallback');
    if (canvas) canvas.style.display = 'none';
    if (fallback) fallback.classList.remove('hidden');
    if (fallback) fallback.classList.add('flex');
  } else {
    initHeroCanvas();
  }

  // --- BCI Simulation ---
  const bciTrigger = document.getElementById('bci-trigger');
  const bciPath = document.getElementById('bci-path');
  const bciWave = document.getElementById('bci-wave');
  const bciAction = document.getElementById('bci-action');
  const bciIcon = document.getElementById('bci-icon');
  const bciStatus = document.getElementById('bci-status');

  if(bciTrigger && bciPath && bciWave && bciAction && bciStatus && bciIcon) {
      let isHolding = false;
      let amplitude = 5;
      let time = 0;
      let animationId: number;

      const down = () => { isHolding = true; bciTrigger.textContent = 'Concentrating...'; bciStatus.textContent = 'Processing'; };
      const up = () => { isHolding = false; bciTrigger.textContent = 'Concentrate (Hold)'; };

      bciTrigger.addEventListener('mousedown', down);
      bciTrigger.addEventListener('touchstart', down, {passive: true});
      window.addEventListener('mouseup', up);
      window.addEventListener('touchend', up, {passive: true});

      const drawWave = () => {
          if (prefersReducedMotion) {
              if (isHolding) amplitude = 40; else amplitude = 5;
          } else {
              if (isHolding) {
                  amplitude += (40 - amplitude) * 0.05;
              } else {
                  amplitude += (5 - amplitude) * 0.1;
              }
              time += 0.2;
          }

          if (amplitude > 30) {
              bciAction.classList.replace('bg-slate-800', 'bg-gold-500');
              bciAction.classList.replace('border-slate-700', 'border-gold-400');
              bciAction.classList.add('shadow-[0_0_30px_rgba(201,168,76,0.6)]');
              bciIcon.classList.replace('text-slate-500', 'text-white');
              bciStatus.textContent = 'Action Triggered';
              bciStatus.classList.replace('bg-gold-500/10', 'bg-gold-500');
              bciStatus.classList.replace('text-gold-500', 'text-white');
          } else {
              bciAction.classList.replace('bg-gold-500', 'bg-slate-800');
              bciAction.classList.replace('border-gold-400', 'border-slate-700');
              bciAction.classList.remove('shadow-[0_0_30px_rgba(201,168,76,0.6)]');
              bciIcon.classList.replace('text-white', 'text-slate-500');
              if(!isHolding) {
                  bciStatus.textContent = 'Resting';
                  bciStatus.classList.replace('bg-gold-500', 'bg-gold-500/10');
                  bciStatus.classList.replace('text-white', 'text-gold-500');
              }
          }

          if(!prefersReducedMotion) {
              let d = `M0,50 `;
              for(let i=0; i<=400; i+=10) {
                  const y = 50 + Math.sin(i * 0.05 - time) * amplitude;
                  d += `L${i},${y} `;
              }
              bciPath.setAttribute('d', d);
              animationId = requestAnimationFrame(drawWave);
          } else {
              // Static straight line or sine wave depending on amplitude
              let d = `M0,50 `;
              for(let i=0; i<=400; i+=20) {
                  const y = 50 + Math.sin(i * 0.05) * amplitude;
                  d += `L${i},${y} `;
              }
              bciPath.setAttribute('d', d);
              setTimeout(() => requestAnimationFrame(drawWave), 100); // Polling for reduced motion state change
          }
      };
      
      drawWave();
  }

  // --- AI Clustering Simulation ---
  const aiContainer = document.getElementById('ai-scatter-container');
  const aiSlider = document.getElementById('ai-slider') as HTMLInputElement;
  
  if (aiContainer && aiSlider) {
      const numDots = 80;
      const dots: HTMLDivElement[] = [];
      const clusters = [
          { x: 20, y: 30, color: 'bg-gold-500' },
          { x: 80, y: 70, color: 'bg-blue-500' },
          { x: 50, y: 20, color: 'bg-slate-400' }
      ];

      for(let i=0; i<numDots; i++) {
          const dot = document.createElement('div');
          const targetCluster = clusters[i % clusters.length];
          
          // Store random original pos
          const origX = Math.random() * 90 + 5;
          const origY = Math.random() * 90 + 5;
          
          // Store target pos (with some scatter)
          const targX = targetCluster.x + (Math.random() * 20 - 10);
          const targY = targetCluster.y + (Math.random() * 20 - 10);
          
          dot.className = `absolute w-3 h-3 rounded-full ${targetCluster.color} opacity-80 mix-blend-screen shadow-sm`;
          if(!prefersReducedMotion) dot.style.transition = 'all 0.3s ease-out';
          
          dot.style.left = `${origX}%`;
          dot.style.top = `${origY}%`;
          
          // Save data
          dot.dataset.ox = origX.toString();
          dot.dataset.oy = origY.toString();
          dot.dataset.tx = targX.toString();
          dot.dataset.ty = targY.toString();
          
          dots.push(dot);
          aiContainer.appendChild(dot);
      }

      aiSlider.addEventListener('input', (e) => {
          const val = parseInt((e.target as HTMLInputElement).value) / 100;
          dots.forEach(dot => {
              const ox = parseFloat(dot.dataset.ox!);
              const oy = parseFloat(dot.dataset.oy!);
              const tx = parseFloat(dot.dataset.tx!);
              const ty = parseFloat(dot.dataset.ty!);
              
              const currentX = ox + (tx - ox) * val;
              const currentY = oy + (ty - oy) * val;
              
              dot.style.left = `${currentX}%`;
              dot.style.top = `${currentY}%`;
          });
      });
  }

  // --- Ethics Simulation ---
  const ethSpeed = document.getElementById('eth-speed') as HTMLInputElement;
  const ethSpeedVal = document.getElementById('eth-speed-val');
  const ethPrivacyBar = document.getElementById('eth-privacy-bar');
  const ethPrivacyVal = document.getElementById('eth-privacy-val');
  const ethWellBar = document.getElementById('eth-well-bar');
  const ethWellVal = document.getElementById('eth-well-val');
  const ethWarning = document.getElementById('eth-warning');

  if(ethSpeed && ethPrivacyBar && ethWellBar && ethWarning && ethSpeedVal && ethPrivacyVal && ethWellVal) {
      ethSpeed.addEventListener('input', (e) => {
          const speed = parseInt((e.target as HTMLInputElement).value);
          ethSpeedVal.textContent = `${speed}%`;
          
          // Logic: Speed above 60 starts reducing privacy and wellbeing rapidly
          let privacy = 100;
          let wellbeing = 100;
          
          if(speed > 60) {
              const penalty = (speed - 60) * 2.5; // Max penalty 100 at speed 100
              privacy = Math.max(0, 100 - penalty);
              wellbeing = Math.max(0, 100 - (penalty * 0.8));
          }

          ethPrivacyBar.style.width = `${privacy}%`;
          ethPrivacyVal.textContent = `${Math.round(privacy)}%`;
          
          ethWellBar.style.width = `${wellbeing}%`;
          ethWellVal.textContent = `${Math.round(wellbeing)}%`;

          if(speed > 80) {
              ethWarning.classList.remove('opacity-0', 'pointer-events-none');
              ethPrivacyBar.classList.replace('bg-blue-500', 'bg-red-500');
              ethWellBar.classList.replace('bg-green-500', 'bg-red-500');
              ethPrivacyVal.classList.replace('text-blue-400', 'text-red-400');
              ethWellVal.classList.replace('text-green-400', 'text-red-400');
          } else {
              ethWarning.classList.add('opacity-0', 'pointer-events-none');
              ethPrivacyBar.classList.replace('bg-red-500', 'bg-blue-500');
              ethWellBar.classList.replace('bg-red-500', 'bg-green-500');
              ethPrivacyVal.classList.replace('text-red-400', 'text-blue-400');
              ethWellVal.classList.replace('text-red-400', 'text-green-400');
          }
      });
  }

</script>


