---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import BrainExplainer from '../components/BrainExplainer.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const client = createConvexClient();

const events: any[] = (
  await client.query('events:listPublished', { societySlug: SOCIETY_ID })
).filter((event: any) => event.status === 'published');

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};
---

<Layout title="Home" description="Surrey Neurotech Society Ã¢â‚¬â€ Demystifying neurotechnology. Connecting the human mind with technology through accessible exploration of BCIs, AI, and ethics.">

  <!-- Hero -->
  <section class="bg-slate-900 text-white relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-32 gradient-dark">
    <!-- Ambient light blobs -->
    <div class="absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-gold-500/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="mx-auto max-w-7xl px-6 relative z-10 w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div class="flex flex-col items-start max-w-3xl z-10">
          <p class="text-gold-500 font-semibold tracking-wide uppercase text-sm mb-4">A student-led society at the University of Surrey.</p>
          
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.1] mb-6">
            Connecting the human mind with <span class="text-gold-500">technology.</span>
          </h1>
          
          <p class="text-xl sm:text-2xl text-slate-300 leading-relaxed font-light mb-8 max-w-2xl">
            Demystifying neurotechnology. Explore brain-computer interfaces, artificial intelligence, and responsible innovation.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
            <a href="/join" class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-white font-semibold rounded-xl transition-all shadow-[0_4px_20px_rgba(201,168,76,0.3)] hover:shadow-[0_8px_30px_rgba(201,168,76,0.4)] text-base">
              Become a Member
            </a>
            <a href="/events" class="inline-flex items-center justify-center px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-xl border border-white/10 transition-all text-base backdrop-blur-sm">
              Discover Events
            </a>
          </div>

          <div class="mt-12 flex items-center gap-4 text-slate-400 text-sm">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              No experience required
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              All degrees welcome
            </span>
          </div>
        </div>
        
        <div id="hero-canvas-container" class="relative w-full aspect-square lg:aspect-auto lg:h-[600px] flex items-center justify-center pointer-events-none">
          <canvas id="hero-canvas" class="absolute inset-0 w-full h-full z-0 pointer-events-auto" style="touch-action: none;"></canvas>
          <div id="hero-fallback" class="hidden absolute inset-0 items-center justify-center pointer-events-none">
             <!-- Static Beautiful SVG fallback for reduced motion -->
             <svg class="w-full h-full max-w-md opacity-80" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M100 20C140 20 170 50 170 90C170 130 140 180 100 180C60 180 30 130 30 90C30 50 60 20 100 20Z" stroke="url(#paint0_linear)" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M100 40C120 40 140 60 140 90C140 120 120 150 100 150C80 150 60 120 60 90C60 60 80 40 100 40Z" stroke="#C9A84C" stroke-width="1.5" />
                <circle cx="100" cy="90" r="20" fill="#C9A84C" fill-opacity="0.2" stroke="#C9A84C" stroke-width="2"/>
                <defs>
                  <linearGradient id="paint0_linear" x1="30" y1="20" x2="170" y2="180" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#C9A84C"/>
                    <stop offset="1" stop-color="#FAFAFA" stop-opacity="0.2"/>
                  </linearGradient>
                </defs>
             </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Pillars -->
  <section class="py-24 px-6 bg-slate-50 relative">
    <div class="mx-auto max-w-6xl">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-4xl sm:text-5xl font-bold text-slate-900 tracking-tight">Our Focus Areas</h2>
        <p class="mt-6 text-xl text-slate-600 leading-relaxed">
          We break down complex topics into accessible, interactive experiences. See for yourself how brain-computer interfaces and artificial intelligence work.
        </p>
      </div>

      <div class="space-y-32">
        
        <!-- Neuroscience Explainer -->
        <BrainExplainer />

        <!-- BCI Explainer -->
        <div class="flex flex-col lg:flex-row-reverse items-center gap-16">
          <div class="flex-1 lg:pl-12">
            <h3 class="text-3xl font-bold text-slate-900 mb-6">Translate Thought to Action</h3>
            <p class="text-lg text-slate-600 mb-8 leading-relaxed">
              Brain-Computer Interfaces (BCIs) capture electrical signals from the brain and translate them into commands that computers or devices can understand.
            </p>
            <div class="inline-flex items-center gap-2 text-gold-600 font-medium bg-amber-50 px-4 py-2 rounded-lg">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
              Click and hold to generate a signal
            </div>
          </div>
          <div class="flex-1 w-full">
            <div class="rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl overflow-hidden relative flex flex-col p-8 text-white h-[350px]">
              <div class="flex justify-between items-center mb-8">
                <span class="text-sm font-semibold tracking-wider text-slate-400 uppercase">Signal Amplitude</span>
                <span class="text-gold-500 font-mono text-sm px-3 py-1 bg-gold-500/10 rounded-full" id="bci-status">Resting</span>
              </div>
              
              <!-- Wave Canvas -->
              <div class="flex-1 relative w-full overflow-hidden flex items-center justify-center">
                <svg id="bci-wave" class="w-[200%] h-32 text-gold-500 transition-all duration-300" viewBox="0 0 400 100" preserveAspectRatio="none">
                  <!-- Dynamic path handled in JS -->
                  <path id="bci-path" d="M0,50 Q25,50 50,50 T100,50 T150,50 T200,50 T250,50 T300,50 T350,50 T400,50" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
                <!-- Target Action Graphic -->
                <div id="bci-action" class="absolute right-8 w-16 h-16 rounded-full bg-slate-800 border-2 border-slate-700 flex items-center justify-center transition-all duration-500">
                  <svg class="w-8 h-8 text-slate-500 transition-colors duration-500" id="bci-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                </div>
              </div>

              <div class="mt-8 flex justify-center">
                <button id="bci-trigger" class="px-8 py-3 bg-white text-slate-900 font-bold rounded-full select-none hover:bg-amber-50 transition-colors focus:outline-none focus:ring-4 focus:ring-gold-500/50 active:scale-95">
                  Concentrate (Hold)
