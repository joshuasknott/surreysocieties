---
export const prerender = false;
import { Image } from 'astro:assets';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import Layout from '../layouts/Layout.astro';
import homeHero from '../assets/generated/neurotech-cathedral-graduation-sketch-hero.optimized.webp';
import talksThumb from '../assets/generated/neurotech-talks-refined-cover.optimized.webp';
import workshopsThumb from '../assets/generated/neurotech-workshops-refined-cover.optimized.webp';
import projectsThumb from '../assets/generated/neurotech-projects-refined-cover.optimized.webp';
import socialsThumb from '../assets/generated/neurotech-socials-refined-cover.optimized.webp';
import psychologyIcon from '../assets/generated/neurotech-path-psychology.optimized.webp';
import computingIcon from '../assets/generated/neurotech-path-computing.optimized.webp';
import bioscienceIcon from '../assets/generated/neurotech-path-bioscience.optimized.webp';
import designIcon from '../assets/generated/neurotech-path-design.optimized.webp';
import ethicsIcon from '../assets/generated/neurotech-path-ethics.optimized.webp';
import beginnersIcon from '../assets/generated/neurotech-path-beginners.optimized.webp';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");

const events: any[] = (
  await queryPublicConvex(api.events.listPublished, { societySlug: SOCIETY_ID }, [])
);

const eventMessage = events[0]?.title || 'Events, workshops, socials, and society updates will appear here.';

const approachSteps = [
  {
    title: 'Build',
    copy: 'Work on practical neurotech projects, including brain-computer interface ideas.',
    href: '/events',
  },
  {
    title: 'Research',
    copy: 'Explore neuroscience, AI, cognitive science, ethics, and emerging tools.',
    href: '/about',
  },
  {
    title: 'Connect',
    copy: 'Meet students, researchers, startups, and societies working in the field.',
    href: '/join',
  },
];

const disciplines = [
  { title: 'Psychology', copy: 'Minds, behaviour, cognition, and human experience.', image: psychologyIcon },
  { title: 'Computing', copy: 'AI, data, signal processing, and intelligent systems.', image: computingIcon },
  { title: 'Bioscience', copy: 'Brain biology, physiology, and biomedical discovery.', image: bioscienceIcon },
  { title: 'Engineering', copy: 'Hardware, interfaces, sensors, and practical builds.', image: designIcon },
  { title: 'Ethics', copy: 'Privacy, consent, access, safety, and real-world impact.', image: ethicsIcon },
  { title: 'Beginners', copy: 'No experience needed - only curiosity and drive.', image: beginnersIcon },
];

const activityCards = [
  {
    title: 'Hands-On Learning',
    copy: 'Workshops, journal clubs, and projects such as building brain-computer interfaces.',
    image: talksThumb,
    alt: 'Students collaborating on a neurotechnology workshop.',
    number: '01',
  },
  {
    title: 'Talks and Events',
    copy: 'Expert speakers from academia, startups, and industry sharing developments in neurotech, AI, and cognitive science.',
    image: workshopsThumb,
    alt: 'Students listening to a neurotechnology discussion.',
    number: '02',
  },
  {
    title: 'Inter-University Collaboration',
    copy: 'Hackathons, symposiums, networking initiatives, and events with other leading related societies.',
    image: projectsThumb,
    alt: 'Students presenting at a neurotechnology event.',
    number: '03',
  },
  {
    title: 'Networking and Community',
    copy: 'Routes into researchers, companies, internships, research collaborations, career insight, and an active student community.',
    image: socialsThumb,
    alt: 'Students chatting at a society social.',
    number: '04',
  },
];
---

<Layout
  title="Home"
  description="Surrey Neurotech Society is the University of Surrey's first student group dedicated to neurotechnology, connecting students with neuroscience, AI, technology, and human potential."
>
  <section class="neuro-home-hero" aria-labelledby="neuro-hero-title">
    <Image
      src={homeHero}
      alt=""
      aria-hidden="true"
      class="neuro-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={72}
    />
    <div class="neuro-home-hero__inner">
      <div class="neuro-home-hero__copy reveal">
        <span class="neuro-home-kicker">University of Surrey neurotechnology</span>
        <h1 id="neuro-hero-title" class="neuro-serif">
          Surrey Neurotech Society
        </h1>
        <div class="neuro-home-title-rule" aria-hidden="true"></div>
        <p>
          Positioning Surrey at the forefront of neurotechnology innovation by connecting students with the cutting edge of neuroscience, AI, and technology.
        </p>
        <div class="neuro-home-hero-actions">
          <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-home-btn neuro-home-btn--gold">
            Join the society <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/events" class="neuro-home-btn neuro-home-btn--outline">
            See events <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <p class="neuro-home-open-note">Open to all students - no experience needed, only curiosity and drive.</p>
      </div>
    </div>
  </section>

  <section class="neuro-home-routes-band" aria-label="How to get involved">
    <a href="/events" class="neuro-home-event-strip reveal" aria-label="View confirmed events">
      <span class="neuro-home-event-strip__mark" aria-hidden="true">Live</span>
      <span><strong>What's happening</strong><span class="neuro-home-event-strip__message">{eventMessage}</span></span>
      <span class="neuro-home-event-strip__link">See events &rarr;</span>
    </a>

    <nav class="neuro-home-route-list reveal" aria-label="How to get involved">
      {approachSteps.map((step, index) => (
        <a href={step.href} class="neuro-home-route">
          <span class="neuro-home-route__index" aria-hidden="true">0{index + 1}</span>
          <span><strong>{step.title}</strong><small>{step.copy}</small></span>
          <span class="neuro-home-route__arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </nav>
  </section>

  <section id="what-we-explore" class="neuro-home-pathways" aria-labelledby="pathways-title">
    <div class="neuro-home-pathways__inner">
      <div class="neuro-home-pathways__heading reveal">
        <span class="neuro-home-kicker">Interdisciplinary by design</span>
        <h2 id="pathways-title" class="neuro-serif">Neuroscience and technology need every discipline.</h2>
        <div class="neuro-home-title-rule" aria-hidden="true"></div>
      </div>
      <div class="neuro-home-pathway-track">
        {disciplines.map((discipline) => (
          <article class="neuro-home-pathway reveal">
            <span class="neuro-home-pathway__mark">
              <Image
                src={discipline.image}
                alt=""
                aria-hidden="true"
                widths={[96, 160, 240]}
                sizes="5.2rem"
                loading="lazy"
                format="webp"
                quality={78}
              />
            </span>
            <h3>{discipline.title}</h3>
            <p>{discipline.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-home-activities" aria-labelledby="activities-title">
    <div class="neuro-home-activities__inner">
      <div class="neuro-home-activities__intro reveal">
        <span class="neuro-home-kicker neuro-home-kicker--blue">What we do</span>
        <h2 id="activities-title" class="neuro-serif">Build, learn, meet, and shape what comes next.</h2>
        <div class="neuro-home-title-rule" aria-hidden="true"></div>
        <p>
          Surrey Neurotech brings together hands-on learning, expert talks, collaborations, networking, socials, and advocacy for more neurotech opportunity at Surrey.
        </p>
        <a href="/events" class="neuro-home-btn neuro-home-btn--blue">See all events <span aria-hidden="true">&rarr;</span></a>
      </div>

      <div class="neuro-home-activity-list">
        {activityCards.map((activity) => (
          <article class="neuro-home-activity reveal">
            <span class="neuro-home-activity__number" aria-hidden="true">{activity.number}</span>
            <div class="neuro-home-activity__copy">
              <h3 class="neuro-serif">{activity.title}</h3>
              <p>{activity.copy}</p>
            </div>
            <Image
              src={activity.image}
              alt={activity.alt}
              widths={[360, 600, 960, 1440]}
              sizes="(min-width: 761px) 16rem, calc(100vw - 4.6rem)"
              loading="lazy"
              format="webp"
              quality={76}
            />
            <a href="/events" aria-label={`Learn more about ${activity.title}`} class="neuro-home-activity__arrow">
              <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-home-action-rail" aria-label="More ways to get involved">
    <div class="neuro-home-action-rail__inner">
      <a href="/events" class="neuro-home-action-rail__item">
        <span class="neuro-home-action-rail__index" aria-hidden="true">01</span>
        <span><strong>Events</strong><small>Talks, workshops, socials, collaborations, and society updates.</small><em>See events &rarr;</em></span>
      </a>
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-home-action-rail__item">
        <span class="neuro-home-action-rail__index" aria-hidden="true">02</span>
        <span><strong>Join</strong><small>Start building, researching, networking, or learning with us.</small><em>Join the society &rarr;</em></span>
      </a>
      <a href="/committee" class="neuro-home-action-rail__item">
        <span class="neuro-home-action-rail__index" aria-hidden="true">03</span>
        <span><strong>Committee</strong><small>Meet the students building neurotech infrastructure at Surrey.</small><em>Meet the committee &rarr;</em></span>
      </a>
    </div>
  </section>
</Layout>
