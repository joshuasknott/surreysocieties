                <circle cx="70" cy="40" r="1.5" class="fill-cyan animate-pulse" style="animation-delay: 0.5s;" />
                <circle cx="80" cy="70" r="3" class="fill-cyan" />
                <circle cx="50" cy="80" r="2" class="fill-cyan" />
