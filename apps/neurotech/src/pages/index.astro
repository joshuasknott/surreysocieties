---
export const prerender = false;
import { Image } from 'astro:assets';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import Layout from '../layouts/Layout.astro';
import discoveryHero from '../assets/generated/neurotech-discovery-hero.png';
import talksThumb from '../assets/generated/neurotech-talks-thumb.png';
import workshopsThumb from '../assets/generated/neurotech-workshops-thumb.png';
import projectsThumb from '../assets/generated/neurotech-projects-thumb.png';
import socialsThumb from '../assets/generated/neurotech-socials-thumb.png';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;

const events: any[] = (
  await queryPublicConvex<any[]>('events:listPublished', { societySlug: SOCIETY_ID }, [])
).filter((event: any) => event.status === 'published');

const committee: any[] = (
  await queryPublicConvex<any[]>('committee:listActive', { societySlug: SOCIETY_ID }, [])
).sort((a: any, b: any) =>
  (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
  || (a.name || '').localeCompare(b.name || '')
);

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};

const journeyCards = [
  {
    title: 'Learn',
    copy: 'Friendly explainers, talks, and workshops that make brain science and technology easier to approach.',
    href: '/events',
  },
  {
    title: 'Meet',
    copy: 'Connect with curious students from different courses who want to explore ideas together.',
    href: '/committee',
  },
  {
    title: 'Build responsibly',
    copy: 'Discuss how technology can help people while keeping ethics, inclusion, and wellbeing in view.',
    href: '/about',
  },
];

const activityCards = [
  {
    title: 'Talks and discussions',
    copy: 'Student-led sessions and invited conversations about neurotechnology, society, and the future.',
    image: talksThumb,
    alt: 'Students listening to a friendly neurotechnology discussion.',
  },
  {
    title: 'Workshops',
    copy: 'Guided sessions for learning vocabulary, tools, and ideas at a beginner-friendly pace.',
    image: workshopsThumb,
    alt: 'Students collaborating at a bright workshop table.',
  },
  {
    title: 'Projects',
    copy: 'Collaborative experiments with ideas, prototypes, and responsible design questions.',
    image: projectsThumb,
    alt: 'Students discussing an abstract neurotechnology project on a laptop.',
  },
  {
    title: 'Socials',
    copy: 'Relaxed ways to meet people, share interests, and find your place in the society.',
    image: socialsThumb,
    alt: 'Students chatting in a relaxed society social space.',
  },
];

const principles = [
  {
    title: 'Curiosity first',
    copy: 'No one should need to arrive fluent in neuroscience, code, or hardware before they can take part.',
  },
  {
    title: 'Evidence over hype',
    copy: 'Ambitious ideas are welcome, but claims should be handled with context, uncertainty, and care.',
  },
  {
    title: 'People before devices',
    copy: 'Privacy, consent, accessibility, wellbeing, and power should stay visible whenever brain data or interfaces are discussed.',
  },
  {
    title: 'Interdisciplinary by default',
    copy: 'Psychology, computing, engineering, biomedical sciences, design, ethics, and curious beginners all belong in the same room.',
  },
];

const concepts = [
  {
    title: 'Neuron',
    copy: 'A specialist cell that communicates through signals.',
    detail: 'A useful first step is learning how nervous systems pass information through measurable processes.',
  },
  {
    title: 'Signal',
    copy: 'A pattern that can carry information.',
    detail: 'Signals need context. Measurement, noise, uncertainty, interpretation, and responsible use all matter.',
  },
  {
    title: 'Interface',
    copy: 'A bridge between people, biological systems, and technology.',
    detail: 'Interfaces should make control, feedback, accessibility, and safety easier to understand.',
  },
  {
    title: 'Consent',
    copy: 'An informed, voluntary agreement to take part or share data.',
    detail: 'Responsible neurotechnology keeps privacy, withdrawal, and power imbalance visible from the start.',
  },
];
---

<Layout
  title="Home"
  description="Surrey Neurotech Society - a student-led University of Surrey society for curious students exploring neuroscience, AI, brain-computer interfaces, signals, ethics, and responsible innovation."
>
  <section class="neuro-hero neuro-hero--home" aria-labelledby="neuro-hero-title">
    <div class="neuro-hero__inner neuro-hero__inner--home">
      <div class="neuro-hero-grid">
        <div class="reveal">
          <p class="neuro-eyebrow">Discover - Learn - Create - Impact</p>
          <h1 id="neuro-hero-title" class="neuro-serif neuro-hero-title">
            Curious minds.<br />Real connections.<br /><span>Neurotech for good.</span>
          </h1>
          <p class="neuro-hero-copy">
            Surrey Neurotech Society is a student community exploring the science of the brain and building technology that makes a positive difference.
          </p>
          <div class="neuro-action-row">
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-primary">
              Join the society
            </a>
            <a href="#what-we-explore" class="neuro-btn-secondary">
              Explore our focus areas
            </a>
          </div>
          <p class="neuro-open-note">Open to all students. All backgrounds. All levels.</p>
        </div>

        <figure class="neuro-discovery-stage reveal" aria-label="Students gathered around a friendly neurotechnology discussion visual">
          <Image
            src={discoveryHero}
            alt="Students in a bright common room discussing around a calm brain and signal visual."
            width={1536}
            height={864}
            class="neuro-discovery-image"
            loading="eager"
            format="webp"
          />
          <figcaption>
            <span>Exploring the brain.</span>
            <strong>Building a better future.</strong>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="what-we-explore" class="neuro-section neuro-section--mist" aria-labelledby="mission-title">
    <div class="neuro-shell">
      <div class="neuro-journey-heading reveal">
        <p class="neuro-eyebrow">Your journey with us</p>
        <h2 id="mission-title" class="neuro-serif">Three ways we grow together.</h2>
      </div>

      <div class="neuro-journey-grid">
        {journeyCards.map((card, index) => (
          <article class="neuro-journey-card reveal">
            <span class="neuro-journey-card__mark">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="neuro-serif">{card.title}</h3>
              <p>{card.copy}</p>
            </div>
            <a href={card.href} aria-label={`Explore ${card.title.toLowerCase()}`}>
              <span aria-hidden="true">Open</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="activities-title">
    <div class="neuro-shell">
      <div class="neuro-activities-layout">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <p class="neuro-eyebrow">What we do</p>
          <h2 id="activities-title" class="neuro-serif">Explore. Discuss. Create. Together.</h2>
          <p>
            From neuroscience to interfaces and AI, we bring big ideas to life through events, projects, and conversation.
          </p>
        </div>

        <div class="neuro-activity-card-grid">
          {activityCards.map((activity) => (
            <article class="neuro-activity-card reveal">
              <Image
                src={activity.image}
                alt={activity.alt}
                width={1536}
                height={1152}
                loading="lazy"
                format="webp"
              />
              <div>
                <h3>{activity.title}</h3>
                <p>{activity.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--deep neuro-section--responsibility" aria-labelledby="principles-title">
    <div class="neuro-shell">
      <div class="neuro-principles-layout">
        <div class="reveal">
          <h2 id="principles-title" class="neuro-serif">
            Responsible neurotechnology needs clear rules.
          </h2>
          <p>
            Neurotechnology is exciting because it touches minds, bodies, data, devices, and society at once. That makes careful thinking part of the work, not an optional extra.
          </p>
        </div>

        <div class="neuro-principle-rail reveal">
          {principles.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="concepts-title">
    <div class="neuro-shell">
      <div class="neuro-feature-grid neuro-feature-grid--balanced">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <h2 id="concepts-title" class="neuro-serif">Big ideas, plain language.</h2>
          <p>
            Technical vocabulary should be a doorway, not a wall. Tap a concept to see how the society frames it for newcomers.
          </p>
          <a href="/about" class="neuro-btn-secondary">Learn about the society</a>
        </div>

        <div class="neuro-concept-accordion reveal">
          {concepts.map((concept, index) => (
            <details name="concepts" {...(index === 0 ? { open: true } : {})}>
              <summary>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{concept.title}</strong>
                <em>{concept.copy}</em>
              </summary>
              <p>{concept.detail}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--mist" aria-labelledby="updates-title">
    <div class="neuro-shell">
      <div class="neuro-updates-header reveal">
        <h2 id="updates-title" class="neuro-serif">What's happening and who's involved.</h2>
        <p>
          Confirmed events and the student team running the society. Check back for updates on talks, workshops, socials, and more.
        </p>
      </div>

      <div class="neuro-update-rail">
        <section class="reveal" aria-labelledby="events-title">
          <h3 id="events-title" class="neuro-serif">Events</h3>

          {events.length > 0 ? (
            <div class="neuro-ledger neuro-ledger--compact">
              {events.slice(0, 2).map((event: any) => (
                <article class="neuro-row">
                  <div>
                    <time>{formatEventDate(event.date)}</time>
                    <p class="neuro-row__meta">{event.category || 'Event'}</p>
                  </div>
                  <div>
                    <h4 class="neuro-serif">{event.title}</h4>
                    <p>{event.description || 'Details will be confirmed soon.'}</p>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="neuro-empty neuro-empty--flat">
              <h4 class="neuro-serif">Events will appear once confirmed.</h4>
              <p>
                Talks, workshops, socials, and collaboration updates will be published here when the details are ready.
              </p>
            </div>
          )}
          <a href="/events" class="neuro-link-row">See all events <span aria-hidden="true">Open</span></a>
        </section>

        <section class="reveal" aria-labelledby="committee-preview-title">
          <h3 id="committee-preview-title" class="neuro-serif">Committee</h3>

          {committee.length > 0 ? (
            <div class="neuro-mini-people neuro-mini-people--flat">
              {committee.slice(0, 4).map((member: any) => (
                <article>
                  {member.imageUrl ? (
                    <img src={member.imageUrl} alt={member.name || member.role} />
                  ) : (
                    <div>{getInitials(member.name, member.role)}</div>
                  )}
                  <h4>{member.name}</h4>
                  <p>{member.role}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="neuro-empty neuro-empty--flat">
              <h4 class="neuro-serif">Committee details will appear once confirmed.</h4>
              <p>
                Confirmed names, roles, and contact details are shown once they are available through the society data.
              </p>
            </div>
          )}
          <a href="/committee" class="neuro-link-row">Meet the committee <span aria-hidden="true">Open</span></a>
        </section>
      </div>
    </div>
  </section>

  <section class="neuro-final-cta" aria-labelledby="join-title">
    <div class="neuro-shell">
      <div class="neuro-final-cta__inner">
        <div>
          <h2 id="join-title" class="neuro-serif">
            Ready to explore neurotechnology with other curious students?
          </h2>
          <p>
            Whether you want to learn, meet people, discuss big questions, or help shape future events, Surrey Neurotech is open to all.
          </p>
        </div>
        <div class="neuro-final-actions">
          <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-primary">Join the society</a>
          {society.socials.instagram && (
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="neuro-btn-dark">Instagram</a>
          )}
          <a href={`mailto:${society.contactEmail}`} class="neuro-btn-dark">Ask anything</a>
          <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-dark">Students' Union</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
