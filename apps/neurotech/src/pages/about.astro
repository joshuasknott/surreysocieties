---
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import aboutHero from '../assets/generated/neurotech-about-hero.png';
import '../styles/global.css';

const society = getSocietyById('neurotech')!;

const principles = [
  {
    title: 'Accessible before advanced',
    copy: 'Students should be able to find a first handle on unfamiliar topics before moving into deeper research or building.',
  },
  {
    title: 'Human-centred by default',
    copy: 'Neurotechnology affects people, bodies, privacy, consent, wellbeing, and access, so those questions sit at the centre.',
  },
  {
    title: 'Interdisciplinary by design',
    copy: 'The society is for psychology, computing, engineering, biomedical science, design, ethics, business, and anyone curious enough to learn.',
  },
  {
    title: 'Evidence over hype',
    copy: 'Ambition matters, but the society should stay honest about what is proven, what is speculative, and what needs careful scrutiny.',
  },
];

const work = [
  {
    title: 'Hands-On Learning',
    copy: 'We offer practical experiences including workshops, journal clubs, and projects such as building brain-computer interfaces.',
  },
  {
    title: 'Talks and Events',
    copy: 'We host expert speakers from academia, startups, and industry to share insights into emerging developments in neurotech, AI, and cognitive science.',
  },
  {
    title: 'Inter-University Collaborations',
    copy: 'We are planning large-scale events including hackathons, symposiums, and networking initiatives with other leading related societies.',
  },
  {
    title: 'Networking and Industry Links',
    copy: 'We create opportunities to connect students with researchers and companies, opening doors to internships, research collaborations, and career insights.',
  },
  {
    title: 'Socials and Community',
    copy: 'We run informal social events and maintain an active virtual community on platforms such as WhatsApp to support discussion, collaboration, and connection.',
  },
  {
    title: 'Shaping the Future of Neurotech at Surrey',
    copy: "We're advocating for more neurotech teaching and research opportunities at the university, helping build a lasting infrastructure for future students.",
  },
];
---

<Layout
  title="About"
  description="Learn about Surrey Neurotech Society, the University of Surrey student society connecting neuroscience, AI, brain-computer interfaces, ethics, and responsible innovation."
>
  <section class="neuro-hero neuro-hero--about" aria-labelledby="about-title">
    <Image
      src={aboutHero}
      alt=""
      aria-hidden="true"
      class="neuro-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={70}
    />
    <div class="neuro-hero__inner">
      <div class="neuro-subhero-grid">
        <div class="neuro-subhero-copy reveal">
          <span class="neuro-eyebrow neuro-eyebrow--gold">About the society</span>
          <h1 id="about-title" class="neuro-serif">
            The university's first neurotechnology society.
          </h1>
          <p>
            Surrey Neurotech Society is the university's first student group dedicated to neurotechnology and the fourth in the entire country. We bring together students from psychology, computer science, engineering, biomedical sciences, and more to explore how technology and neuroscience can work together to enhance human potential.
          </p>
          <div class="neuro-action-row">
            <a href="/join" class="neuro-btn-primary">Join the society</a>
            <a href="/events" class="neuro-btn-secondary">See events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--bluewash" aria-labelledby="mission-title">
    <div class="neuro-shell">
      <div class="neuro-mission-grid">
        <div class="reveal">
          <h2 id="mission-title" class="neuro-serif">
            Positioning Surrey at the forefront of neurotechnology innovation.
          </h2>
        </div>
        <div class="neuro-prose reveal">
          <p>
            Our mission is to position Surrey at the forefront of neurotechnology innovation — connecting students with the cutting edge of neuroscience, AI, and technology.
          </p>
          <p>
            Whether you're looking to build, research, network, or just learn, Surrey Neurotech is open to all. No experience needed — only curiosity and drive.
          </p>
        </div>
      </div>

      <div class="neuro-ledger neuro-ledger--clean reveal">
        {work.map((item, index) => (
          <article class="neuro-row neuro-row--activity">
            <p class="neuro-row__meta">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="neuro-serif">{item.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-neuro-muted">{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--deep" aria-labelledby="principles-title">
    <div class="neuro-shell">
      <div class="neuro-principles-layout">
        <div class="reveal">
          <h2 id="principles-title" class="neuro-serif">
            Principles for responsible neurotechnology.
          </h2>
          <p>
            We can be ambitious about what neurotechnology might become while staying precise about evidence, safety, privacy, and accessibility.
          </p>
        </div>

        <div class="neuro-principle-rail reveal">
          {principles.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="union-title">
    <div class="neuro-shell">
      <div class="neuro-feature-grid neuro-feature-grid--balanced">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <h2 id="union-title" class="neuro-serif">
            Student-led, Union-connected, and open to all.
          </h2>
          <p>
            Official membership, governance, and society activity sit within Surrey Students' Union. The public site keeps confirmed links, events, and committee information easy to find.
          </p>
        </div>

        <div class="neuro-link-panel reveal">
          <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-link-row">
            Students' Union page <span aria-hidden="true">Open</span>
          </a>
          <a href="/join" class="neuro-link-row">
            Become a member <span aria-hidden="true">Join</span>
          </a>
          <a href="/events" class="neuro-link-row">
            Confirmed events <span aria-hidden="true">View</span>
          </a>
          <a href={`mailto:${society.contactEmail}`} class="neuro-link-row">
            Contact the society <span aria-hidden="true">Send</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
