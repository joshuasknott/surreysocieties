---
return Astro.redirect('/#about', 302);
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import aboutHero from '../assets/generated/neurotech-about-campus-sketch-hero.optimized.webp';
import '../styles/global.css';

const society = getSocietyById('neurotech')!;

const principles = [
  {
    title: 'Accessible before advanced',
    copy: 'Students should be able to start with clear explanations, then move into deeper research, building, and discussion.',
  },
  {
    title: 'Human-centred by default',
    copy: 'Neurotechnology affects people, bodies, privacy, consent, wellbeing, and access, so those questions stay central.',
  },
  {
    title: 'Interdisciplinary by design',
    copy: 'The society brings together psychology, computer science, engineering, biomedical sciences, design, ethics, and more.',
  },
  {
    title: 'Evidence over hype',
    copy: 'Ambition matters, but we stay honest about what is proven, what is speculative, and what needs careful scrutiny.',
  },
];

const work = [
  {
    title: 'Hands-On Learning',
    copy: 'Practical workshops, journal clubs, and projects such as building brain-computer interfaces.',
  },
  {
    title: 'Talks and Events',
    copy: 'Confirmed talks and discussions about emerging developments in neurotech, AI, and cognitive science.',
  },
  {
    title: 'Inter-University Collaborations',
    copy: 'Large-scale events, hackathons, symposiums, and networking initiatives with other leading related societies.',
  },
  {
    title: 'Networking and Industry Links',
    copy: 'Verified career, research, and community links shared when they become available.',
  },
  {
    title: 'Socials and Community',
    copy: 'Space for students to discuss ideas, learn together, and make new connections.',
  },
  {
    title: 'Shaping Neurotech at Surrey',
    copy: 'A student voice for thoughtful neurotechnology learning and activity at Surrey.',
  },
];
---

<Layout
  title="About"
  description="Learn about Surrey Neurotech Society, the University of Surrey's first student group dedicated to neurotechnology."
>
  <section class="neuro-hero neuro-hero--about" aria-labelledby="about-title">
    <Image
      src={aboutHero}
      alt=""
      aria-hidden="true"
      class="neuro-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={72}
    />
    <div class="neuro-hero__inner">
      <div class="neuro-subhero-grid">
        <div class="neuro-subhero-copy reveal">
          <span class="neuro-eyebrow neuro-eyebrow--gold">About the society</span>
          <h1 id="about-title" class="neuro-serif">
            Surrey's first student neurotechnology society.
          </h1>
          <p>
            We connect students with the cutting edge of neuroscience, AI, and technology, and create a student-friendly route into neurotechnology innovation.
          </p>
          <div class="neuro-action-row">
            <a href="/join" class="neuro-btn-primary">Join the society</a>
            <a href="/events" class="neuro-btn-secondary">See events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--bluewash" aria-labelledby="mission-title">
    <div class="neuro-shell">
      <div class="neuro-mission-grid">
        <div class="reveal">
          <h2 id="mission-title" class="neuro-serif">
            Building an accessible student community around neurotechnology.
          </h2>
        </div>
        <div class="neuro-prose reveal">
          <p>
            Surrey Neurotech Society is the university's first student group dedicated to neurotechnology and the fourth in the country.
          </p>
          <p>
            We bring together students from psychology, computer science, engineering, biomedical sciences, and more to explore how technology and neuroscience can work together to enhance human potential.
          </p>
        </div>
      </div>

      <div class="neuro-ledger neuro-ledger--clean reveal">
        {work.map((item, index) => (
          <article class="neuro-row neuro-row--activity">
            <p class="neuro-row__meta">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="neuro-serif">{item.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-neuro-muted">{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--deep" aria-labelledby="principles-title">
    <div class="neuro-shell">
      <div class="neuro-principles-layout">
        <div class="reveal">
          <h2 id="principles-title" class="neuro-serif">
            Principles for responsible neurotechnology.
          </h2>
          <p>
            We can be ambitious about what neurotechnology might become while staying precise about evidence, safety, privacy, and accessibility.
          </p>
        </div>

        <div class="neuro-principle-rail reveal">
          {principles.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="union-title">
    <div class="neuro-shell">
      <div class="neuro-feature-grid neuro-feature-grid--balanced">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <h2 id="union-title" class="neuro-serif">
            Student-led, Union-connected, and open to all.
          </h2>
          <p>
            Official membership, governance, and confirmed society activity sit within Surrey Students' Union. Join us to learn, meet other students, and explore the field.
          </p>
        </div>

        <div class="neuro-link-panel reveal">
          <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-link-row">
            Students' Union page <span aria-hidden="true">Open</span>
          </a>
          <a href="/join" class="neuro-link-row">
            Become a member <span aria-hidden="true">Join</span>
          </a>
          <a href="/events" class="neuro-link-row">
            Confirmed events <span aria-hidden="true">View</span>
          </a>
          <a href={`mailto:${society.contactEmail}`} class="neuro-link-row">
            Contact the society <span aria-hidden="true">Send</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
