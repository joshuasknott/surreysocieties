---
export const prerender = true;
import { Image } from 'astro:assets';
import { getSocietyById } from '@surreysocieties/admin/config';
import Layout from '../layouts/Layout.astro';
import brainCutout from '../assets/generated/neurotech-realistic-brain-cutout.png';
import '../styles/global.css';

const society = getSocietyById('neurotech')!;

const principles = [
  {
    title: 'Accessible before advanced',
    copy: 'Students should be able to find a first handle on unfamiliar topics before moving into deeper research or building.',
  },
  {
    title: 'Human-centred by default',
    copy: 'Neurotechnology affects people, bodies, privacy, consent, wellbeing, and access, so those questions sit at the centre.',
  },
  {
    title: 'Interdisciplinary by design',
    copy: 'The society is for psychology, computing, engineering, biomedical science, design, ethics, business, and anyone curious enough to learn.',
  },
  {
    title: 'Evidence over hype',
    copy: 'Ambition matters, but the society should stay honest about what is proven, what is speculative, and what needs careful scrutiny.',
  },
];

const work = [
  'Hands-on workshops, journal clubs, and brain-computer interface projects',
  'Expert speakers from academia, startups, AI, and cognitive science',
  'Hackathons, symposiums, and inter-university collaborations',
  'Research, internship, and industry networking opportunities',
  'Social events and active online community on WhatsApp and beyond',
  'Advocating for more neurotech teaching and research at Surrey',
];
---

<Layout
  title="About"
  description="Learn about Surrey Neurotech Society, the University of Surrey student society connecting neuroscience, AI, brain-computer interfaces, ethics, and responsible innovation."
>
  <section class="neuro-hero" aria-labelledby="about-title">
    <div class="neuro-hero__inner">
      <div class="neuro-subhero-grid">
        <div class="neuro-subhero-copy reveal">
          <h1 id="about-title" class="neuro-serif">
            The university's first neurotechnology society.
          </h1>
          <p>
            We're the fourth society of our kind in the entire country — connecting students with neuroscience, AI, brain-computer interfaces, signal processing, and the ethics that matter.
          </p>
        </div>

        <figure class="neuro-cutout-stage neuro-cutout-stage--subhero reveal" aria-label="Anatomical brain model with signal pathways">
          <Image
            src={brainCutout}
            alt="Anatomical brain model with signal paths."
            width={1536}
            height={1024}
            class="neuro-cutout neuro-cutout--subhero-brain"
            loading="eager"
            format="webp"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--mist" aria-labelledby="mission-title">
    <div class="neuro-shell">
      <div class="neuro-mission-grid">
        <div class="reveal">
          <h2 id="mission-title" class="neuro-serif">
            Positioning Surrey at the forefront of neurotechnology innovation.
          </h2>
        </div>
        <div class="neuro-prose reveal">
          <p>
            Our mission is to connect students with the cutting-edge of neuroscience, AI, and technology. We bring together students from psychology, computer science, engineering, biomedical sciences, and more to explore how technology and neuroscience can enhance human potential.
          </p>
          <p>
            Whether you're looking to build brain-computer interfaces, understand signal processing, discuss the ethics of neurotechnology, or simply learn something new — this is the place.
          </p>
        </div>
      </div>

      <div class="neuro-ledger neuro-ledger--clean reveal">
        {work.map((item, index) => (
          <article class="neuro-row neuro-row--activity">
            <p class="neuro-row__meta">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="neuro-serif">{item}</h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--deep" aria-labelledby="principles-title">
    <div class="neuro-shell">
      <div class="neuro-principles-layout">
        <div class="reveal">
          <h2 id="principles-title" class="neuro-serif">
            Principles for responsible neurotechnology.
          </h2>
          <p>
            We can be ambitious about what neurotechnology might become while staying precise about evidence, safety, privacy, and accessibility.
          </p>
        </div>

        <div class="neuro-principle-rail reveal">
          {principles.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="union-title">
    <div class="neuro-shell">
      <div class="neuro-feature-grid neuro-feature-grid--balanced">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <h2 id="union-title" class="neuro-serif">
            Student-led, Union-connected, and open to all.
          </h2>
          <p>
            Official membership, governance, and society activity sit within Surrey Students' Union. The public site keeps confirmed links, events, and committee information easy to find.
          </p>
        </div>

        <div class="neuro-link-panel reveal">
          <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-link-row">
            Students' Union page <span aria-hidden="true">Open</span>
          </a>
          <a href="/join" class="neuro-link-row">
            Become a member <span aria-hidden="true">Join</span>
          </a>
          <a href="/events" class="neuro-link-row">
            Confirmed events <span aria-hidden="true">View</span>
          </a>
          <a href={`mailto:${society.contactEmail}`} class="neuro-link-row">
            Contact the society <span aria-hidden="true">Send</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
