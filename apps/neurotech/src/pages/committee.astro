---
export const prerender = false;
import { Image } from 'astro:assets';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import Layout from '../layouts/Layout.astro';
import bciHardwareCutout from '../assets/generated/neurotech-bci-hardware-cutout.png';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;

const committee: any[] = (
  await queryPublicConvex(api.committee.listActive, { societySlug: SOCIETY_ID }, [])
).sort((a: any, b: any) =>
  (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
  || (a.name || '').localeCompare(b.name || '')
);

const pastCommittee: any[] = (
  await queryPublicConvex(api.committee.listPast, { societySlug: SOCIETY_ID }, [])
).sort((a: any, b: any) =>
  (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
  (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
  (a.name || '').localeCompare(b.name || '')
);

const pastCommitteeYears = [...new Set(pastCommittee.map((member) => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};

const involvement = [
  {
    title: 'Join the community',
    copy: 'Membership keeps you connected to confirmed society activity through the official Union route.',
  },
  {
    title: 'Show up and ask questions',
    copy: 'Events, socials, and discussions are the simplest way to understand the society and meet other curious students.',
  },
  {
    title: 'Step forward when roles open',
    copy: 'When elections, projects, or calls for involvement are announced, active members can use those routes to contribute.',
  },
];
---

<Layout
  title="Committee"
  description="Meet the student committee running Surrey Neurotech Society and view confirmed current and past committee records."
>
  <section class="neuro-hero" aria-labelledby="committee-title">
    <div class="neuro-hero__inner">
      <div class="neuro-subhero-grid">
        <div class="neuro-subhero-copy reveal">
          <h1 id="committee-title" class="neuro-serif">
            Meet the team behind Surrey Neurotech.
          </h1>
          <p>
            The students driving events, projects, and collaborations — building a lasting infrastructure for neurotechnology at Surrey.
          </p>
        </div>

        <figure class="neuro-cutout-stage neuro-cutout-stage--subhero reveal" aria-label="Brain-computer interface hardware">
          <Image
            src={bciHardwareCutout}
            alt="Brain-computer interface hardware board with electrode leads and control device."
            width={1536}
            height={1024}
            class="neuro-cutout neuro-cutout--subhero-brain"
            loading="eager"
            format="webp"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--mist" aria-labelledby="active-committee-title">
    <div class="neuro-shell">
      <div class="neuro-feature-grid mb-12">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <h2 id="active-committee-title" class="neuro-serif">
            The current team.
          </h2>
          <p>
            Our committee brings together students from across disciplines — united by a shared passion for exploring how neuroscience and technology intersect.
          </p>
          <a href={`mailto:${society.contactEmail}`} class="neuro-btn-secondary">
            Contact the society
          </a>
        </div>

        <div class="neuro-signal-panel reveal" aria-label="Committee focus areas">
          <span>Events</span>
          <span>Members</span>
          <span>Projects</span>
        </div>
      </div>

      {committee.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 reveal">
          {committee.map((member) => (
            <article class="neuro-panel overflow-hidden">
              {member.imageUrl ? (
                <img src={member.imageUrl} alt={member.name || member.role} class="aspect-[4/3] w-full object-cover" />
              ) : (
                <div class="flex aspect-[4/3] w-full items-center justify-center bg-neuro-deep neuro-serif text-5xl text-neuro-gold">
                  {getInitials(member.name, member.role)}
                </div>
              )}
              <div class="p-5">
                <h3 class="neuro-serif text-2xl text-neuro-ink">{member.name}</h3>
                <p class="mt-1 text-sm font-bold uppercase text-neuro-navy">{member.role}</p>
                {member.bio && <p class="mt-4 text-base leading-7 text-neuro-muted">{member.bio}</p>}
                {(member.email || member.linkedIn) && (
                  <div class="mt-5 flex flex-wrap gap-3">
                    {member.email && <a href={`mailto:${member.email}`} class="text-sm font-bold text-neuro-navy hover:text-neuro-deep">Email</a>}
                    {member.linkedIn && <a href={member.linkedIn} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-neuro-navy hover:text-neuro-deep">LinkedIn</a>}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="neuro-empty reveal">
          <h2 class="mb-3 neuro-serif text-3xl text-neuro-ink">Committee details coming soon.</h2>
          <p class="neuro-prose">
            We're a student-led society. Names, roles, and contact details will appear here once the team is confirmed for the current year.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="/join" class="neuro-btn-primary">Become a member</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-secondary">Students' Union page</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="neuro-dark-band px-5 py-20 text-neuro-on-dark sm:px-6 sm:py-28" aria-labelledby="involvement-title">
    <div class="neuro-shell">
      <div class="mb-12 max-w-3xl reveal">
        <h2 id="involvement-title" class="neuro-serif text-4xl leading-tight sm:text-5xl">
          Leadership grows from participation.
        </h2>
      </div>
      <div class="neuro-principle-rail reveal">
        {involvement.map((item, index) => (
          <article>
            <h3>{String(index + 1).padStart(2, '0')} {item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="past-committee-title">
    <div class="neuro-shell">
      <div class="mb-12 max-w-3xl reveal">
        <h2 id="past-committee-title" class="neuro-serif text-4xl leading-tight text-neuro-ink sm:text-5xl">
          Past committee records.
        </h2>
      </div>

      {pastCommittee.length > 0 ? (
        <div class="space-y-12 reveal">
          {pastCommitteeYears.map((yearLabel) => (
            <section class="neuro-panel p-6">
              <h3 class="mb-6 border-b border-neuro-line pb-4 neuro-serif text-2xl text-neuro-ink">{yearLabel}</h3>
              <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
                {pastCommittee.filter((member) => member.yearLabel === yearLabel).map((member) => (
                  <li class="border-l border-neuro-gold pl-4" role="listitem">
                    <p class="neuro-serif text-xl text-neuro-ink">{member.name}</p>
                    <p class="mt-1 text-sm font-bold uppercase text-neuro-soft">{member.role}</p>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <div class="neuro-empty reveal">
          <h3 class="mb-3 neuro-serif text-2xl text-neuro-ink">Past committee records will appear once confirmed.</h3>
          <p class="neuro-prose">
            Historical records are only shown when they have been added through the society admin system.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>
