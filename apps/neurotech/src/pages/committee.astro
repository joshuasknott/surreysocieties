---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const committee = [
  { role: 'President', initials: 'P' },
  { role: 'Vice President', initials: 'VP' },
  { role: 'Treasurer', initials: 'T' },
  { role: 'Academic & Research Lead', initials: 'AR' },
  { role: 'Events Lead', initials: 'EL' },
  { role: 'Partnerships Lead', initials: 'PL' },
  { role: 'Marketing & Communications Lead', initials: 'MC' },
  { role: 'Projects Lead', initials: 'PJ' },
  { role: 'Wellbeing & Inclusion Officer', initials: 'WI' },
  { role: 'First Year Representative', initials: 'FY' },
];
---

<Layout title="Committee" description="Meet the student committee running Surrey Neurotech Society — the team behind our events, research groups, and community.">

  <section class="bg-primary text-text-on-dark py-16 sm:py-20 px-6 neural-wave-bg-dark curve-bottom relative overflow-hidden">
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span class="w-8 h-px bg-gradient-to-r from-accent/60 to-transparent"></span>
        <span class="text-accent text-sm font-semibold uppercase tracking-wider">Our Team</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Committee</h1>
      <p class="mt-4 text-text-on-dark-secondary text-lg max-w-2xl">The student volunteers who make Surrey Neurotech Society happen.</p>
    </div>
    <div class="absolute bottom-0 inset-x-0"><div class="neural-pathway"></div></div>
  </section>

  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {committee.map(member => (
          <div class="glass-card rounded-2xl p-6 border-transparent hover:border-accent/30 transition-all duration-300 hover:-translate-y-1 flex items-start gap-4">
            <div class="w-14 h-14 rounded-full bg-surface-alt border border-accent/20 shadow-sm flex items-center justify-center text-accent font-bold text-sm shrink-0">
              {member.initials}
            </div>
            <div>
              <h3 class="font-semibold text-lg">{member.role}</h3>
              <p class="text-text-muted text-sm mt-1">Name TBC</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 glass-card rounded-2xl p-8 border-transparent text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-accent-muted to-transparent opacity-30"></div>
        <div class="relative z-10">
          <h3 class="font-semibold text-lg mb-2 text-primary-deep">Interested in joining the committee?</h3>
          <p class="text-text-secondary text-sm mb-4 max-w-xl mx-auto">Committee elections happen through Surrey Students' Union. Keep an eye on our announcements for when positions open.</p>
          <a href="/join" class="text-accent hover:text-accent-dark text-sm font-semibold transition-colors">
            Join the society first →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
