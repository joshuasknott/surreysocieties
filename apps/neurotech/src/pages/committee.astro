---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const client = createConvexClient();

// Fetch committee
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((w) => w[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Neurotech Society.">

  <!-- Header -->
  <section class="bg-slate-50 py-24 px-6 relative overflow-hidden text-center border-b border-slate-200">
    <div class="mx-auto max-w-4xl relative z-10">
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-slate-900 mb-6">Meet the Team</h1>
      <p class="text-xl text-slate-600">The students behind Surrey Neurotech Society.</p>
    </div>
  </section>

  <!-- Committee Grid -->
  <section class="py-24 px-6 bg-white min-h-[50vh]">
    <div class="mx-auto max-w-6xl">
      {committee.length === 0 ? (
        <div class="w-full bg-slate-900 rounded-3xl p-16 text-center text-white shadow-2xl relative overflow-hidden">
           <div class="absolute inset-0 bg-gradient-to-r from-gold-500/10 to-blue-500/10"></div>
           <div class="relative z-10 max-w-2xl mx-auto">
             <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-8 backdrop-blur-sm">
                <svg class="w-10 h-10 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
             </div>
             <h2 class="text-4xl font-bold mb-6">Upcoming Elections</h2>
             <p class="text-xl text-slate-300 leading-relaxed mb-8">
               We are currently forming our next committee. Elections and appointments happen through Surrey Students' Union. If you're passionate about neurotech, this is your chance to lead.
             </p>
             <a href="/join" class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-white font-semibold rounded-xl transition-all shadow-lg text-lg">
                Join the Society
             </a>
           </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12">
          {committee.map(member => (
            <div class="flex flex-col items-center text-center group">
              <div class="w-48 h-48 rounded-full bg-slate-100 border border-slate-200 mb-6 flex items-center justify-center text-slate-400 text-3xl font-bold shadow-xl overflow-hidden relative transition-transform duration-500 group-hover:-translate-y-2">
                {member.imageUrl ? (
                  <img src={member.imageUrl} alt={member.name || member.role} class="w-full h-full object-cover" />
                ) : (
                  <span>{getInitials(member.name, member.role)}</span>
                )}
                <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-full"></div>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 mb-2">{member.name}</h3>
              <p class="text-lg text-gold-600 font-medium">{member.role}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>


