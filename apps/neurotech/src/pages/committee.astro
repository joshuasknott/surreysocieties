---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const client = createConvexClient();
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);

  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();

  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Neurotech Society — the team behind our events, research groups, and community.">

  <!-- Header -->
  <section class="bg-primary text-text-on-dark py-16 sm:py-20 px-6 nav-grid-dark border-b-2 border-gold/20 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-gold/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="inline-flex items-center gap-3 mb-4">
        <div class="gold-dot"></div>
        <span class="text-gold text-xs font-semibold uppercase tracking-wider">Our Team</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-text-on-dark">Committee</h1>
      <p class="mt-4 text-text-on-dark-secondary text-lg max-w-2xl border-l-2 border-gold/40 pl-4">The student volunteers who make Surrey Neurotech Society happen.</p>
    </div>
  </section>

  <!-- Committee Grid -->
  <section class="py-16 sm:py-20 px-6 bg-surface nav-grid-light">
    <div class="mx-auto max-w-6xl">
      {committee.length === 0 ? (
        <div class="neuro-card p-8 text-center">
          <h3 class="font-semibold text-lg mb-2 text-text-primary">Committee details coming soon</h3>
          <p class="text-text-secondary text-sm leading-relaxed max-w-xl mx-auto">Check back soon to meet the Surrey Neurotech Society committee.</p>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {committee.map(member => (
            <div class="neuro-card p-6 flex items-start gap-4">
              <div class="w-14 h-14 rounded-xl bg-primary border border-gold/30 flex items-center justify-center text-gold font-bold text-sm shrink-0 shadow-sm">
                {getInitials(member.name, member.role)}
              </div>
              <div>
                <h3 class="font-semibold text-lg text-text-primary">{member.role}</h3>
                <p class="text-text-muted text-sm mt-1">{member.name}</p>
              </div>
            </div>
          ))}
        </div>
      )}

      <div class="mt-12 neuro-card p-8 text-center">
        <h3 class="font-semibold text-lg mb-2 text-text-primary">Interested in joining the committee?</h3>
        <p class="text-text-secondary text-sm mb-4 max-w-xl mx-auto">Committee elections happen through Surrey Students' Union. Keep an eye on our announcements for when positions open.</p>
        <a href="/join" class="text-gold hover:text-gold-dark text-sm font-semibold transition-colors">
          Join the society first →
        </a>
      </div>
    </div>
  </section>

</Layout>
