---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const client = createConvexClient();

// Fetch committee
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((w) => w[0]).join('').toUpperCase();
};

---

<Layout title="Committee" description="Meet the student committee running Surrey Neurotech Society.">

  <!-- Premium Header -->
  <section class="bg-slate-900 text-white py-24 sm:py-32 px-6 relative overflow-hidden gradient-dark">
    <!-- Glowing background elements -->
    <div class="absolute inset-0 pointer-events-none opacity-30" aria-hidden="true">
        <div class="absolute top-[-10%] right-[10%] w-[60vw] h-[60vw] bg-teal-500/10 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] left-[10%] w-[50vw] h-[50vw] bg-blue-500/10 rounded-full blur-[100px]"></div>
    </div>
    
    <div class="mx-auto max-w-5xl relative z-10 text-center">
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-white mb-6">
        Meet the <span class="text-teal-500">Team</span>
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed font-light max-w-2xl mx-auto">
        The students driving BCI research, hardware workshops, and neurotech development at Surrey.
      </p>
    </div>
  </section>

  <!-- Committee Roster Section -->
  <section class="py-24 px-6 bg-slate-50 min-h-[60vh] border-t border-slate-200">
    <div class="mx-auto max-w-6xl">
      
      {committee.length === 0 ? (
        
        <!-- HIGH FIDELITY EMPTY STATE / ELECTIONS FALLBACK -->
        <div class="w-full bg-slate-900 rounded-3xl p-8 sm:p-16 text-center text-white shadow-2xl relative overflow-hidden border border-slate-800">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,_var(--tw-gradient-stops))] from-teal-500/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
          
          <div class="grid lg:grid-cols-12 gap-12 items-center relative z-10">
            
            <!-- Axon Core SVG Interactive -->
            <div class="lg:col-span-6 w-full flex justify-center items-center min-h-[300px]">
              <div class="w-full max-w-[420px] aspect-square rounded-3xl bg-slate-950 border border-white/5 relative flex items-center justify-center p-4">
                
                <svg class="w-full h-full overflow-visible" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" id="axon-recruitment-svg">
                  <defs>
                    <filter id="axon-glow" x="-20%" y="-20%" width="140%" height="140%">
                      <feGaussianBlur stdDeviation="8" result="blur" />
                      <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                  </defs>

                  <!-- Network Connectors -->
                  <g fill="none" stroke-width="1.5" class="opacity-40">
                    <path id="axon-path-1" d="M 200,200 Q 150,150 100,100" class="stroke-slate-700" />
                    <path id="axon-path-2" d="M 200,200 Q 250,150 300,100" class="stroke-slate-700" />
                    <path id="axon-path-3" d="M 200,200 Q 150,250 100,300" class="stroke-slate-700" />
                    <path id="axon-path-4" d="M 200,200 Q 250,250 300,300" class="stroke-slate-700" />
                  </g>

                  <!-- Floating Particles along axons -->
                  <g fill="none" stroke-width="2" class="axon-pulses pointer-events-none"></g>

                  <!-- Central Nucleus -->
                  <g>
                    <circle cx="200" cy="200" r="30" class="fill-slate-900 stroke-teal-500 stroke-2 drop-shadow-[0_0_10px_rgba(20,184,166,0.4)]" />
                    <circle cx="200" cy="200" r="8" class="fill-teal-500 animate-pulse" />
                  </g>

                  <!-- President Node -->
                  <g class="recruitment-node cursor-pointer group" tabindex="0" role="button" aria-label="President position info"
                     data-title="Society President"
                     data-desc="Lead core society operations, establish strategic sponsor relationships, organize team pipelines, and coordinate events with Surrey SU."
                     data-time="Time commitment: ~4-6 hours / week">
                    <circle cx="100" cy="100" r="24" class="fill-slate-900 stroke-slate-700 stroke-2 transition-all duration-300 group-hover:stroke-teal-500 group-hover:fill-slate-800 group-focus:stroke-teal-500" />
                    <text x="100" y="104" class="fill-teal-400 text-sm font-bold pointer-events-none" text-anchor="middle">ðŸ‘‘</text>
                    <text x="100" y="65" class="fill-slate-400 font-sans text-[9px] font-bold tracking-wider opacity-0 group-hover:opacity-100 transition-opacity uppercase text-center" text-anchor="middle">PRESIDENT</text>
                  </g>

                  <!-- Treasurer Node -->
                  <g class="recruitment-node cursor-pointer group" tabindex="0" role="button" aria-label="Treasurer position info"
                     data-title="Treasurer & Sourcing"
                     data-desc="Supervise budget accounts, draft corporate sponsorship pitches, acquire BCI headset inventory, and handle society grant allocations."
                     data-time="Time commitment: ~2-3 hours / week">
                    <circle cx="300" cy="100" r="24" class="fill-slate-900 stroke-slate-700 stroke-2 transition-all duration-300 group-hover:stroke-teal-500 group-hover:fill-slate-800 group-focus:stroke-teal-500" />
                    <text x="300" y="104" class="fill-teal-400 text-sm font-bold pointer-events-none" text-anchor="middle">ðŸ’°</text>
                    <text x="300" y="65" class="fill-slate-400 font-sans text-[9px] font-bold tracking-wider opacity-0 group-hover:opacity-100 transition-opacity uppercase text-center" text-anchor="middle">TREASURER</text>
                  </g>

                  <!-- Tech Lead Node -->
                  <g class="recruitment-node cursor-pointer group" tabindex="0" role="button" aria-label="Technical Lead position info"
                     data-title="Technical / Workshop Lead"
                     data-desc="Lead hardware assembly labs, manage GitHub codebases, prepare Python signal processing tutorials, and debug cortex-interface hardware."
                     data-time="Time commitment: ~3-5 hours / week">
                    <circle cx="100" cy="300" r="24" class="fill-slate-900 stroke-slate-700 stroke-2 transition-all duration-300 group-hover:stroke-teal-500 group-hover:fill-slate-800 group-focus:stroke-teal-500" />
                    <text x="100" y="304" class="fill-teal-400 text-sm font-bold pointer-events-none" text-anchor="middle">ðŸ’»</text>
                    <text x="100" y="342" class="fill-slate-400 font-sans text-[9px] font-bold tracking-wider opacity-0 group-hover:opacity-100 transition-opacity uppercase text-center" text-anchor="middle">TECH LEAD</text>
                  </g>

                  <!-- Marketing Node -->
                  <g class="recruitment-node cursor-pointer group" tabindex="0" role="button" aria-label="Marketing and Design position info"
                     data-title="Marketing & Design Coordinator"
                     data-desc="Produce elegant design assets, oversee online presence and social platforms, write public newsletters, and run event recruitment campaigns."
                     data-time="Time commitment: ~2-3 hours / week">
                    <circle cx="300" cy="300" r="24" class="fill-slate-900 stroke-slate-700 stroke-2 transition-all duration-300 group-hover:stroke-teal-500 group-hover:fill-slate-800 group-focus:stroke-teal-500" />
                    <text x="300" y="304" class="fill-teal-400 text-sm font-bold pointer-events-none" text-anchor="middle">ðŸŽ¨</text>
                    <text x="300" y="342" class="fill-slate-400 font-sans text-[9px] font-bold tracking-wider opacity-0 group-hover:opacity-100 transition-opacity uppercase text-center" text-anchor="middle">MARKETING</text>
                  </g>
                </svg>
              </div>
            </div>

            <!-- Detail panel & call to action -->
            <div class="lg:col-span-6 text-left flex flex-col justify-center">
              <span class="inline-flex items-center gap-1 text-teal-400 font-bold font-mono text-xs uppercase tracking-widest mb-3">
                <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
                Elections Forming Now
              </span>
              
              <div class="min-h-[170px]" id="role-panel" aria-live="polite">
                <div id="role-default">
                  <h2 class="text-3xl sm:text-4xl font-bold mb-4 tracking-tight">Run for Office</h2>
                  <p class="text-slate-300 leading-relaxed font-light text-base mb-6">
                    We are currently building our core student leadership team. Click or hover the active role nodes on the axon map to read role descriptions and join the next generation of pioneers.
                  </p>
                </div>
                
                <div id="role-active" class="hidden">
                  <h3 class="text-2xl font-bold text-white mb-2" id="role-title">Role Title</h3>
                  <p class="text-slate-300 text-sm leading-relaxed mb-3" id="role-desc">Role description</p>
                  <p class="text-xs text-teal-400 font-semibold mb-6" id="role-time">Time</p>
                </div>
              </div>

              <div class="flex flex-wrap gap-4 mt-4">
                <a href="/join" class="inline-flex items-center justify-center px-6 py-3 bg-teal-500 hover:bg-teal-600 active:scale-95 text-slate-950 font-bold rounded-xl transition-all shadow-lg text-sm">
                  Join Surrey Neurotech
                </a>
                <a href="https://surreyunion.org" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-slate-700 hover:border-slate-500 hover:bg-white/5 active:scale-95 text-white font-medium rounded-xl transition-all text-sm">
                  Union Elections Portal
                </a>
              </div>
            </div>

          </div>
        </div>

      ) : (

        <!-- ROSTER GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-12">
          {committee.map((member, index) => {
            return (
              <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 transition-all duration-300 hover:border-teal-500/30 hover:shadow-xl hover:-translate-y-2 flex flex-col items-center text-center group relative overflow-hidden">
                <!-- Glowing accent dot -->
                <div class="absolute top-3 right-3 w-2 h-2 rounded-full bg-slate-200 group-hover:bg-teal-500 group-hover:scale-125 transition-all duration-300 pointer-events-none" aria-hidden="true"></div>
                
                <!-- Avatar circle -->
                <div class="w-40 h-40 rounded-full bg-slate-950 mb-6 flex items-center justify-center text-slate-400 text-3xl font-bold shadow-lg overflow-hidden relative border-2 border-slate-200 group-hover:border-teal-500/50 transition-all duration-500">
                  {member.imageUrl ? (
                    <img src={member.imageUrl} alt={member.name || member.role} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                  ) : (
                    <span class="font-sans text-slate-200 uppercase tracking-widest">{getInitials(member.name, member.role)}</span>
                  )}
                </div>

                <!-- Member Metadata -->
                <h3 class="text-xl font-bold text-slate-900 mb-1 tracking-tight group-hover:text-teal-600 transition-colors">{member.name}</h3>
                
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-700 text-xs font-semibold uppercase tracking-wider mb-4">
                  {member.role}
                </span>

                {member.bio && (
                  <p class="text-sm text-slate-600 leading-relaxed">{member.bio}</p>
                )}

              </div>
            );
          })}
        </div>
      )}
      
    </div>
  </section>

</Layout>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Axon Map fallbacks and interaction scripts
  const nodes = document.querySelectorAll('.recruitment-node');
  const defaultPanel = document.getElementById('role-default');
  const activePanel = document.getElementById('role-active');
  const roleTitle = document.getElementById('role-title');
  const roleDesc = document.getElementById('role-desc');
  const roleTime = document.getElementById('role-time');

  const showRole = (el: SVGElement) => {
    const title = el.getAttribute('data-title') || '';
    const desc = el.getAttribute('data-desc') || '';
    const time = el.getAttribute('data-time') || '';

    if (roleTitle) roleTitle.textContent = title;
    if (roleDesc) roleDesc.textContent = desc;
    if (roleTime) roleTime.textContent = time;

    if (defaultPanel && activePanel) {
      defaultPanel.classList.add('hidden');
      activePanel.classList.remove('hidden');
    }

    // Highlighting circles
    nodes.forEach(n => {
      const circle = n.querySelector('circle');
      if (circle) {
        if (n === el) {
          circle.classList.replace('stroke-slate-700', 'stroke-teal-500');
          circle.classList.replace('fill-slate-900', 'fill-teal-500/10');
          circle.setAttribute('filter', 'url(#axon-glow)');
        } else {
          circle.classList.replace('stroke-teal-500', 'stroke-slate-700');
          circle.classList.replace('fill-teal-500/10', 'fill-slate-900');
          circle.removeAttribute('filter');
        }
      }
    });
  };

  const resetRole = () => {
    if (defaultPanel && activePanel) {
      defaultPanel.classList.remove('hidden');
      activePanel.classList.add('hidden');
    }
    nodes.forEach(n => {
      const circle = n.querySelector('circle');
      if (circle) {
        circle.classList.replace('stroke-teal-500', 'stroke-slate-700');
        circle.classList.replace('fill-teal-500/10', 'fill-slate-900');
        circle.removeAttribute('filter');
      }
    });
  };

  nodes.forEach(node => {
    const svgEl = node as SVGElement;
    svgEl.addEventListener('mouseenter', () => showRole(svgEl));
    svgEl.addEventListener('focus', () => showRole(svgEl));
    svgEl.addEventListener('mouseleave', resetRole);
    svgEl.addEventListener('blur', resetRole);
  });

  // Animated Axon Pulses along curves
  const pulseGroup = document.querySelector('.axon-pulses');
  if (!prefersReducedMotion && pulseGroup) {
    const paths = [
      document.getElementById('axon-path-1') as any,
      document.getElementById('axon-path-2') as any,
      document.getElementById('axon-path-3') as any,
      document.getElementById('axon-path-4') as any
    ];

    paths.forEach((path) => {
      if (!path) return;
      const length = path.getTotalLength();
      
      const pulse = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      pulse.setAttribute("r", "2");
      pulse.setAttribute("fill", "#14B8A6");
      pulse.setAttribute("filter", "url(#axon-glow)");
      pulseGroup.appendChild(pulse);

      let progress = Math.random();
      const speed = 0.003;

      const animatePulse = () => {
        progress += speed;
        if (progress > 1) progress = 0;
        const pt = path.getPointAtLength(progress * length);
        pulse.setAttribute("cx", pt.x.toString());
        pulse.setAttribute("cy", pt.y.toString());
        requestAnimationFrame(animatePulse);
      };
      requestAnimationFrame(animatePulse);
    });
  }
</script>

