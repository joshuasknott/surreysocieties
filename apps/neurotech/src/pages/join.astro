---
return Astro.redirect('/#join', 302);
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import joinHero from '../assets/generated/neurotech-join-campus-sketch-hero.optimized.webp';
import '../styles/global.css';

const society = getSocietyById('neurotech')!;

const steps = [
  {
    title: 'Open the official membership page',
    copy: 'Membership is handled through Surrey Students\' Union, so its checkout page is the source of truth for pricing and current details.',
  },
  {
    title: 'Complete the Union process',
    copy: 'Follow the Union flow so your membership is recorded properly against Surrey Neurotech Society.',
  },
  {
    title: 'Follow the society channels',
    copy: 'Follow @SurreyNeurotech on Instagram and check this website for events, socials, collaborations, and community updates.',
  },
];

const faqs = [
  {
    question: 'Do I need a neuroscience or computing background?',
    answer: 'No. Surrey Neurotech is open to all University of Surrey students. You only need curiosity and drive.',
  },
  {
    question: 'Where are membership details confirmed?',
    answer: 'The official Surrey Students\' Union membership page is the source of truth for checkout, pricing, and any current membership details.',
  },
  {
    question: 'Where will events appear?',
    answer: 'Events are published on the Events page. Social channels may also share talks, workshops, socials, and collaboration updates.',
  },
  {
    question: 'How can I contact the society?',
    answer: `Use the official society email: ${society.contactEmail}. You can also follow the society on Instagram and LinkedIn.`,
  },
];
---

<Layout
  title="Join"
  description="Join Surrey Neurotech Society to build, research, network, or learn about neurotechnology."
>
  <section class="neuro-hero neuro-hero--join" aria-labelledby="join-title">
    <Image
      src={joinHero}
      alt=""
      aria-hidden="true"
      class="neuro-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={72}
    />
    <div class="neuro-hero__inner">
      <div class="neuro-subhero-grid">
        <div class="neuro-subhero-copy reveal">
          <span class="neuro-eyebrow neuro-eyebrow--gold">Membership pathway</span>
          <h1 id="join-title" class="neuro-serif">
            Build, research, network, or just learn.
          </h1>
          <p>
            Surrey Neurotech is open to all - no experience needed. Join the society, follow @SurreyNeurotech, and step into the community.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-primary">
              Join via Students' Union
            </a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-secondary">
              View Union page
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--bluewash" aria-labelledby="join-steps-title">
    <div class="neuro-shell">
      <div class="mb-12 max-w-3xl reveal">
        <span class="neuro-eyebrow">Official route</span>
        <h2 id="join-steps-title" class="neuro-serif text-4xl leading-tight text-neuro-ink sm:text-5xl">
          Three simple steps through official routes.
        </h2>
      </div>

      <div class="neuro-ledger reveal">
        {steps.map((step, index) => (
          <article class="neuro-row">
            <p class="neuro-row__meta">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="mb-3 neuro-serif text-2xl text-neuro-ink">{step.title}</h3>
              <p class="max-w-3xl text-base leading-7 text-neuro-muted">{step.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--deep" aria-labelledby="connect-title">
    <div class="neuro-shell">
      <div class="neuro-community-grid">
        <div class="reveal">
          <h2 id="connect-title" class="neuro-serif">
            Stay connected to talks, workshops, socials, and neurotech opportunities.
          </h2>
          <p>
            Membership is the clearest way in. Our channels help you keep up with events, ask questions, join discussions, and meet people before your first session.
          </p>
        </div>

        <div class="neuro-link-panel neuro-link-panel--dark reveal">
          {society.socials.instagram && (
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="neuro-link-row text-neuro-on-dark">
              <span>Instagram</span>
              <span aria-hidden="true">Open</span>
            </a>
          )}
          {society.socials.linkedin && (
            <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="neuro-link-row text-neuro-on-dark">
              <span>LinkedIn</span>
              <span aria-hidden="true">Open</span>
            </a>
          )}
          <a href={`mailto:${society.contactEmail}`} class="neuro-link-row text-neuro-on-dark">
            <span>Email</span>
            <span aria-hidden="true">Send</span>
          </a>
          <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-link-row text-neuro-on-dark">
            <span>Students' Union</span>
            <span aria-hidden="true">Open</span>
          </a>
          <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="neuro-link-row border-b-0 text-neuro-on-dark">
            <span>Membership</span>
            <span aria-hidden="true">Join</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="faq-title">
    <div class="neuro-shell">
      <div class="mb-12 max-w-3xl reveal">
        <h2 id="faq-title" class="neuro-serif text-4xl leading-tight text-neuro-ink sm:text-5xl">
          Practical answers before you join.
        </h2>
      </div>

      <div class="neuro-faq-list reveal">
        {faqs.map((item) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5">
              <h3 class="neuro-serif text-xl text-neuro-ink">{item.question}</h3>
              <span class="text-2xl font-bold text-neuro-gold-ink transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-5 max-w-3xl text-base leading-7 text-neuro-muted">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
