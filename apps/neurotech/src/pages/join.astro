---
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const society = getSocietyById('neurotech')!;
---

<Layout title="Join" description="Join Surrey Neurotech Society — find out how to become a member, what you'll get, and how to stay connected.">

  <section class="bg-surface-dark text-text-on-dark py-16 sm:py-20 px-6  curve-bottom relative overflow-hidden">
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-cyan"></span>
        <span class="w-8 h-px bg-gradient-to-r from-cyan/60 to-transparent"></span>
        <span class="text-cyan text-sm font-semibold uppercase tracking-wider">Get Involved</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Join Us</h1>
      <p class="mt-4 text-text-on-dark-secondary text-lg max-w-2xl">Membership is open to all University of Surrey students through Surrey Students' Union.</p>
    </div>
    <div class="absolute bottom-0 inset-x-0"></div>
  </section>

  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6">Why Join?</h2>
          <div class="space-y-4">
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-cyan/10 flex items-center justify-center text-cyan shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Access to talks, workshops, and reading groups on neuroscience and neurotechnology</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-cyan/10 flex items-center justify-center text-cyan shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Hands-on project opportunities with EEG and BCI tools</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-cyan/10 flex items-center justify-center text-cyan shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">An interdisciplinary community spanning neuroscience, CS, engineering, and psychology</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-cyan/10 flex items-center justify-center text-cyan shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Careers-focused events exploring paths in neurotech and related fields</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-cyan/10 flex items-center justify-center text-cyan shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Shape the direction of the society — we're student-run and open to ideas</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6">Who Can Join?</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            Any student at the University of Surrey. You don't need to be studying neuroscience or have any technical background. We welcome curious minds from every discipline.
          </p>
          <p class="text-text-secondary leading-relaxed">
            Membership is managed through Surrey Students' Union. You can sign up on their website.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-alt py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="neuro-card rounded-2xl p-8 sm:p-12 border-transparent text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-cyan/10 to-transparent opacity-30"></div>
        <div class="relative z-10">
          <h2 class="text-2xl sm:text-3xl font-bold mb-4">Become a Member</h2>
          <p class="text-text-secondary mb-8 max-w-lg mx-auto">Membership is handled through Surrey Students' Union.</p>
          <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-4 bg-cyan hover:bg-cyan-dark text-primary-deep font-bold rounded-full transition-all hover:shadow-lg hover:shadow-secondary/20 hover:-translate-y-0.5">
            Join Through Surrey Union
          </a>
          <p class="mt-4 text-sm text-text-muted">
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-cyan underline underline-offset-4">View the society page on the Students' Union site</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold mb-6">Stay Connected</h2>
          <div class="space-y-4">
            <div class="neuro-card rounded-2xl p-5 border-transparent">
              <h3 class="font-semibold mb-1">Instagram</h3>
              <p class="text-text-muted text-sm"><a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-cyan underline underline-offset-4">Follow us for event announcements and updates.</a></p>
            </div>
            <div class="neuro-card rounded-2xl p-5 border-transparent">
              <h3 class="font-semibold mb-1">Email</h3>
              <p class="text-text-muted text-sm"><a href={`mailto:${society.contactEmail}`} class="hover:text-cyan underline underline-offset-4">{society.contactEmail}</a></p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-6">FAQ</h2>
          <div class="space-y-4">
            <div>
              <h3 class="font-semibold mb-1">Do I need a science background?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">No. Our events are designed to be accessible. We start from first principles and build up.</p>
            </div>
            <div>
              <h3 class="font-semibold mb-1">Is there a membership fee?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Fees are set through Surrey Students' Union and will be confirmed on our membership page.</p>
            </div>
            <div>
              <h3 class="font-semibold mb-1">What kind of projects do you work on?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Projects vary — from EEG signal analysis to exploring BCI applications. We'll announce project opportunities to members.</p>
            </div>
            <div>
              <h3 class="font-semibold mb-1">I'm a first-year. Is this for me?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Absolutely. We have a First Year Representative on our committee and design events to be welcoming to newcomers.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
