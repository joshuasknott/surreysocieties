---
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const society = getSocietyById('neurotech')!;
---

<Layout title="Join" description="Become a member of Surrey Neurotech Society. No prior experience required.">

  <!-- Header -->
  <section class="bg-slate-50 py-24 px-6 relative overflow-hidden text-center border-b border-slate-200">
    <div class="mx-auto max-w-4xl relative z-10">
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-slate-900 mb-6">Become a Member</h1>
      <p class="text-xl text-slate-600">Join our community and explore the intersection of mind and machine.</p>
    </div>
  </section>

  <!-- Who Can Join -->
  <section class="py-24 px-6 bg-white">
    <div class="mx-auto max-w-4xl text-center">
       <h2 class="text-4xl font-bold text-slate-900 mb-8">Who can join?</h2>
       <p class="text-2xl text-slate-600 leading-relaxed font-light mb-12">
          Anyone. Literally anyone. You <strong class="font-semibold text-gold-600">do not</strong> need prior experience in programming, biology, or engineering. We welcome curious minds from any degree background.
       </p>
    </div>
  </section>

  <!-- The Journey (Steps) -->
  <section class="py-24 px-6 bg-slate-900 text-white relative overflow-hidden">
     <!-- Ambient light blobs -->
    <div class="absolute top-[50%] right-[-10%] w-[400px] h-[400px] bg-gold-500/10 rounded-full blur-[100px] pointer-events-none -translate-y-1/2"></div>
    
    <div class="mx-auto max-w-5xl relative z-10">
      <h2 class="text-4xl font-bold mb-16 text-center">How to join</h2>
      
      <div class="grid md:grid-cols-3 gap-12">
         <!-- Step 1 -->
         <div class="relative">
            <div class="text-8xl font-black text-white/5 absolute -top-8 -left-4 z-0 pointer-events-none">1</div>
            <div class="relative z-10">
               <h3 class="text-2xl font-bold text-gold-400 mb-4">Get Membership</h3>
               <p class="text-slate-300 leading-relaxed mb-6">
                  Sign up for a free or paid membership via Surrey Students' Union to become an official member of the society.
               </p>
               <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center font-semibold text-white hover:text-gold-400 transition-colors group">
                  Sign up on SU <span class="ml-2 group-hover:translate-x-1 transition-transform">â†’</span>
               </a>
            </div>
         </div>
         
         <!-- Step 2 -->
         <div class="relative">
            <div class="text-8xl font-black text-white/5 absolute -top-8 -left-4 z-0 pointer-events-none">2</div>
            <div class="relative z-10">
               <h3 class="text-2xl font-bold text-gold-400 mb-4">Join the Discord</h3>
               <p class="text-slate-300 leading-relaxed mb-6">
                  Our Discord is where our community lives. Chat with members, find resources, and get instant updates on events.
               </p>
               <a href={society.socials.discord || '#'} target="_blank" rel="noopener noreferrer" class="inline-flex items-center font-semibold text-white hover:text-gold-400 transition-colors group">
                  Join our Discord <span class="ml-2 group-hover:translate-x-1 transition-transform">â†’</span>
               </a>
            </div>
         </div>

         <!-- Step 3 -->
         <div class="relative">
            <div class="text-8xl font-black text-white/5 absolute -top-8 -left-4 z-0 pointer-events-none">3</div>
            <div class="relative z-10">
               <h3 class="text-2xl font-bold text-gold-400 mb-4">Follow Us</h3>
               <p class="text-slate-300 leading-relaxed mb-6">
                  Follow us on Instagram and LinkedIn to stay up to date with our professional network, photos, and announcements.
               </p>
               <div class="flex flex-col gap-3">
                   <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center font-semibold text-white hover:text-gold-400 transition-colors group">
                      Follow Instagram <span class="ml-2 group-hover:translate-x-1 transition-transform">â†’</span>
                   </a>
                   <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center font-semibold text-white hover:text-gold-400 transition-colors group">
                      Connect LinkedIn <span class="ml-2 group-hover:translate-x-1 transition-transform">â†’</span>
                   </a>
               </div>
            </div>
         </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 px-6 bg-slate-50">
     <div class="mx-auto max-w-3xl">
        <h2 class="text-4xl font-bold text-slate-900 mb-12 text-center">Frequently Asked Questions</h2>
        
        <div class="space-y-6">
           <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-slate-900 group-open:bg-slate-50 transition-colors">
                 <span>Do I need a science or tech background?</span>
                 <svg class="w-6 h-6 text-gold-500 transform group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="p-6 pt-0 text-slate-600 leading-relaxed text-lg border-t border-slate-100 mt-2 bg-slate-50">
                 No. Our events are designed to be accessible. We start from first principles and build up. We have members from arts, humanities, business, and sciences.
              </div>
           </details>
           
           <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-slate-900 group-open:bg-slate-50 transition-colors">
                 <span>Is there a membership fee?</span>
                 <svg class="w-6 h-6 text-gold-500 transform group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="p-6 pt-0 text-slate-600 leading-relaxed text-lg border-t border-slate-100 mt-2 bg-slate-50">
                 Fees are set through Surrey Students' Union and are either free or very low cost to cover basic society running expenses. Check the SU page for current pricing.
              </div>
           </details>

           <details class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between p-6 cursor-pointer font-bold text-lg text-slate-900 group-open:bg-slate-50 transition-colors">
                 <span>I'm a first-year. Is this for me?</span>
                 <svg class="w-6 h-6 text-gold-500 transform group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="p-6 pt-0 text-slate-600 leading-relaxed text-lg border-t border-slate-100 mt-2 bg-slate-50">
                 Absolutely. We have a First Year Representative on our committee and design events to be highly welcoming to newcomers.
              </div>
           </details>
        </div>
     </div>
  </section>

</Layout>

<script>
  // Simple script to auto-close other details when one is opened
  const details = document.querySelectorAll("details");
  details.forEach((targetDetail) => {
    targetDetail.addEventListener("click", () => {
      details.forEach((detail) => {
        if (detail !== targetDetail) {
          detail.removeAttribute("open");
        }
      });
    });
  });
</script>

