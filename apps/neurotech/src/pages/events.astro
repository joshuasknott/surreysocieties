---
export const prerender = false;
import { Image } from 'astro:assets';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import Layout from '../layouts/Layout.astro';
import eegWorkstationCutout from '../assets/generated/neurotech-eeg-workstation-cutout.png';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;

const events: any[] = (
  await queryPublicConvex<any[]>('events:listPublished', { societySlug: SOCIETY_ID }, [])
).filter((event: any) => event.status === 'published');

const categories = [...new Set(events.map((event) => event.category || 'Event'))];

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};

const formatEventTime = (event: any) => {
  if (!event.startTime) return '';
  return `${event.startTime}${event.endTime ? ` - ${event.endTime}` : ''}`;
};

const programmeThemes = [
  {
    title: 'Introductory neurotechnology learning',
    copy: 'Sessions that help students understand brain, interface, data, and ethics vocabulary from the ground up.',
  },
  {
    title: 'Journal clubs and careful discussion',
    copy: 'Formats for exploring papers, claims, case studies, emerging questions, and uncertainty with evidence and context.',
  },
  {
    title: 'Workshops and building sessions',
    copy: 'Practical activity around EEG, signal processing, brain-computer interface concepts, and accessible prototyping.',
  },
  {
    title: 'Collaboration beyond one course',
    copy: 'Inter-university plans, hackathons, symposiums, socials, and conversations with related student societies.',
  },
];
---

<Layout
  title="Events"
  description="Confirmed Surrey Neurotech Society events and programme updates around accessible neurotechnology learning, discussion, and responsible innovation."
>
  <section class="neuro-hero" aria-labelledby="events-title">
    <div class="neuro-hero__inner">
      <div class="neuro-subhero-grid">
        <div class="neuro-subhero-copy reveal">
          <h1 id="events-title" class="neuro-serif">
            Events, talks, and workshops.
          </h1>
          <p>
            Our confirmed events appear here. From speaker nights to signal-processing workshops, find out what's happening and how to get involved.
          </p>
        </div>

        <figure class="neuro-cutout-stage neuro-cutout-stage--subhero neuro-cutout-stage--subhero-signal reveal" aria-label="Portable EEG signal workstation">
          <Image
            src={eegWorkstationCutout}
            alt="Portable EEG signal workstation with waveform traces, amplifier, leads, and electrodes."
            width={1536}
            height={1024}
            class="neuro-cutout neuro-cutout--subhero-signal"
            loading="eager"
            format="webp"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="neuro-section neuro-section--mist" aria-labelledby="event-ledger-title">
    <div class="neuro-shell">
      <div class="neuro-feature-grid mb-12">
        <div class="neuro-section-heading neuro-section-heading--left reveal">
          <h2 id="event-ledger-title" class="neuro-serif">
            What we're planning.
          </h2>
          <p>
            Events are built around accessible learning, practical building, interdisciplinary discussion, and responsible innovation.
          </p>
          {society.socials.instagram && (
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="neuro-btn-secondary">
              Follow updates
            </a>
          )}
        </div>

        <div class="neuro-signal-panel reveal" aria-label="Programme signals">
          <span>Signals</span>
          <span>Interfaces</span>
          <span>Discussion</span>
        </div>
      </div>

      {events.length > 0 ? (
        <>
          {categories.length > 1 && (
            <div class="mb-8 flex flex-wrap gap-3 reveal" aria-label="Filter events by category">
              <button type="button" class="neuro-btn-primary text-sm" data-event-filter="all" aria-pressed="true">All</button>
              {categories.map((category) => (
                <button type="button" class="neuro-btn-secondary text-sm" data-event-filter={category} aria-pressed="false">{category}</button>
              ))}
            </div>
          )}

          <div class="neuro-ledger reveal" data-event-list>
            {events.map((event) => (
              <article class="neuro-row" data-event-card data-category={event.category || 'Event'}>
                <div>
                  <p class="neuro-row__meta">{event.category || 'Event'}</p>
                  <time class="mt-3 block font-bold text-neuro-ink">{formatEventDate(event.date)}</time>
                  {formatEventTime(event) && (
                    <p class="mt-2 text-sm font-semibold text-neuro-soft">{formatEventTime(event)}</p>
                  )}
                  {event.location && (
                    <p class="mt-2 text-sm font-semibold text-neuro-soft">{event.location}</p>
                  )}
                </div>
                <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
                  <div>
                    <h3 class="mb-3 neuro-serif text-2xl text-neuro-ink">{event.title}</h3>
                    {event.description ? (
                      <p class="max-w-3xl text-base leading-7 text-neuro-muted">{event.description}</p>
                    ) : (
                      <p class="max-w-3xl text-base leading-7 text-neuro-muted">Further details will be confirmed soon.</p>
                    )}
                  </div>
                  {event.registrationUrl && (
                    <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-primary text-sm">
                      Register
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </>
      ) : (
        <div class="neuro-empty reveal">
          <h2 class="mb-3 neuro-serif text-3xl text-neuro-ink">Events coming soon.</h2>
          <p class="neuro-prose">
            We're working on an exciting programme of talks, workshops, socials, and collaborations. Join the society or follow our channels to be the first to know.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="/join" class="neuro-btn-primary">Join for updates</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="neuro-btn-secondary">Students' Union page</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="neuro-section neuro-section--paper" aria-labelledby="programme-themes-title">
    <div class="neuro-shell">
      <div class="mb-12 max-w-3xl reveal">
          <h2 id="programme-themes-title" class="neuro-serif text-4xl leading-tight text-neuro-ink sm:text-5xl">
            What our events look like.
        </h2>
      </div>

      <div class="neuro-ledger neuro-ledger--clean reveal">
        {programmeThemes.map((theme, index) => (
          <article class="neuro-row neuro-row--activity">
            <p class="neuro-row__meta">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="mb-3 neuro-serif text-2xl text-neuro-ink">{theme.title}</h3>
              <p class="max-w-3xl text-base leading-7 text-neuro-muted">{theme.copy}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <script>
    const filterButtons = Array.from(document.querySelectorAll('[data-event-filter]'));
    const eventCards = Array.from(document.querySelectorAll('[data-event-card]'));

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const activeCategory = button.getAttribute('data-event-filter') || 'all';

        filterButtons.forEach((candidate) => {
          const isActive = candidate === button;
          candidate.setAttribute('aria-pressed', String(isActive));
          candidate.classList.toggle('neuro-btn-primary', isActive);
          candidate.classList.toggle('neuro-btn-secondary', !isActive);
        });

        eventCards.forEach((card) => {
          const shouldShow = activeCategory === 'all' || card.getAttribute('data-category') === activeCategory;
          card.toggleAttribute('hidden', !shouldShow);
        });
      });
    });
  </script>
</Layout>
