---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const client = createConvexClient();
const events: any[] = (await client.query("events:listPublished", { societySlug: SOCIETY_ID }))
  .filter((event: any) => event.status === 'published')
  .sort((a: any, b: any) => {
      if(!a.date && !b.date) return 0;
      if(!a.date) return 1;
      if(!b.date) return -1;
      return new Date(a.date).getTime() - new Date(b.date).getTime();
  });

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};
---

<Layout title="Events" description="Upcoming events, beginner-friendly BCI workshops, and guest lectures at Surrey Neurotech Society.">

  <!-- Premium Header -->
  <section class="bg-slate-900 text-white py-24 sm:py-32 px-6 relative overflow-hidden gradient-dark">
    <!-- Glowing background elements -->
    <div class="absolute inset-0 pointer-events-none opacity-30" aria-hidden="true">
        <div class="absolute top-[-10%] right-[10%] w-[60vw] h-[60vw] bg-gold-500/10 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] left-[10%] w-[50vw] h-[50vw] bg-blue-500/10 rounded-full blur-[100px]"></div>
    </div>
    
    <div class="mx-auto max-w-5xl relative z-10 text-center">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-400 text-sm font-semibold mb-6">
        Society Calendar
      </span>
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-white mb-6">
        Discover Our <span class="text-gold-500">Events</span>
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed font-light max-w-2xl mx-auto">
        Deep dives, hands-on hardware labs, ethics panels, and hackathons mapping the boundaries of mind-machine interfaces.
      </p>
    </div>
  </section>

  <!-- Events List / Timeline -->
  <section class="py-24 px-6 bg-slate-50 min-h-[60vh] border-t border-slate-200">
    <div class="mx-auto max-w-5xl">
      
      {events.length === 0 ? (
        
        <!-- HIGH FIDELITY EMPTY STATE / WHAT TO EXPECT SIMULATOR -->
        <div class="bg-slate-900 rounded-3xl p-8 sm:p-16 text-white shadow-2xl relative overflow-hidden border border-slate-800">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,_var(--tw-gradient-stops))] from-gold-500/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
          
          <div class="relative z-10 max-w-4xl mx-auto">
            <span class="inline-flex items-center gap-1 text-gold-400 font-bold font-mono text-xs uppercase tracking-widest mb-6">
              Core Activities
            </span>
            <h2 class="text-3xl sm:text-4xl font-bold mb-4 tracking-tight">Our Signature Formats</h2>
            <p class="text-slate-300 font-light leading-relaxed mb-12 max-w-2xl mx-auto text-sm sm:text-base">
              We are finalizing our events calendar for this term. Under the hood, we host signature formats aligned with specific brainwave focus regions. Modulate the simulator below to explore.
            </p>

            <!-- Brainwave Selector Widget -->
            <div class="bg-slate-950 border border-white/5 rounded-2xl p-6 sm:p-8 mb-12 relative">
              
              <!-- Tab Controls -->
              <div class="flex flex-wrap gap-2 justify-center mb-8 border-b border-white/5 pb-6" role="tablist" aria-label="Brainwave activity channels">
                <button class="wave-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold tracking-wider transition-all duration-300 bg-gold-500 text-slate-950 shadow-md font-mono" role="tab" aria-selected="true" data-wave="alpha" id="tab-alpha">
                  ALPHA (8-12 Hz)
                </button>
                <button class="wave-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold tracking-wider transition-all duration-300 bg-white/5 border border-white/10 hover:border-gold-500/40 text-slate-300 font-mono" role="tab" aria-selected="false" data-wave="beta" id="tab-beta">
                  BETA (12-30 Hz)
                </button>
                <button class="wave-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold tracking-wider transition-all duration-300 bg-white/5 border border-white/10 hover:border-gold-500/40 text-slate-300 font-mono" role="tab" aria-selected="false" data-wave="theta" id="tab-theta">
                  THETA (4-8 Hz)
                </button>
                <button class="wave-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold tracking-wider transition-all duration-300 bg-white/5 border border-white/10 hover:border-gold-500/40 text-slate-300 font-mono" role="tab" aria-selected="false" data-wave="gamma" id="tab-gamma">
                  GAMMA (30-100 Hz)
                </button>
              </div>

              <!-- Animated Signal Telemetry Wave SVG -->
              <div class="w-full h-32 bg-slate-900 rounded-xl overflow-hidden relative flex items-center border border-white/5 mb-8">
                <!-- SVG Grid Overlay -->
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none"></div>
                <div class="absolute left-4 top-4 font-mono text-[9px] text-slate-500 uppercase tracking-widest flex items-center gap-1.5" aria-hidden="true">
                  <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                  Signal Telemetry Feed
                </div>

                <svg class="w-full h-full" viewBox="0 0 500 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <filter id="wave-glow" x="-10%" y="-10%" width="120%" height="120%">
                      <feGaussianBlur stdDeviation="4" result="blur" />
                      <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                  </defs>
                  <path id="telemetry-wave-path" d="M 0 60" fill="none" stroke="#C9A84C" stroke-width="2" filter="url(#wave-glow)" />
                </svg>
              </div>

              <!-- Description Block -->
              <div class="text-left bg-slate-900/60 p-6 rounded-xl border border-white/5 min-h-[140px]" id="wave-detail-panel" aria-live="polite">
                <span class="text-gold-400 font-bold font-mono text-xs uppercase tracking-widest mb-1.5 block" id="wave-focus">STATE: Reflective Calming</span>
                <h4 class="text-xl font-bold text-white mb-2" id="wave-event-type">Ethics Panels & Philosophy Forums</h4>
                <p class="text-slate-300 text-sm leading-relaxed" id="wave-event-desc">
                  Focused discussions around cognitive privacy, policy guidelines, neural data ownership, and public accessibility frameworks. Relaxed, reflective cognitive states.
                </p>
              </div>

            </div>

            <div class="mt-8 flex flex-col items-center">
              <p class="text-slate-400 text-sm mb-6">Stay tuned! We post calendar listings immediately as they are locked in.</p>
              <a href="/join" class="inline-flex items-center justify-center px-6 py-3 bg-gold-500 hover:bg-gold-600 active:scale-95 text-slate-950 font-bold rounded-xl transition-all shadow-md text-sm">
                Become a Member to Get Updates
              </a>
            </div>

          </div>
        </div>

      ) : (

        <!-- HIGH FIDELITY EVENTS LIST VIEW -->
        <div class="relative pl-8 sm:pl-16">
          
          <!-- Continuous Action Potential Timeline line -->
          <div class="absolute left-[7px] sm:left-[15px] top-6 bottom-6 w-[2px] bg-gradient-to-b from-gold-500 via-gold-500/30 to-slate-200 rounded-full" id="timeline-spine"></div>
          
          <!-- Animated pulse traveling down the spine -->
          <div class="absolute left-[7px] sm:left-[15px] w-[2px] h-20 bg-gradient-to-b from-transparent via-gold-400 to-transparent top-0 rounded-full pointer-events-none inline-block hidden" id="timeline-pulse"></div>

          <div class="space-y-12 sm:space-y-16">
            {events.map((event) => (
              <div class="relative group">
                
                <!-- Action Potential Gateway Node -->
                <div class="absolute -left-8 sm:-left-16 top-9 w-4 h-4 rounded-full bg-slate-950 border-[3px] border-slate-300 group-hover:border-gold-500 group-hover:scale-125 transition-all duration-300 shadow-md flex items-center justify-center -translate-x-[2px] sm:-translate-x-[3px] z-10" aria-hidden="true">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-800 group-hover:bg-gold-500 transition-colors"></span>
                </div>
                
                <!-- Card Container -->
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm hover:shadow-xl hover:border-gold-500/30 transition-all duration-300 relative overflow-hidden group-hover:-translate-y-1">
                  
                  <!-- Corner accent glow -->
                  <div class="absolute top-0 right-0 w-24 h-24 bg-[radial-gradient(circle_at_100%_0%,_var(--tw-gradient-stops))] from-gold-500/5 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

                  <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-6">
                      <div>
                          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 text-gold-700 text-xs font-semibold uppercase tracking-wider mb-4">
                            {event.category || 'Event'}
                          </span>
                          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 group-hover:text-gold-600 transition-colors tracking-tight leading-tight">{event.title}</h2>
                      </div>
                      <div class="text-left lg:text-right text-slate-500 font-mono text-sm whitespace-nowrap bg-slate-100/50 border border-slate-200/50 rounded-xl px-4 py-2 self-start lg:self-auto">
                          {formatEventDate(event.date)}
                      </div>
                  </div>
                  
                  <div class="prose prose-slate max-w-none mb-8 text-base sm:text-lg text-slate-600 leading-relaxed font-light">
                      {event.description || 'Join us for this upcoming session. Full details will be announced soon.'}
                  </div>
                  
                  {(event.location || event.startTime) && (
                      <div class="flex flex-wrap gap-6 pt-6 border-t border-slate-150 text-slate-600 font-medium text-sm sm:text-base">
                          {event.startTime && (
                              <div class="flex items-center gap-2">
                                  <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                  {event.startTime} {event.endTime && `- ${event.endTime}`}
                              </div>
                          )}
                          {event.location && (
                              <div class="flex items-center gap-2">
                                  <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                  {event.location}
                              </div>
                          )}
                      </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
      
    </div>
  </section>

</Layout>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- BRAINWAVE SIMULATOR AND TELEMETRY MATH GENERATOR ---
  const waveData = {
    alpha: {
      focus: "STATE: Reflective Calming",
      type: "Ethics Panels & Philosophy Forums",
      desc: "Focused discussions around cognitive privacy, policy guidelines, neural data ownership, and public accessibility frameworks. Relaxed, reflective cognitive states.",
      freq: 0.08,
      amp: 20,
      noise: 0.5,
      speed: 0.03
    },
    beta: {
      focus: "STATE: Active Analysis",
      type: "Guest Lectures & Industry Speakers",
      desc: "Analytical deep dives featuring researchers, BCI startups, and AI pioneers. Explores algorithmic theories and active neurotech deployments.",
      freq: 0.18,
      amp: 10,
      noise: 1.5,
      speed: 0.07
    },
    theta: {
      focus: "STATE: Creative Incubation",
      type: "Idea Incubators & Student Projects",
      desc: "Subconscious collaborative hacking. Ideating prototypes, researching open-source schemas, and working on society hardware solutions.",
      freq: 0.04,
      amp: 30,
      noise: 0.3,
      speed: 0.02
    },
    gamma: {
      focus: "STATE: Peak Concentrated Processing",
      type: "Hands-on Signal Processing Labs",
      desc: "Intensive coding and engineering wet-labs. Implementing active DSP filters, FFT computations in Python, and calibrating live EEG hardware.",
      freq: 0.38,
      amp: 8,
      noise: 3.0,
      speed: 0.14
    }
  };

  const tabs = document.querySelectorAll('.wave-tab');
  const focusEl = document.getElementById('wave-focus');
  const typeEl = document.getElementById('wave-event-type');
  const descEl = document.getElementById('wave-event-desc');
  const path = document.getElementById('telemetry-wave-path');

  let currentWave = 'alpha';
  let t = 0;

  // Math sine wave render loop
  const animateWave = () => {
    if (!path) return;
    const settings = waveData[currentWave as keyof typeof waveData];
    if (!settings) return;

    let d = `M 0 60`;
    for (let x = 0; x <= 500; x += 4) {
      // Sine wave calculation + custom noise factors
      const noise = (Math.sin(x * 0.1 + t * 2) * settings.noise * 2);
      const y = 60 + Math.sin(x * settings.freq - t) * settings.amp + noise;
      d += ` L ${x} ${y}`;
    }
    path.setAttribute('d', d);
    t += settings.speed;

    requestAnimationFrame(animateWave);
  };

  if (!prefersReducedMotion && path) {
    requestAnimationFrame(animateWave);
  } else if (path) {
    // Fallback static path for reduced motion
    path.setAttribute('d', 'M 0 60 C 125 10, 125 110, 250 60 C 375 10, 375 110, 500 60');
  }

  // Tab selections
  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const waveName = target.getAttribute('data-wave') || 'alpha';
      currentWave = waveName;

      // Update Active Classes
      tabs.forEach(t => {
        t.classList.replace('bg-gold-500', 'bg-white/5');
        t.classList.replace('text-slate-950', 'text-slate-300');
        t.classList.add('border', 'border-white/10');
        t.setAttribute('aria-selected', 'false');
      });

      target.classList.replace('bg-white/5', 'bg-gold-500');
      target.classList.replace('text-slate-300', 'text-slate-950');
      target.classList.remove('border', 'border-white/10');
      target.setAttribute('aria-selected', 'true');

      // Update Panel Text
      const d = waveData[waveName as keyof typeof waveData];
      if (d) {
        if (focusEl) focusEl.textContent = d.focus;
        if (typeEl) typeEl.textContent = d.type;
        if (descEl) descEl.textContent = d.desc;
      }
    });
  });

  // --- ACTION POTENTIAL TIMELINE ANIMATION ---
  const timelineSpine = document.getElementById('timeline-spine');
  const timelinePulse = document.getElementById('timeline-pulse');

  if (!prefersReducedMotion && timelineSpine && timelinePulse) {
    timelinePulse.classList.remove('hidden');
    let topVal = 0;
    const animSpinePulse = () => {
      topVal += 2;
      if (topVal > 100) {
        topVal = -15; // reset above top boundary
      }
      timelinePulse.style.top = `${topVal}%`;
      requestAnimationFrame(animSpinePulse);
    };
    requestAnimationFrame(animSpinePulse);
  }
</script>
