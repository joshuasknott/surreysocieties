---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'neurotech';
const client = createConvexClient();
const events: any[] = (await client.query("events:listPublished", { societySlug: SOCIETY_ID }))
  .filter((event: any) => event.status === 'published')
  .sort((a: any, b: any) => {
      // Sort upcoming events first, assuming format is YYYY-MM-DD
      if(!a.date && !b.date) return 0;
      if(!a.date) return 1;
      if(!b.date) return -1;
      return new Date(a.date).getTime() - new Date(b.date).getTime();
  });

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};
---

<Layout title="Events" description="Upcoming events, beginner-friendly BCI workshops, and guest lectures at Surrey Neurotech Society.">

  <!-- Header -->
  <section class="bg-slate-50 py-24 px-6 relative overflow-hidden text-center border-b border-slate-200">
    <div class="mx-auto max-w-4xl relative z-10">
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-slate-900 mb-6">Discover Our Events</h1>
      <p class="text-xl text-slate-600">Deep dives, beginner workshops, and engaging discussions.</p>
    </div>
  </section>

  <!-- Events List -->
  <section class="py-24 px-6 bg-white min-h-[50vh]">
    <div class="mx-auto max-w-5xl">
      {events.length === 0 ? (
        <div class="bg-slate-900 rounded-3xl p-12 sm:p-16 text-white shadow-2xl relative overflow-hidden text-center">
            <div class="absolute inset-0 bg-gradient-to-b from-gold-500/10 to-transparent"></div>
            <div class="relative z-10">
                <h2 class="text-4xl font-bold mb-12">What to Expect</h2>
                
                <div class="grid md:grid-cols-3 gap-8 text-left">
                    <div class="bg-white/5 border border-white/10 p-8 rounded-2xl backdrop-blur-md">
                        <h3 class="text-2xl font-bold text-gold-400 mb-4">Guest Lectures with Industry Leaders</h3>
                        <p class="text-slate-300 leading-relaxed">
                            Hear directly from researchers, engineers, and ethicists shaping the future of neurotechnology and cognitive science.
                        </p>
                    </div>
                    <div class="bg-white/5 border border-white/10 p-8 rounded-2xl backdrop-blur-md">
                        <h3 class="text-2xl font-bold text-blue-400 mb-4">Beginner-Friendly BCI Workshops</h3>
                        <p class="text-slate-300 leading-relaxed">
                            Hands-on sessions where we break down brain-computer interfaces. No prior coding or medical experience required.
                        </p>
                    </div>
                    <div class="bg-white/5 border border-white/10 p-8 rounded-2xl backdrop-blur-md">
                        <h3 class="text-2xl font-bold text-gold-400 mb-4">Ethics Panels & Discussions</h3>
                        <p class="text-slate-300 leading-relaxed">
                            Join the conversation on cognitive privacy, accessibility, and the societal implications of reading the mind.
                        </p>
                    </div>
                </div>
                
                <div class="mt-16">
                    <p class="text-lg text-slate-400 mb-6">We're finalizing our schedule for the semester. Stay tuned.</p>
                    <a href="/join" class="inline-flex items-center justify-center px-8 py-4 bg-gold-500 hover:bg-gold-600 text-white font-semibold rounded-xl transition-all shadow-lg text-lg">
                        Become a Member to Get Updates
                    </a>
                </div>
            </div>
        </div>
      ) : (
        <div class="relative pl-8 sm:pl-16">
          <!-- Continuous Timeline Line -->
          <div class="absolute left-0 top-12 bottom-12 w-0.5 bg-slate-200"></div>
          
          <div class="space-y-16">
            {events.map((event, index) => (
              <div class="relative group">
                <!-- Timeline Node -->
                <div class="absolute -left-8 sm:-left-16 top-10 w-4 h-4 rounded-full bg-gold-500 border-4 border-white shadow-[0_0_0_4px_rgba(6,182,212,0.1)] group-hover:scale-125 transition-transform duration-300 -translate-x-[7px]"></div>
                
                <div class="bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-sm hover:shadow-xl hover:border-amber-200 transition-all duration-300">
                  <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
                      <div>
                          <span class="inline-block px-4 py-1.5 bg-amber-50 text-gold-700 font-semibold rounded-full text-sm mb-4">
                              {event.category || 'Event'}
                          </span>
                          <h2 class="text-3xl font-bold text-slate-900 group-hover:text-gold-600 transition-colors">{event.title}</h2>
                      </div>
                      <div class="text-left md:text-right text-slate-500 font-medium whitespace-nowrap">
                          {formatEventDate(event.date)}
                      </div>
                  </div>
                  
                  <div class="prose prose-slate max-w-none mb-8 text-lg text-slate-600 leading-relaxed">
                      {event.description || 'Join us for this upcoming session. Full details will be announced soon.'}
                  </div>
                  
                  {(event.location || event.startTime) && (
                      <div class="flex flex-wrap gap-6 pt-6 border-t border-slate-100">
                          {event.startTime && (
                              <div class="flex items-center gap-2 text-slate-600 font-medium">
                                  <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                  {event.startTime} {event.endTime && `- ${event.endTime}`}
                              </div>
                          )}
                          {event.location && (
                              <div class="flex items-center gap-2 text-slate-600 font-medium">
                                  <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                  {event.location}
                              </div>
                          )}
                      </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

</Layout>


