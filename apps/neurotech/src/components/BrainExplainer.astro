---
---

<div class="flex flex-col lg:flex-row items-center gap-16 w-full" id="brain-explainer-container">
  <div class="flex-1 lg:pr-12">
    <h3 class="text-3xl font-bold text-slate-900 mb-6">Understand the Brain</h3>
    <p class="text-lg text-slate-600 mb-8 leading-relaxed">
      We explore how the brain functions, mapping thoughts and movements to neural pathways. Our interactive model reveals the complex architecture of human cognition.
    </p>
    
    <div id="brain-info-panel" class="min-h-[160px] bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-sm transition-all duration-300" aria-live="polite">
      <div id="default-info">
        <div class="inline-flex items-center gap-2 text-teal-600 font-medium mb-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
          Interactive Exploration
        </div>
        <p class="text-slate-600">Hover, tap, or focus the different brain regions to uncover their specialised functions and role in neurotechnology.</p>
      </div>
      
      <div id="region-info" class="hidden h-full flex flex-col justify-center">
        <h4 id="region-title" class="text-xl font-bold text-slate-900 mb-2 flex items-center gap-2">
          <span id="region-color-indicator" class="w-3 h-3 rounded-full bg-teal-500"></span>
          <span>Region Name</span>
        </h4>
        <p id="region-desc" class="text-slate-600 text-sm leading-relaxed"></p>
        <p id="region-bci" class="text-slate-700 text-sm font-medium mt-3 border-t border-slate-200 pt-3"></p>
      </div>
    </div>
  </div>
  
  <div class="flex-1 w-full relative">
    <div class="aspect-square sm:aspect-[4/3] rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl overflow-hidden relative flex items-center justify-center p-4 sm:p-8 brain-canvas-wrapper">
      
      <!-- Background Ambient Glow -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-teal-500/10 via-slate-900/50 to-slate-900 pointer-events-none mix-blend-screen"></div>
      
      <!-- The SVG Brain -->
      <svg class="w-full h-full max-w-[500px] overflow-visible drop-shadow-[0_0_15px_rgba(201,168,76,0.1)] transition-transform duration-700 hover:scale-[1.02]" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" id="interactive-brain">
        <defs>
          <linearGradient id="frontal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#2DD4BF" /> <!-- teal-400 -->
            <stop offset="100%" stop-color="#A8873B" /> <!-- teal-600 -->
          </linearGradient>
          <linearGradient id="parietal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#60A5FA" /> <!-- blue-400 -->
            <stop offset="100%" stop-color="#2563EB" /> <!-- blue-600 -->
          </linearGradient>
          <linearGradient id="occipital-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#A78BFA" /> <!-- violet-400 -->
            <stop offset="100%" stop-color="#7C3AED" /> <!-- violet-600 -->
          </linearGradient>
          <linearGradient id="temporal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#34D399" /> <!-- emerald-400 -->
            <stop offset="100%" stop-color="#059669" /> <!-- emerald-600 -->
          </linearGradient>
          <linearGradient id="cerebellum-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F87171" /> <!-- red-400 -->
            <stop offset="100%" stop-color="#DC2626" /> <!-- red-600 -->
          </linearGradient>
          <linearGradient id="stem-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#9CA3AF" /> <!-- gray-400 -->
            <stop offset="100%" stop-color="#4B5563" /> <!-- gray-600 -->
          </linearGradient>
          
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Neural pathways (Background lines) -->
        <g class="neural-pathways opacity-30" stroke="#E2E8F0" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-dasharray="4 6">
          <path class="anim-path" d="M 120 180 Q 180 150 250 160" />
          <path class="anim-path" d="M 100 120 Q 150 80 220 90" />
          <path class="anim-path" d="M 220 90 Q 280 120 320 180" />
          <path class="anim-path" d="M 180 200 Q 220 230 260 250" />
          <path class="anim-path" d="M 150 100 Q 190 140 230 150" />
        </g>
        
        <!-- Brain Regions -->
        <g id="brain-regions" class="transition-all duration-300 transform-origin-center">
          
          <!-- Brain Stem -->
          <path id="region-stem" class="brain-region transition-all duration-300 cursor-pointer stroke-slate-800 stroke-[2] hover:stroke-white z-10"
            d="M 230 220 Q 235 260 220 290 L 250 290 Q 260 260 255 220 Z"
            fill="url(#stem-grad)"
            data-title="Brainstem"
            data-color="bg-gray-500"
            data-desc="The foundational connector regulating basic life functions such as breathing, heart rate, and sleep cycles."
            data-bci="Crucial for understanding autonomic responses; rarely targeted directly by high-level cognitive BCIs."
          />

          <!-- Cerebellum -->
          <path id="region-cerebellum" class="brain-region transition-all duration-300 cursor-pointer stroke-slate-800 stroke-[2] hover:stroke-white z-20"
            d="M 250 190 Q 320 180 330 230 Q 330 260 280 260 Q 240 260 245 220 Z"
            fill="url(#cerebellum-grad)"
            data-title="Cerebellum"
            data-color="bg-red-500"
            data-desc="The 'little brain' at the back. It refines motor movements, ensuring precision, coordination, and accurate timing."
            data-bci="BCI motor decoding often utilizes cerebellar signals to smooth out erratic prosthetic movements."
          />

          <!-- Occipital Lobe -->
          <path id="region-occipital" class="brain-region transition-all duration-300 cursor-pointer stroke-slate-800 stroke-[2] hover:stroke-white z-30"
            d="M 270 90 Q 340 100 350 160 Q 355 190 320 190 Q 280 180 270 140 Z"
            fill="url(#occipital-grad)"
            data-title="Occipital Lobe"
            data-color="bg-violet-500"
            data-desc="The primary visual processing center. It interprets everything you see, mapping shapes, colors, and motion."
            data-bci="Targeted for visual neuroprosthetics that aim to restore sight by directly stimulating the cortex."
          />

          <!-- Temporal Lobe -->
          <path id="region-temporal" class="brain-region transition-all duration-300 cursor-pointer stroke-slate-800 stroke-[2] hover:stroke-white z-30"
            d="M 160 160 Q 180 140 230 140 Q 280 150 270 190 Q 240 220 190 200 Q 150 180 160 160 Z"
            fill="url(#temporal-grad)"
            data-title="Temporal Lobe"
            data-color="bg-emerald-500"
            data-desc="Essential for auditory processing, memory encoding, and language comprehension."
            data-bci="Advanced memory prosthetics and auditory interfaces tap into this region's neural networks."
          />

          <!-- Parietal Lobe -->
          <path id="region-parietal" class="brain-region transition-all duration-300 cursor-pointer stroke-slate-800 stroke-[2] hover:stroke-white z-30"
            d="M 180 40 Q 260 30 300 90 Q 260 130 220 140 Q 170 100 180 40 Z"
            fill="url(#parietal-grad)"
            data-title="Parietal Lobe"
            data-color="bg-blue-500"
            data-desc="Integrates sensory information, governing spatial sense, navigation, and the sensation of touch (somatosensation)."
            data-bci="Provides vital sensory feedback signals to closed-loop BCIs, allowing users to 'feel' artificial limbs."
          />

          <!-- Frontal Lobe -->
          <path id="region-frontal" class="brain-region transition-all duration-300 cursor-pointer stroke-slate-800 stroke-[2] hover:stroke-white z-40"
            d="M 180 40 Q 140 50 100 100 Q 80 150 120 180 Q 150 160 160 160 Q 180 140 220 140 Q 170 100 180 40 Z"
            fill="url(#frontal-grad)"
            data-title="Frontal Lobe"
            data-color="bg-teal-500"
            data-desc="The seat of executive function, reasoning, and voluntary motor control. Contains the critical Motor Cortex."
            data-bci="The primary target for motor BCIs. Decoding intentions here allows users to control cursors or robotic arms just by thinking."
          />
          
          <!-- Detailed Gyri lines over everything to give it texture -->
          <g class="pointer-events-none opacity-20" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round">
            <!-- Frontal -->
            <path d="M 120 80 Q 130 90 140 70" />
            <path d="M 110 120 Q 130 110 150 130" />
            <path d="M 130 160 Q 150 150 160 170" />
            <!-- Parietal -->
            <path d="M 210 60 Q 220 80 240 70" />
            <path d="M 230 100 Q 250 110 260 90" />
            <!-- Temporal -->
            <path d="M 180 170 Q 200 180 220 160" />
            <path d="M 190 190 Q 220 200 240 180" />
            <!-- Occipital -->
            <path d="M 290 130 Q 310 140 330 120" />
            <path d="M 280 160 Q 300 170 320 150" />
            <!-- Cerebellum (folds) -->
            <path d="M 260 210 Q 280 200 300 210" />
            <path d="M 270 230 Q 290 220 310 230" />
            <path d="M 260 250 Q 280 240 300 250" />
          </g>

        </g>
        
        <!-- Animated Synapses (Dots traveling) -->
        <g class="synapse-dots pointer-events-none mix-blend-screen" fill="#FAFAFA">
          <!-- Animated via JS -->
        </g>
      </svg>
      
    </div>
  </div>
</div>

<style>
  .brain-region {
    filter: drop-shadow(0px 4px 6px rgba(0, 0, 0, 0.4));
  }
  
  /* Dim other regions on hover */
  #brain-regions:hover .brain-region:not(:hover) {
    opacity: 0.3;
    filter: grayscale(80%) drop-shadow(0px 0px 0px rgba(0,0,0,0));
  }
  
  /* Make hovered region pop */
  .brain-region:hover {
    filter: url(#glow) drop-shadow(0px 10px 15px rgba(0, 0, 0, 0.5));
    transform: translateY(-2px) scale(1.01);
  }
  
  .anim-path {
    animation: dash 20s linear infinite;
  }
  
  @keyframes dash {
    to {
      stroke-dashoffset: -200;
    }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .anim-path {
      animation: none;
    }
    .brain-region:hover {
      transform: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  const regions = document.querySelectorAll('.brain-region');
  const defaultInfo = document.getElementById('default-info');
  const regionInfo = document.getElementById('region-info');
  
  const titleEl = document.getElementById('region-title');
  const colorEl = document.getElementById('region-color-indicator');
  const descEl = document.getElementById('region-desc');
  const bciEl = document.getElementById('region-bci');
  
  let selectedRegion: SVGElement | null = null;

  const showRegion = (target: SVGElement) => {
      const title = target.getAttribute('data-title');
      const colorClass = target.getAttribute('data-color');
      const desc = target.getAttribute('data-desc');
      const bci = target.getAttribute('data-bci');
      
      if (titleEl && title) titleEl.lastElementChild!.textContent = title;
      if (colorEl && colorClass) {
        colorEl.className = `w-3 h-3 rounded-full ${colorClass}`;
      }
      if (descEl && desc) descEl.textContent = desc;
      if (bciEl && bci) {
        bciEl.innerHTML = `<span class="text-slate-900 font-bold">Neurotech Application:</span> ${bci}`;
      }
      
      if (defaultInfo && regionInfo) {
        defaultInfo.classList.add('hidden');
        regionInfo.classList.remove('hidden');
      }
  };

  const resetRegion = () => {
      if (selectedRegion) return;
      if (defaultInfo && regionInfo) {
        defaultInfo.classList.remove('hidden');
        regionInfo.classList.add('hidden');
      }
  };

  regions.forEach(region => {
    const svgRegion = region as SVGElement;
    const title = svgRegion.getAttribute('data-title') || 'Brain region';
    svgRegion.setAttribute('tabindex', '0');
    svgRegion.setAttribute('role', 'button');
    svgRegion.setAttribute('aria-label', `Show ${title} information`);

    region.addEventListener('mouseenter', (e) => {
      showRegion(e.target as SVGElement);
    });

    region.addEventListener('focus', (e) => {
      showRegion(e.target as SVGElement);
    });

    region.addEventListener('click', (e) => {
      const target = e.target as SVGElement;
      selectedRegion = selectedRegion === target ? null : target;
      showRegion(target);
      regions.forEach((item) => item.removeAttribute('aria-pressed'));
      if (selectedRegion) selectedRegion.setAttribute('aria-pressed', 'true');
    });

    region.addEventListener('keydown', (e) => {
      const keyboardEvent = e as KeyboardEvent;
      if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
        keyboardEvent.preventDefault();
        (e.target as SVGElement).dispatchEvent(new MouseEvent('click', { bubbles: true }));
      }
      if (keyboardEvent.key === 'Escape') {
        selectedRegion = null;
        regions.forEach((item) => item.removeAttribute('aria-pressed'));
        resetRegion();
      }
    });

    region.addEventListener('mouseleave', () => {
      resetRegion();
    });

    region.addEventListener('blur', () => {
      resetRegion();
    });
  });

  // Synapse Animation
  if (!prefersReducedMotion) {
    const paths = document.querySelectorAll('.anim-path');
    const svgGroup = document.querySelector('.synapse-dots');
    
    if (paths.length > 0 && svgGroup) {
      // Create dots for each path
      paths.forEach((path, index) => {
        const svgPath = path as SVGPathElement;
        const length = svgPath.getTotalLength();
        
        // Add 2 dots per path, offset
        for (let i = 0; i < 2; i++) {
          const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
          dot.setAttribute("r", "2.5");
          dot.setAttribute("fill", i === 0 ? "#14B8A6" : "#FAFAFA"); // Teal and white
          dot.setAttribute("filter", "url(#glow)");
          svgGroup.appendChild(dot);
          
          let progress = (i * 0.5) + (index * 0.1);
          const speed = 0.002 + (Math.random() * 0.002);
          
          const animateDot = () => {
            progress += speed;
            if (progress > 1) progress = 0;
            
            const point = svgPath.getPointAtLength(progress * length);
            dot.setAttribute("cx", point.x.toString());
            dot.setAttribute("cy", point.y.toString());
            
            requestAnimationFrame(animateDot);
          };
          
          requestAnimationFrame(animateDot);
        }
      });
    }
  }
</script>

