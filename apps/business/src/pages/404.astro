---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Page not found" description="The page you are looking for does not exist on the Surrey Business Society website.">
  <section class="business-hero business-hero--page" aria-labelledby="not-found-title">
    <div class="business-shell business-hero__content">
      <p class="business-hero__eyebrow business-reveal">404</p>
      <h1 id="not-found-title" class="business-reveal">This page has moved on.</h1>
      <p class="business-hero__lede business-reveal">Head home, explore the events page, or find out how to join the society.</p>
      <div class="business-hero__actions business-reveal"><a href="/" class="business-button">Return home</a><a href="/events" class="business-button business-button--outline">View events</a></div>
    </div>
  </section>
</Layout>
