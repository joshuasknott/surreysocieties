---
return Astro.redirect('/#about', 302);
export const prerender = true;

import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/generated/business-about-campus-sketch-hero.optimized.webp';
import '../styles/global.css';

const society = getSocietyById('business')!;

const principles = [
  { title: 'Practical first', copy: 'Events and workshops should leave members with something they can use.' },
  { title: 'Open to every course', copy: 'Business is relevant whether you study management, engineering, science, arts, or anything else.' },
  { title: 'Connections that matter', copy: 'Networking works best when it leads to real conversations, advice, and opportunities.' },
];

const forStudents = [
  { title: 'Business students', copy: 'Connect your course with enterprise ideas, practical skills, and other interested students.' },
  { title: 'Non-business students', copy: 'Learn the commercial language that helps your discipline travel further.' },
  { title: 'Career explorers', copy: 'Use events and conversations to narrow down what you want to try next.' },
];
---

<Layout title="About" description="Surrey Business Society is a student-led University of Surrey society for entrepreneurship, networking, professional growth, and practical business skills.">
  <section class="business-hero business-hero--page business-hero--campus business-hero--about" aria-labelledby="about-title">
    <Image
      src={heroImage}
      alt=""
      aria-hidden="true"
      class="business-hero__image"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
    />
    <div class="business-shell business-hero__content">
      <p class="business-hero__eyebrow business-reveal">Surrey Business Society</p>
      <h1 id="about-title" class="business-reveal">A student-led business network at Surrey.</h1>
      <p class="business-hero__lede business-reveal">We help students build commercial confidence through events, workshops, networking, mentorship, and practical experience.</p>
    </div>
  </section>

  <section class="business-section business-section--paper" aria-labelledby="purpose-title">
    <div class="business-shell">
      <div class="business-intro business-reveal">
        <div>
          <p class="business-eyebrow">Our purpose</p>
          <h2 id="purpose-title" class="business-intro__lead">Make business clearer, more practical, and easier to enter.</h2>
        </div>
        <div class="business-intro__body business-copy">
          <p>Surrey Business Society gives students a place to explore business in practice, learn from confirmed guests and activities, and meet peers with similar interests.</p>
          <p>Our focus is simple: useful events, stronger networks, practical skills, and more confidence for the next step.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="business-section business-section--ink" aria-labelledby="principles-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal">
        <div>
          <p class="business-eyebrow">How we work</p>
          <h2 id="principles-title" class="business-title">Useful, open, and led by students.</h2>
        </div>
      </div>
      <div class="business-lines business-reveal">
        {principles.map((principle, index) => (
          <article class="business-line">
            <span class="business-line__number">0{index + 1}</span>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="business-section business-section--paper-light" aria-labelledby="students-title">
    <div class="business-shell business-feature-split business-reveal">
      <div>
        <p class="business-eyebrow">Who can join</p>
        <h2 id="students-title" class="business-title">Open to University of Surrey students from every degree.</h2>
        <p class="business-copy" style="margin-top: 1.25rem;">Join if you want to understand business, meet ambitious people, explore careers, build a venture, or grow your professional confidence.</p>
      </div>
      <ul class="business-list" role="list">
        {forStudents.map((student, index) => (
          <li><span>0{index + 1}</span><div><strong>{student.title}</strong><p>{student.copy}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="business-join-band" aria-labelledby="about-join-title">
    <div class="business-shell business-join-band__inner">
      <div>
        <h2 id="about-join-title">Join the society and get closer to business.</h2>
        <p>Membership is handled through Surrey Students' Union.</p>
      </div>
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society</a>
    </div>
  </section>
</Layout>
