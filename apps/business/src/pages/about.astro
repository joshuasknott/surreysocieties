---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="About" description="Learn about Surrey Business Society — our mission, values, and what members can expect from our student-led business community.">

  <section class="bg-navy-deep text-text-on-dark py-24 sm:py-32 px-6 relative border-b-4 border-gold overflow-hidden gsap-section">
    <!-- Geometric Background Shapes -->
    <div class="absolute top-[20%] right-[10%] w-96 h-96 rounded-full bg-gold/5 blur-3xl mix-blend-screen gsap-parallax-shape pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-72 h-72 rounded-full bg-blue-500/10 blur-[80px] mix-blend-screen gsap-parallax-shape pointer-events-none" data-speed="0.8"></div>

    <div class="absolute inset-0 bg-grid-pattern-dark opacity-50 pointer-events-none"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="inline-flex items-center gap-3 mb-6 gsap-fade-up">
        <span class="w-12 h-0.5 bg-gold"></span>
        <span class="text-gold text-xs font-bold uppercase tracking-widest backdrop-blur-sm bg-navy/30 px-2 py-1">About Us</span>
      </div>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-text-on-dark gsap-fade-up">About Surrey Business Society</h1>
      <p class="mt-8 text-xl text-text-on-dark-secondary max-w-2xl border-l-2 border-gold/50 pl-4 leading-relaxed gsap-fade-up">
        Ambitious students. Professional development. Real-world thinking.
      </p>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight mb-8 text-navy">Our Mission</h2>
          <div class="space-y-6 text-text-secondary leading-relaxed">
            <p>
              Surrey Business Society exists to support students in developing professionally and commercially. We provide a platform for networking, career exploration, entrepreneurship, and the exchange of ideas across industries.
            </p>
            <p>
              We're a student-led society under Surrey Students' Union, open to students from every course and year. You don't need to be studying business to benefit from what we do.
            </p>
            <p>
              Our events range from careers evenings and founder talks to networking socials and skills workshops. We aim to bridge the gap between university and the professional world.
            </p>
          </div>
        </div>
        <div class="bg-surface-card border border-border-light p-10 shadow-sm relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-1 h-full bg-gold"></div>
          <h3 class="font-bold text-xl uppercase tracking-wide mb-8 text-navy">What Members Can Expect</h3>
          <ul class="space-y-6">
            <li class="flex gap-4">
              <span class="text-gold font-black text-lg shrink-0 mt-0.5">→</span>
              <span class="text-text-secondary leading-relaxed">Professional networking opportunities with industry contacts</span>
            </li>
            <li class="flex gap-4">
              <span class="text-gold font-black text-lg shrink-0 mt-0.5">→</span>
              <span class="text-text-secondary leading-relaxed">Careers-focused events across consulting, finance, tech, and more</span>
            </li>
            <li class="flex gap-4">
              <span class="text-gold font-black text-lg shrink-0 mt-0.5">→</span>
              <span class="text-text-secondary leading-relaxed">Founder talks and entrepreneurship workshops</span>
            </li>
            <li class="flex gap-4">
              <span class="text-gold font-black text-lg shrink-0 mt-0.5">→</span>
              <span class="text-text-secondary leading-relaxed">Skills sessions covering CVs, interviews, and commercial awareness</span>
            </li>
            <li class="flex gap-4">
              <span class="text-gold font-black text-lg shrink-0 mt-0.5">→</span>
              <span class="text-text-secondary leading-relaxed">Social events and a community of ambitious students</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-alt py-24 sm:py-32 px-6 border-y border-border-light bg-grid-pattern">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12">
        <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-navy">Who Is This For?</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-px bg-border-light border border-border-light">
        <div class="bg-surface-card p-8 hover:bg-white transition-colors">
          <h3 class="font-bold text-lg uppercase tracking-wide mb-4 text-navy">Career-Focused Students</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Whether you're targeting graduate schemes, internships, or starting something of your own — we help you get there.</p>
        </div>
        <div class="bg-surface-card p-8 hover:bg-white transition-colors">
          <h3 class="font-bold text-lg uppercase tracking-wide mb-4 text-navy">Aspiring Entrepreneurs</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Curious about starting a business? Our founder talks and entrepreneurship events are designed for you.</p>
        </div>
        <div class="bg-surface-card p-8 hover:bg-white transition-colors">
          <h3 class="font-bold text-lg uppercase tracking-wide mb-4 text-navy">All Disciplines</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Business thinking is relevant everywhere. We welcome students from engineering, arts, sciences, and everything else.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="w-12 h-0.5 bg-gold"></span>
          <span class="text-gold text-xs font-bold uppercase tracking-widest">Our Principles</span>
        </div>
        <h2 class="text-4xl sm:text-5xl font-black uppercase tracking-tight text-navy">Core Values</h2>
      </div>
      
      <div class="grid sm:grid-cols-2 gap-8 lg:gap-12">
        <div class="flex gap-6 items-start">
          <div class="text-4xl font-black text-border-light shrink-0 leading-none">01</div>
          <div>
            <h3 class="font-bold text-xl uppercase tracking-wide mb-2 text-navy">Ambition</h3>
            <p class="text-text-secondary leading-relaxed">We encourage students to think big and take their development seriously.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="text-4xl font-black text-border-light shrink-0 leading-none">02</div>
          <div>
            <h3 class="font-bold text-xl uppercase tracking-wide mb-2 text-navy">Professionalism</h3>
            <p class="text-text-secondary leading-relaxed">Our events are run to a high standard, because first impressions matter.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="text-4xl font-black text-border-light shrink-0 leading-none">03</div>
          <div>
            <h3 class="font-bold text-xl uppercase tracking-wide mb-2 text-navy">Inclusivity</h3>
            <p class="text-text-secondary leading-relaxed">Every student is welcome, regardless of background, year, or subject.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <div class="text-4xl font-black text-border-light shrink-0 leading-none">04</div>
          <div>
            <h3 class="font-bold text-xl uppercase tracking-wide mb-2 text-navy">Practicality</h3>
            <p class="text-text-secondary leading-relaxed">We focus on real skills and real connections, not just theory.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof window.gsap !== 'undefined' && typeof window.ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);

        gsap.utils.toArray('.gsap-fade-up').forEach((elem: any) => {
          gsap.fromTo(elem, 
            { y: 40, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 1,
              ease: "power3.out",
              scrollTrigger: {
                trigger: elem,
                start: "top 85%",
                toggleActions: "play none none reverse"
              }
            }
          );
        });

        gsap.utils.toArray('.gsap-parallax-shape').forEach((shape: any) => {
          const speed = shape.getAttribute('data-speed') || 0.5;
          gsap.to(shape, {
            y: () => (ScrollTrigger.maxScroll(window) - (ScrollTrigger.maxScroll(window) * speed)),
            ease: "none",
            scrollTrigger: {
              trigger: shape.closest('.gsap-section') || document.body,
              start: "top bottom",
              end: "bottom top",
              scrub: 1
            }
          });
        });
      }
    });
  </script>
</Layout>
