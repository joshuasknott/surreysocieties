---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout
  title="About"
  description="Learn about Surrey Business Society — our mission, values, and what members can expect from our student-led business community."
>

  <!-- ── Page header ── -->
  <section class="bg-navy-deep text-text-on-dark pt-24 pb-20 sm:pt-32 sm:pb-24 px-6 border-b border-border-dark relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <p class="eyebrow mb-6 reveal">About Us</p>
      <h1 class="font-serif text-5xl sm:text-6xl font-bold tracking-tight leading-tight reveal">
        Surrey Business Society
      </h1>
      <p class="mt-6 text-base text-text-on-dark-secondary max-w-xl border-l border-gold/40 pl-4 leading-relaxed reveal">
        A student-led professional community at the University of Surrey. Open to students from every course and year.
      </p>
    </div>
  </section>

  <!-- ── Mission + Member benefits ── -->
  <section class="py-20 sm:py-28 px-6 border-b border-border">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <!-- Mission -->
        <div class="reveal">
          <p class="eyebrow mb-5">Mission</p>
          <h2 class="font-serif text-3xl font-bold tracking-tight text-text-primary mb-8">Our purpose</h2>
          <div class="space-y-5 text-text-secondary leading-relaxed text-sm">
            <p>
              Surrey Business Society exists to support students in developing professionally and commercially. We provide a platform for networking, career exploration, entrepreneurship, and the exchange of ideas across industries.
            </p>
            <p>
              We are a student-led society under Surrey Students' Union, open to students from every course and year. You do not need to be studying business to benefit from what we do.
            </p>
            <p>
              Our events range from careers evenings and founder talks to networking socials and skills workshops. We aim to bridge the gap between university life and the professional world.
            </p>
          </div>
        </div>

        <!-- What to expect -->
        <div class="reveal">
          <p class="eyebrow mb-5">Membership</p>
          <h2 class="font-serif text-3xl font-bold tracking-tight text-text-primary mb-8">What to expect</h2>
          <ul class="divide-y divide-border" role="list">
            {[
              'Professional networking opportunities with industry contacts',
              'Careers-focused events across consulting, finance, tech, and more',
              'Founder talks and entrepreneurship workshops',
              'Skills sessions covering CVs, interviews, and commercial awareness',
              'Social events and a community of ambitious, like-minded students',
            ].map(item => (
              <li class="flex gap-4 py-4" role="listitem">
                <span class="text-gold font-bold text-sm shrink-0 mt-0.5" aria-hidden="true">→</span>
                <span class="text-text-secondary text-sm leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Who is this for ── -->
  <section class="py-20 sm:py-28 px-6 bg-surface-alt border-b border-border">
    <div class="mx-auto max-w-6xl">
      <header class="mb-12 reveal">
        <p class="eyebrow mb-4">Audience</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">Who is the society for?</h2>
      </header>
      <div class="grid sm:grid-cols-3 gap-px bg-border border border-border">
        {[
          {
            title: 'Career-Focused Students',
            body: 'Whether you are targeting graduate schemes, internships, or starting something of your own — we help you get there.',
          },
          {
            title: 'Aspiring Entrepreneurs',
            body: 'Curious about starting a business? Our founder talks and entrepreneurship events are designed for you.',
          },
          {
            title: 'All Disciplines',
            body: 'Business thinking is relevant everywhere. We welcome students from engineering, arts, sciences, and everything else.',
          },
        ].map(card => (
          <div class="bg-surface-card p-8 hover:bg-white transition-colors reveal">
            <h3 class="text-sm font-bold uppercase tracking-widest text-text-primary mb-3">{card.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Core values ── -->
  <section class="py-20 sm:py-28 px-6 bg-surface border-b border-border">
    <div class="mx-auto max-w-6xl">
      <header class="mb-14 reveal">
        <p class="eyebrow mb-4">Values</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">Core principles</h2>
      </header>
      <div class="grid sm:grid-cols-2 gap-12 lg:gap-16 reveal">
        {[
          { num: '01', title: 'Ambition', body: 'We encourage students to think big and take their development seriously.' },
          { num: '02', title: 'Professionalism', body: 'Our events are run to a high standard, because first impressions matter.' },
          { num: '03', title: 'Inclusivity', body: 'Every student is welcome, regardless of background, year, or subject.' },
          { num: '04', title: 'Practicality', body: 'We focus on real skills and real connections, not just theory.' },
        ].map(v => (
          <div class="flex gap-8 items-start">
            <span class="text-3xl font-black text-border shrink-0 leading-none">{v.num}</span>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-widest text-text-primary mb-2">{v.title}</h3>
              <p class="text-sm text-text-secondary leading-relaxed">{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="bg-navy-deep text-text-on-dark py-20 px-6 border-t-2 border-gold relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-50" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl text-center relative z-10 reveal">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight mb-6">Ready to join?</h2>
      <p class="text-text-on-dark-secondary text-sm mb-8 max-w-lg mx-auto leading-relaxed">
        Membership is open to every University of Surrey student through Surrey Students' Union.
      </p>
      <a href="/join" class="btn-primary">
        Join the Society <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</Layout>
