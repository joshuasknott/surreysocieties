---
export const prerender = true;

import { getSocietyById } from '@surreysocieties/admin/config';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import collaboration from '../assets/generated/business-about-collaboration.png';
import '../styles/global.css';

const society = getSocietyById('business')!;

const principles = [
  { title: 'Curiosity first', copy: 'You can arrive with questions, not a finished career plan.' },
  { title: 'Practical confidence', copy: 'The useful work is in trying, asking, presenting, and improving.' },
  { title: 'Open networks', copy: 'Good connections should feel possible, not exclusive.' },
];

const forStudents = [
  { title: 'Business students', copy: 'Connect your course with people, opportunities, and practical experience.' },
  { title: 'Non-business students', copy: 'Learn the commercial language that helps your discipline travel further.' },
  { title: 'Career explorers', copy: 'Build a clearer sense of the paths, skills, and conversations worth pursuing.' },
];
---

<Layout title="About" description="Surrey Business Society helps University of Surrey students build commercial confidence, explore enterprise, and form useful connections.">
  <section class="business-hero business-hero--page" aria-labelledby="about-title">
    <Image src={collaboration} alt="" class="business-hero__image" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" decoding="async" fetchpriority="high" format="webp" quality={70} />
    <div class="business-shell business-hero__content">
      <p class="business-hero__eyebrow business-reveal">About the society</p>
      <h1 id="about-title" class="business-reveal">Business confidence, without the performance.</h1>
      <p class="business-hero__lede business-reveal">We make careers, enterprise, and commercial thinking more approachable for students who want a clearer way in.</p>
    </div>
  </section>

  <section class="business-section business-section--paper" aria-labelledby="purpose-title">
    <div class="business-shell">
      <div class="business-intro business-reveal">
        <div>
          <p class="business-eyebrow">What we are here for</p>
          <h2 id="purpose-title" class="business-intro__lead">A society for students becoming more commercially confident.</h2>
        </div>
        <div class="business-intro__body business-copy">
          <p>Business can feel like a private language: careers, networking, interviews, enterprise, commercial awareness. We exist to make that language easier to learn and use.</p>
          <p>Our focus is simple: give Surrey students more context, more practice, and more people to learn alongside.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="business-section business-section--ink" aria-labelledby="principles-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal">
        <div>
          <p class="business-eyebrow">How we work</p>
          <h2 id="principles-title" class="business-title">Keep it useful. Keep it open.</h2>
        </div>
      </div>
      <div class="business-lines business-reveal">
        {principles.map((principle, index) => (
          <article class="business-line">
            <span class="business-line__number">0{index + 1}</span>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="business-section business-section--paper-light" aria-labelledby="students-title">
    <div class="business-shell business-feature-split business-reveal">
      <div>
        <p class="business-eyebrow">Who it is for</p>
        <h2 id="students-title" class="business-title">Any Surrey student with an idea of where they could go next.</h2>
        <p class="business-copy" style="margin-top: 1.25rem;">You do not have to fit a particular mould to belong here. The point is to learn, contribute, and make your own direction stronger.</p>
      </div>
      <ul class="business-list" role="list">
        {forStudents.map((student, index) => (
          <li><span>0{index + 1}</span><div><strong>{student.title}</strong><p>{student.copy}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="business-join-band" aria-labelledby="about-join-title">
    <div class="business-shell business-join-band__inner">
      <div>
        <h2 id="about-join-title">Bring the questions. We will make room for them.</h2>
        <p>Membership is handled through Surrey Students' Union.</p>
      </div>
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society</a>
    </div>
  </section>
</Layout>
