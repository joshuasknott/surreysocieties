---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { queryPublicConvex } from '@surreysocieties/admin';
import '../styles/global.css';

import { getSocietyById } from '@surreysocieties/admin/config';

const SOCIETY_ID = 'business';
const society = getSocietyById(SOCIETY_ID)!;
const committee: any[] = (await queryPublicConvex<any[]>('committee:listActive', { societySlug: SOCIETY_ID }, []))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );
const pastCommittee: any[] = (await queryPublicConvex<any[]>('committee:listPast', { societySlug: SOCIETY_ID }, []))
  .sort((a: any, b: any) =>
    (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
  );
const pastCommitteeYears = [...new Set(pastCommittee.map(member => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout
  title="Society Leadership"
  description="Meet the student committee running Surrey Business Society - the team behind our careers events, networking, and community."
>

  <!-- Section 1: Hero -->
  <section class="bg-navy-deep text-text-on-dark pt-32 pb-24 sm:pt-40 sm:pb-32 px-6 border-b border-border-dark relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gold/30" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl relative z-10 text-center">
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-tight">
        Society Leadership
      </h1>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-surface">
    <div class="mx-auto max-w-6xl">

      {committee.length === 0 ? (
        <!-- Section 3: The Structure (Empty State) -->
        <article class="prose prose-lg max-w-3xl mx-auto text-text-secondary leading-relaxed reveal">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-text-primary mb-6">Society Governance</h2>
          <p class="mb-6">
            The Surrey Business Society is governed by a dedicated team of student leaders, committed to delivering high-quality professional development opportunities and fostering a robust interdisciplinary network.
          </p>
          <p class="mb-6">
            The core committee typically consists of a President, Vice President, Treasurer, and specialised officers overseeing areas such as Corporate Relations, Marketing, and Events. These roles are critical in bridging the gap between our student members and industry partners.
          </p>
          <p class="mb-6">
            Leadership positions are elected annually through a democratic process overseen by the University of Surrey Students' Union. This ensures our society remains entirely student-led and accountable to its members.
          </p>
          <p>
            If you are interested in running for future positions, or if you have governance inquiries in the interim, please reach out to us via our <a href="mailto:ussu.bizsoc@surrey.ac.uk" class="text-gold-dark hover:underline font-semibold">official email</a>.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/join" class="btn-primary">Become a member <span aria-hidden="true">&rarr;</span></a>
            <a href="https://www.instagram.com/surreybusinesssociety/" target="_blank" rel="noopener noreferrer" class="btn-ghost">Instagram</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">Students' Union</a>
          </div>
        </article>
      ) : (
        <!-- Section 2: The Roster (Populated State) -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-16 reveal">
          {committee.map((member) => (
            <div class="flex flex-col group transition-transform duration-300 hover:-translate-y-2">
              {member.imageUrl ? (
                <div class="w-full aspect-[4/5] bg-surface-alt mb-6 overflow-hidden">
                  <img
                    src={member.imageUrl}
                    alt={member.name || member.role}
                    class="w-full h-full object-cover grayscale mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              ) : (
                <div class="w-full aspect-[4/5] bg-navy-deep flex items-center justify-center text-gold font-serif text-4xl mb-6">
                  {getInitials(member.name, member.role)}
                </div>
              )}
              <h3 class="font-serif text-xl font-bold text-text-primary mb-1">{member.name}</h3>
              <p class="text-xs font-bold uppercase tracking-widest text-text-muted">{member.role}</p>
            </div>
          ))}
        </div>
      )}

      <!-- Past committee archive -->
      {pastCommittee.length > 0 && (
        <div class="mt-32 pt-24 border-t border-border">
          <header class="mb-16 reveal text-center">
            <h2 class="font-serif text-3xl font-bold text-text-primary">Alumni Leadership</h2>
            <p class="mt-4 text-base text-text-secondary max-w-xl mx-auto leading-relaxed">
              A record of the individuals who have previously directed the Surrey Business Society.
            </p>
          </header>

          <div class="space-y-16 max-w-4xl mx-auto">
            {pastCommitteeYears.map(yearLabel => (
              <section class="reveal">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gold border-b border-border pb-4 mb-8 text-center">{yearLabel}</h3>
                <ol class="grid grid-cols-2 sm:grid-cols-3 gap-y-8 gap-x-6" role="list">
                  {pastCommittee.filter(m => m.yearLabel === yearLabel).map((member) => (
                    <li class="flex flex-col items-center text-center" role="listitem">
                      <span class="font-serif text-lg font-bold text-text-primary mb-1">{member.name}</span>
                      <span class="text-[10px] font-bold uppercase tracking-widest text-text-muted">{member.role}</span>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
