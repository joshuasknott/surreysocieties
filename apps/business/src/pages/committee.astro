---
return Astro.redirect('/#join', 302);
export const prerender = false;

import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/generated/business-committee-campus-sketch-hero.optimized.webp';
import '../styles/global.css';

const society = getSocietyById('business')!;
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");
const [committeeResult, pastCommitteeResult] = await Promise.all([
  queryPublicConvex(api.committee.listActive, { societySlug: 'business' }, []),
  queryPublicConvex(api.committee.listPast, { societySlug: 'business' }, []),
]);
const committee: any[] = committeeResult
  .sort((a: any, b: any) => (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) || (a.name || '').localeCompare(b.name || ''));
const pastCommittee: any[] = pastCommitteeResult
  .sort((a: any, b: any) => (b.yearLabel || '').localeCompare(a.yearLabel || '') || (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER));
const pastYears = [...new Set(pastCommittee.map((member) => member.yearLabel || 'Previous committee'))];

const initials = (name?: string, role?: string) => {
  const words = (name || role || '?').trim().split(/\s+/).filter(Boolean);
  return words.length > 1 ? words.slice(0, 2).map((word) => word[0]).join('').toUpperCase() : (words[0] || '?').slice(0, 2).toUpperCase();
};

const leadershipWork = [
  { title: 'Plan the programme', copy: 'Choose talks, workshops, networking, and enterprise activity that members will value.' },
  { title: 'Build useful relationships', copy: 'Coordinate confirmed guests, campus teams, and opportunities that support members.' },
  { title: 'Represent members', copy: 'Keep the society useful, welcoming, and open to students from every course.' },
];
---

<Layout title="Committee" description="Meet the Surrey Business Society committee and see confirmed student leadership information.">
  <section class="business-hero business-hero--page business-hero--campus business-hero--committee" aria-labelledby="committee-title">
    <Image
      src={heroImage}
      alt=""
      aria-hidden="true"
      class="business-hero__image"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
    />
    <div class="business-shell business-hero__content">
      <p class="business-hero__eyebrow business-reveal">Committee</p>
      <h1 id="committee-title" class="business-reveal">Meet the students leading the society.</h1>
      <p class="business-hero__lede business-reveal">The committee organises confirmed activity, supports members, and keeps Surrey Business Society moving.</p>
      <div class="business-hero__actions business-reveal">
        <a href={`mailto:${society.contactEmail}`} class="business-button">Contact the society</a>
        <a href="/join" class="business-button business-button--outline">Become a member</a>
      </div>
    </div>
  </section>

  <section class="business-section business-section--paper" aria-labelledby="current-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal">
        <div><p class="business-eyebrow">Current committee</p><h2 id="current-title" class="business-title">The team behind the society.</h2></div>
        <p>Names, roles, and contact details are shown once committee members confirm them for public sharing.</p>
      </div>
      {committee.length ? (
        <div class="business-people-grid business-reveal">
          {committee.map((member) => (
            <article class="business-person">
              {member.imageUrl ? <img src={member.imageUrl} alt={member.name || member.role || 'Committee member'} class="business-person__portrait" /> : <div class="business-person__initials" aria-hidden="true">{initials(member.name, member.role)}</div>}
              <h3>{member.name || member.role}</h3>
              {member.role && <p class="business-person__role">{member.role}</p>}
              {member.bio && <p class="business-person__bio">{member.bio}</p>}
              {(member.email || member.linkedIn) && <div class="business-person__links">{member.email && <a href={`mailto:${member.email}`}>Email</a>}{member.linkedIn && <a href={member.linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn</a>}</div>}
            </article>
          ))}
        </div>
      ) : (
        <div class="business-empty business-reveal"><h3>Committee details will appear here once added.</h3><div><p>The society is student-led. Names and roles will appear once the committee adds them.</p><a href={`mailto:${society.contactEmail}`} class="business-text-link" style="display: inline-block; margin-top: 1rem;">Email the society</a></div></div>
      )}
    </div>
  </section>

  <section class="business-section business-section--ink" aria-labelledby="leadership-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal"><div><p class="business-eyebrow">Leadership</p><h2 id="leadership-title" class="business-title">What the committee does.</h2></div></div>
      <div class="business-lines business-reveal">
        {leadershipWork.map((item, index) => <article class="business-line"><span class="business-line__number">0{index + 1}</span><h3>{item.title}</h3><p>{item.copy}</p></article>)}
      </div>
    </div>
  </section>

  <section class="business-section business-section--paper-light" aria-labelledby="archive-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal"><div><p class="business-eyebrow">Past teams</p><h2 id="archive-title" class="business-title">Past committees.</h2></div><p>A simple record of the students who have helped lead the society.</p></div>
      {pastCommittee.length ? (
        <div class="business-archive business-reveal">
          {pastYears.map((year) => (
            <section class="business-archive__year"><h3>{year}</h3><div class="business-archive__names">{pastCommittee.filter((member) => (member.yearLabel || 'Previous committee') === year).map((member) => <div><strong>{member.name}</strong><span>{member.role}</span></div>)}</div></section>
          ))}
        </div>
      ) : <div class="business-empty business-reveal"><h3>Past committee records will appear once added.</h3><p>Historical committee details will appear here once committee members add them.</p></div>}
    </div>
  </section>

  <section class="business-join-band" aria-labelledby="committee-join-title">
    <div class="business-shell business-join-band__inner"><div><h2 id="committee-join-title">Want to get involved?</h2><p>Join the society, meet the team, and help shape what happens next.</p></div><a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society</a></div>
  </section>
</Layout>
