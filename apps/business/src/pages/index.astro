---
export const prerender = false;

import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import homeDirection from '../assets/generated/business-home-direction.png';
import eventsProgramme from '../assets/generated/business-events-programme.png';
import '../styles/global.css';

const society = getSocietyById('business')!;
const [eventsResult, committeeResult] = await Promise.all([
  queryPublicConvex(api.events.listPublished, { societySlug: 'business' }, []),
  queryPublicConvex(api.committee.listActive, { societySlug: 'business' }, []),
]);
const events: any[] = eventsResult
  .filter((event: any) => event.status === 'published');
const committee: any[] = committeeResult
  .sort((a: any, b: any) => (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER));

const formatEventDate = (date?: string) => {
  if (!date) return 'Date to be confirmed';
  const parsed = new Date(`${date}T00:00:00`);
  return Number.isNaN(parsed.getTime()) ? date : parsed.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};

const launchMessage = 'New website launching this September';

const reasonsToJoin = [
  { title: 'Find your direction', copy: 'Make careers, industries, and next steps feel less abstract.' },
  { title: 'Build confidence', copy: 'Practise the skills that help ideas travel: speaking, presenting, interviewing, and leading.' },
  { title: 'Meet good people', copy: 'Connect with students who are curious about business, enterprise, and what comes next.' },
];

const focusAreas = [
  { title: 'Careers', copy: 'Better context for applications, workplaces, and commercial roles.' },
  { title: 'Enterprise', copy: 'A place to test ideas, learn from others, and start building.' },
  { title: 'Networking', copy: 'More natural routes into conversations, peers, and professional communities.' },
  { title: 'Skills', copy: 'Useful practice in communication, strategy, collaboration, and leadership.' },
];
---

<Layout title="Home" description="Surrey Business Society brings together University of Surrey students interested in careers, enterprise, networking, and practical business skills.">
  <section class="business-hero business-hero--home" aria-labelledby="business-hero-title">
    <Image src={homeDirection} alt="" class="business-hero__image" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" decoding="async" fetchpriority="high" format="webp" quality={70} />
    <div class="business-shell business-hero__content">
      <p class="business-hero__eyebrow business-reveal">{launchMessage}</p>
      <h1 id="business-hero-title" class="business-reveal">Make business feel less abstract.</h1>
      <p class="business-hero__lede business-reveal">Welcome to the new Surrey Business Society website: a student-friendly home for career direction, enterprise, networking, confidence, and useful conversations.</p>
      <p class="business-launch-note business-reveal">Launching in September with events, resources, committee updates, and simple ways to join.</p>
      <div class="business-hero__actions business-reveal">
        <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society</a>
        <a href="/events" class="business-button business-button--outline">Launch updates</a>
      </div>
    </div>
  </section>

  <section class="business-fact-row" aria-label="Society at a glance">
    <div class="business-fact-row__inner">
      <div class="business-fact"><strong>September</strong><span>Website launch</span></div>
      <div class="business-fact"><strong>All courses</strong><span>Welcome here</span></div>
      <div class="business-fact"><strong>Student-led</strong><span>Built with members</span></div>
    </div>
  </section>

  <section class="business-section business-section--paper" aria-labelledby="why-title">
    <div class="business-shell">
      <div class="business-intro business-reveal">
        <div>
          <p class="business-eyebrow">Why join</p>
          <h2 id="why-title" class="business-intro__lead">A useful place to start, whatever your course.</h2>
        </div>
        <div class="business-intro__body business-copy">
          <p>You do not need a business degree, a polished plan, or a perfect pitch. The new site is being shaped for students who want business to feel clearer, more practical, and easier to enter.</p>
          <p>From September, it will bring together the people, events, resources, and committee updates that help students move forward with more clarity.</p>
        </div>
      </div>
      <div class="business-lines business-reveal" style="margin-top: clamp(3rem, 7vw, 6rem);">
        {reasonsToJoin.map((reason, index) => (
          <article class="business-line">
            <span class="business-line__number">0{index + 1}</span>
            <h3>{reason.title}</h3>
            <p>{reason.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="business-section business-section--ink" aria-labelledby="focus-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal">
        <div>
          <p class="business-eyebrow">What we focus on</p>
          <h2 id="focus-title" class="business-title">Four ways to build momentum.</h2>
        </div>
        <p>One society, four practical routes into a more confident future.</p>
      </div>
      <div class="business-lines business-lines--four business-reveal">
        {focusAreas.map((area, index) => (
          <article class="business-line">
            <span class="business-line__number">0{index + 1}</span>
            <h3>{area.title}</h3>
            <p>{area.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="business-section business-section--paper-light" aria-label="Society updates">
    <div class="business-shell business-updates business-reveal">
      <section class="business-update" aria-labelledby="events-title">
        <div class="business-update__top"><h3 id="events-title">Launch updates</h3><a href="/events" class="business-text-link">Events page</a></div>
        {events.length ? (
          events.slice(0, 2).map((event) => (
            <article class="business-event">
              <time>{formatEventDate(event.date)}</time>
              <h4>{event.title}</h4>
              {event.location && <p>{event.location}</p>}
            </article>
          ))
        ) : <p class="business-update__empty">The September launch programme is being prepared. Confirmed events and useful conversations will appear here as soon as they are ready.</p>}
      </section>
      <section class="business-update" aria-labelledby="committee-title">
        <div class="business-update__top"><h3 id="committee-title">The committee</h3><a href="/committee" class="business-text-link">Meet the team</a></div>
        {committee.length ? (
          committee.slice(0, 2).map((member) => (
            <article class="business-event">
              <time>{member.role || 'Committee member'}</time>
              <h4>{member.name}</h4>
            </article>
          ))
        ) : <p class="business-update__empty">The student team will be introduced here as the new website gets ready for September.</p>}
      </section>
    </div>
  </section>

  <section class="business-image-break" aria-labelledby="practical-title">
    <Image src={eventsProgramme} alt="" class="business-image-break__image" widths={[640, 960, 1440]} sizes="100vw" loading="lazy" decoding="async" format="webp" quality={70} />
    <div class="business-shell business-image-break__inner business-reveal">
      <p class="business-eyebrow">Built for practice</p>
      <h2 id="practical-title" class="business-quote">Better conversations. Stronger next steps.</h2>
      <p>The new website will make the society easier to understand, easier to join, and easier to use once launch activity begins.</p>
    </div>
  </section>

  <section class="business-join-band" aria-labelledby="join-title">
    <div class="business-shell business-join-band__inner">
      <div>
        <h2 id="join-title">Start where you are.</h2>
        <p>Join Surrey Business Society and be ready for the new website launch in September.</p>
      </div>
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society</a>
    </div>
  </section>
</Layout>
