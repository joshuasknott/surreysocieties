---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'business';
const client = createConvexClient();

// Keep events for preview, but design spec says to remove grid cards entirely.
// Spec says: Home: clearer value proposition, careers/enterprise/networking/skills, stronger page flow, fewer boxed grids.
---

<Layout
  title="Home"
  description="Surrey Business Society - The premier professional network for ambitious students at the University of Surrey."
>

  <!-- Section 1: Hero (Asymmetric split) -->
  <section class="bg-navy-deep text-text-on-dark relative overflow-hidden border-b border-border-dark pt-28 pb-24 sm:pt-40 sm:pb-32">
    <!-- Subtle dot grid -->
    <div class="bg-dot-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gold/30" aria-hidden="true"></div>

    <div class="mx-auto max-w-6xl px-6 relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <div class="lg:col-span-7 xl:col-span-8">
          <p class="eyebrow mb-6 reveal" style="color:var(--color-gold)">University of Surrey</p>
          <h1 class="font-serif text-5xl sm:text-6xl lg:text-[5rem] font-bold tracking-tight leading-[1.05] reveal">
            Commercial Awareness.<br />
            <em class="text-gold not-italic">Professional Confidence.</em>
          </h1>
          <p class="mt-8 text-base sm:text-lg text-text-on-dark-secondary leading-relaxed max-w-xl border-l border-gold/40 pl-5 reveal">
            The premier network for ambitious students at the University of Surrey. We bridge the gap between academic study and the corporate world.
          </p>
          <div class="mt-12 flex flex-col sm:flex-row gap-4 reveal">
            <a href="/join" class="btn-primary rounded-none">
              Become a Member <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="hidden lg:flex lg:col-span-5 xl:col-span-4 justify-end items-center reveal opacity-80" aria-hidden="true">
          <!-- Stark geometric graphic / logo abstraction -->
          <div class="relative w-64 h-64 border border-gold/20 flex items-center justify-center">
            <div class="absolute inset-4 border border-gold/40"></div>
            <div class="absolute inset-8 border border-gold/60"></div>
            <div class="w-16 h-16 bg-gold/10 backdrop-blur-sm border border-gold flex items-center justify-center">
               <img src="/logos/sbs-logo.png" alt="" class="w-10 h-10 opacity-90" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: The Value Proposition (Editorial Ledger) -->
  <section class="py-24 sm:py-32 px-6 bg-surface">
    <div class="mx-auto max-w-5xl">
      <header class="mb-20 reveal">
        <h2 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-text-primary mb-6">
          Strategic Pillars
        </h2>
        <p class="text-lg text-text-secondary max-w-2xl leading-relaxed">
          Our society is structured around three core pillars designed to equip you with the tangible skills and connections required in today's competitive landscape.
        </p>
      </header>

      <div class="flex flex-col border-t border-border reveal">
        <!-- 01 -->
        <div class="flex flex-col md:flex-row gap-6 md:gap-16 py-12 md:py-16 border-b border-border">
          <div class="shrink-0 md:w-32">
            <span class="text-5xl md:text-6xl font-bold text-border-dark/20 tracking-tighter block leading-none">01</span>
          </div>
          <div class="flex-1">
            <h3 class="font-serif text-2xl md:text-3xl font-bold text-text-primary mb-4">Careers & Enterprise</h3>
            <p class="text-base md:text-lg text-text-secondary leading-loose max-w-3xl">
              We focus heavily on bridging academia and industry. Through graduate roles, internships insights, and founder-led discussions, we provide clear pathways for students exploring corporate pathways, entrepreneurship, ideation, and early-stage ventures.
            </p>
          </div>
        </div>
        
        <!-- 02 -->
        <div class="flex flex-col md:flex-row gap-6 md:gap-16 py-12 md:py-16 border-b border-border">
          <div class="shrink-0 md:w-32">
            <span class="text-5xl md:text-6xl font-bold text-border-dark/20 tracking-tighter block leading-none">02</span>
          </div>
          <div class="flex-1">
            <h3 class="font-serif text-2xl md:text-3xl font-bold text-text-primary mb-4">Professional Networking</h3>
            <p class="text-base md:text-lg text-text-secondary leading-loose max-w-3xl">
              Access an exclusive network of alumni and corporate partners. We facilitate structured and informal environments that build meaningful connections with ambitious students across disciplines and seasoned professionals from varied sectors.
            </p>
          </div>
        </div>

        <!-- 03 -->
        <div class="flex flex-col md:flex-row gap-6 md:gap-16 py-12 md:py-16 border-b border-border">
          <div class="shrink-0 md:w-32">
            <span class="text-5xl md:text-6xl font-bold text-border-dark/20 tracking-tighter block leading-none">03</span>
          </div>
          <div class="flex-1">
            <h3 class="font-serif text-2xl md:text-3xl font-bold text-text-primary mb-4">Skills Development</h3>
            <p class="text-base md:text-lg text-text-secondary leading-loose max-w-3xl">
              Knowledge is theory until applied. We run practical workshops covering commercial awareness, effective presentation, negotiation tactics, and rigorous interview preparation, ensuring you possess the practical toolkit to succeed.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Call to Action Band -->
  <section class="bg-navy-deep text-text-on-dark py-24 px-6 relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-50" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl relative z-10 text-center reveal">
      <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-10 leading-snug">
        Take the next step in your professional journey.
      </h2>
      <a href="/join" class="btn-primary rounded-none">
        Become a Member <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</Layout>