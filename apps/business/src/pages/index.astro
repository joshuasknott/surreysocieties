---
export const prerender = false;

import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import BusinessCommittee from '../components/BusinessCommittee.astro';
import BusinessEditorial from '../components/BusinessEditorial.astro';
import BusinessJoin from '../components/BusinessJoin.astro';
import BusinessFooter from '../components/BusinessFooter.astro';
import heroImage from '../assets/generated/business-editorial-hero.webp';
import '../styles/global.css';
import '../styles/editorial-home.css';

const society = getSocietyById('business')!;
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");
const committee = await queryPublicConvex(api.committee.listActive, { societySlug: 'business' }, []);

---

<Layout bodyClass="business-site business-home" title="Home" description="Surrey Business Society connects University of Surrey students with business events, workshops, networking, enterprise support, and practical career skills.">
  <section class="business-hero business-hero--home business-hero--campus" aria-labelledby="business-hero-title">
    <div class="business-hero__frame">
      <Image
        src={heroImage}
        alt=""
        class="business-hero__image"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="(max-width: 820px) 1440px, 100vw"
        format="webp"
        quality={85}
      />
      <div class="business-shell business-hero__content">
        <h1 id="business-hero-title"><span>Meet Surrey’s</span><span>business</span><span>community.</span></h1>
        <p class="business-hero__lede business-reveal">Talks, workshops and socials.<br />Open to every Surrey student.</p>
        <div class="business-hero__actions business-reveal" data-hero-actions>
          <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society <ArrowRight size={20} aria-hidden="true" /></a>
          <a href="#activities" class="business-button business-button--outline">Explore events</a>
        </div>
      </div>
    </div>
  </section>

  <BusinessEditorial society={society} />
  <BusinessCommittee society={society} committee={committee} />
  <BusinessJoin society={society} />
  <BusinessFooter slot="footer" society={society} />
</Layout>
