---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'business';
const client = createConvexClient();

const events: any[] = (
  await client.query('events:listPublished', { societySlug: SOCIETY_ID })
).filter((event: any) => event.status === 'published');

const committee: any[] = (
  await client.query('committee:listActive', { societySlug: SOCIETY_ID })
).sort(
  (a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) -
    (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
);

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
};

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((w) => w[0]).join('').toUpperCase();
};
---

<Layout
  title="Home"
  description="Surrey Business Society — A student-led community for careers, entrepreneurship, networking, and commercial thinking at the University of Surrey."
>

  <!-- ── Hero ── -->
  <section class="bg-navy-deep text-text-on-dark relative overflow-hidden border-b border-border-dark pt-28 pb-24 sm:pt-40 sm:pb-32">
    <!-- Subtle dot grid -->
    <div class="bg-dot-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <!-- Gold bar at bottom -->
    <div class="absolute bottom-0 left-0 w-full h-px bg-gold/30" aria-hidden="true"></div>

    <div class="mx-auto max-w-6xl px-6 relative z-10">
      <div class="max-w-2xl">
        <p class="eyebrow mb-6 reveal">Student Professional Network</p>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-[4.5rem] font-bold tracking-tight leading-[1.08] reveal">
          Surrey <em class="text-gold not-italic">Business</em> Society
        </h1>
        <p class="mt-7 text-base sm:text-lg text-text-on-dark-secondary leading-relaxed max-w-xl border-l border-gold/40 pl-4 reveal">
          Surrey's student-led hub for ambitious students of all disciplines. Develop commercial awareness, build a professional network, and bridge the gap between your degree and your career.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-3 reveal">
          <a href="/join" class="btn-primary">
            Join the Society <span aria-hidden="true">→</span>
          </a>
          <a href="/events" class="btn-ghost">
            Programme
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Our Focus ── -->
  <section class="py-20 sm:py-28 px-6 bg-surface border-b border-border">
    <div class="mx-auto max-w-6xl">
      <header class="mb-14 reveal">
        <p class="eyebrow mb-4">Our Focus</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">
          What the society does
        </h2>
      </header>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-border border border-border">
        {[
          {
            num: '01',
            title: 'Careers',
            body: 'Graduate roles, internships, and sector insight sessions to help you navigate the transition from academia to professional life.',
          },
          {
            num: '02',
            title: 'Enterprise',
            body: 'Founder talks and startup-focused discussions for students exploring entrepreneurship, ideation, and early-stage ventures.',
          },
          {
            num: '03',
            title: 'Networking',
            body: 'Structured and informal events that build meaningful peer connections with ambitious students across disciplines.',
          },
          {
            num: '04',
            title: 'Skills',
            body: 'Practical workshops on commercial awareness, presentation, negotiation, and interview preparation.',
          },
        ].map(item => (
          <div class="bg-surface-card p-8 hover:bg-surface-alt transition-colors reveal">
            <span class="block text-3xl font-black text-border mb-5 leading-none">{item.num}</span>
            <h3 class="text-sm font-bold uppercase tracking-widest text-text-primary mb-3">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Events Preview ── -->
  <section class="bg-navy-deep text-text-on-dark py-20 sm:py-28 px-6 border-b border-border-dark relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <header class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4 border-b border-border-dark pb-8 reveal">
        <div>
          <p class="eyebrow mb-3" style="color:var(--color-gold)">Programme</p>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight">Upcoming Events</h2>
        </div>
        <a href="/events" class="text-xs font-bold uppercase tracking-widest text-gold hover:text-gold-light transition-colors inline-flex items-center gap-1.5">
          Full programme <span aria-hidden="true">→</span>
        </a>
      </header>

      {events.length === 0 ? (
        <div class="border border-border-dark px-8 py-12 reveal">
          <p class="eyebrow mb-4" style="color:var(--color-gold)">Coming soon</p>
          <h3 class="font-serif text-2xl font-semibold mb-3">Programme in development</h3>
          <p class="text-text-on-dark-secondary text-sm leading-relaxed max-w-lg">
            Events for this academic year are being planned. Follow our social channels for announcements.
          </p>
        </div>
      ) : (
        <ol class="divide-y divide-border-dark" role="list">
          {events.slice(0, 4).map(event => (
            <li class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-7 hover:bg-white/[0.03] transition-colors px-2 -mx-2 reveal" role="listitem">
              <div class="sm:w-40 shrink-0">
                <p class="text-[10px] font-bold uppercase tracking-widest text-gold mb-1">{event.category || 'Event'}</p>
                <p class="text-sm text-text-on-dark-secondary font-medium">{formatEventDate(event.date)}</p>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-serif text-xl font-semibold text-text-on-dark leading-snug">{event.title}</h3>
                {event.description && (
                  <p class="text-sm text-text-on-dark-secondary mt-1 leading-relaxed line-clamp-2">{event.description}</p>
                )}
              </div>
              <a href="/events" class="text-xs font-bold uppercase tracking-widest text-gold/70 hover:text-gold transition-colors shrink-0 inline-flex items-center gap-1">
                Details <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <!-- ── Committee Preview ── -->
  <section class="py-20 sm:py-28 px-6 bg-surface border-b border-border">
    <div class="mx-auto max-w-6xl">
      <header class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4 border-b border-border pb-8 reveal">
        <div>
          <p class="eyebrow mb-3">Committee</p>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">Current Leadership</h2>
        </div>
        <a href="/committee" class="text-xs font-bold uppercase tracking-widest text-gold hover:text-gold-dark transition-colors inline-flex items-center gap-1.5">
          Full committee <span aria-hidden="true">→</span>
        </a>
      </header>

      {committee.length === 0 ? (
        <div class="border border-border px-8 py-12 reveal">
          <p class="eyebrow mb-4">Coming soon</p>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-2">Committee details coming soon</h3>
          <p class="text-text-secondary text-sm leading-relaxed max-w-lg">Meet the team once the academic year committee has been confirmed.</p>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-border border border-border reveal">
          {committee.slice(0, 8).map(member => (
            <div class="bg-surface-card p-6 hover:bg-surface-alt transition-colors">
              <div class="w-10 h-10 bg-navy-deep flex items-center justify-center text-gold font-semibold text-sm mb-4">
                {getInitials(member.name, member.role)}
              </div>
              <p class="text-xs font-bold uppercase tracking-widest text-gold mb-1">{member.role}</p>
              <p class="text-sm font-medium text-text-primary">{member.name}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Join CTA ── -->
  <section class="bg-navy-deep text-text-on-dark py-20 sm:py-28 px-6 border-t-2 border-gold relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-50" aria-hidden="true"></div>
    <div class="mx-auto max-w-4xl relative z-10 reveal">
      <p class="eyebrow mb-6 justify-center" style="color:var(--color-gold)">Open to all students</p>
      <h2 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-center mb-6">Join the Society</h2>
      <p class="text-text-on-dark-secondary text-base text-center mb-10 max-w-xl mx-auto leading-relaxed">
        Whether you're focused on consulting, finance, startups, or simply curious about business — membership is open to every University of Surrey student.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href="/join" class="btn-primary justify-center">
          Become a Member <span aria-hidden="true">→</span>
        </a>
        <a href="/about" class="btn-ghost justify-center">
          Learn More
        </a>
      </div>
    </div>
  </section>

</Layout>
