---
export const prerender = false;

import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/generated/business-events-campus-sketch-hero.optimized.webp';
import '../styles/global.css';

const society = getSocietyById('business')!;
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");
const events: any[] = await queryPublicConvex(api.events.listPublished, { societySlug: 'business' }, []);
const categories = [...new Set(events.map((event) => event.category || 'Event'))];

const formatEventDate = (date?: string) => {
  if (!date) return 'Date to be confirmed';
  const parsed = new Date(`${date}T00:00:00`);
  return Number.isNaN(parsed.getTime()) ? date : parsed.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
};

const formatEventTime = (event: any) => event.startTime ? `${event.startTime}${event.endTime ? `-${event.endTime}` : ''}` : '';

const formats = [
  { title: 'Talks and panels', copy: 'Hear from founders, employers, alumni, and professionals with useful experience.' },
  { title: 'Workshops', copy: 'Practise skills you can use in applications, interviews, projects, and workplaces.' },
  { title: 'Challenges', copy: 'Test ideas, solve problems, and build confidence by doing the work.' },
  { title: 'Networking', copy: 'Meet students and industry contacts in a setting built for conversation.' },
];
---

<Layout title="Events" description="See confirmed Surrey Business Society events, workshops, talks, and networking opportunities.">
  <section class="business-hero business-hero--page business-hero--campus" aria-labelledby="events-title">
    <Image
      src={heroImage}
      alt=""
      aria-hidden="true"
      class="business-hero__image"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
    />
    <div class="business-shell business-hero__content">
      <p class="business-hero__eyebrow business-reveal">Events</p>
      <h1 id="events-title" class="business-reveal">Business events for Surrey students.</h1>
      <p class="business-hero__lede business-reveal">Talks, workshops, networking sessions, and opportunities that make careers, enterprise, and commercial skills easier to act on.</p>
      <div class="business-hero__actions business-reveal">
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="business-button">Follow updates</a>
        <a href="/join" class="business-button business-button--outline">Join the society</a>
      </div>
    </div>
  </section>

  <section class="business-section business-section--paper" aria-labelledby="programme-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal">
        <div>
          <p class="business-eyebrow">Upcoming</p>
          <h2 id="programme-title" class="business-title">Confirmed events.</h2>
        </div>
        <p>Dates, locations, and sign-up details appear here once they are confirmed by the committee.</p>
      </div>

      {events.length ? (
        <>
          {categories.length > 1 && (
            <div class="business-filter-bar business-reveal" aria-label="Filter events by category">
              <button type="button" class="business-filter-button is-active" data-event-filter="all" aria-pressed="true">All</button>
              {categories.map((category) => <button type="button" class="business-filter-button" data-event-filter={category} aria-pressed="false">{category}</button>)}
            </div>
          )}
          <div class="business-event-list business-reveal" data-event-list>
            {events.map((event) => (
              <article class="business-event-row" data-event-card data-category={event.category || 'Event'}>
                <div class="business-event-row__meta">
                  <time>{formatEventDate(event.date)}</time>
                  {formatEventTime(event) && <span>{formatEventTime(event)}</span>}
                  {event.location && <span>{event.location}</span>}
                </div>
                <div>
                  <h3>{event.title}</h3>
                  <p>{event.description || 'Further details will be shared soon.'}</p>
                </div>
                {event.registrationUrl && <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="business-button business-event-row__action">Register</a>}
              </article>
            ))}
          </div>
        </>
      ) : (
        <div class="business-empty business-reveal">
          <h3>No events are listed yet.</h3>
          <div>
            <p>New talks, workshops, and networking opportunities will appear here once confirmed. Follow the society for updates.</p>
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="business-text-link" style="display: inline-block; margin-top: 1rem;">Follow on Instagram</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="business-section business-section--ink" aria-labelledby="formats-title">
    <div class="business-shell">
      <div class="business-section__heading business-reveal">
        <div>
          <p class="business-eyebrow">Formats</p>
          <h2 id="formats-title" class="business-title">What to expect.</h2>
        </div>
        <p>Each event is built to help members learn something, meet someone, or take a useful next step.</p>
      </div>
      <div class="business-lines business-lines--four business-reveal">
        {formats.map((format, index) => (
          <article class="business-line"><span class="business-line__number">0{index + 1}</span><h3>{format.title}</h3><p>{format.copy}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="business-join-band" aria-labelledby="events-join-title">
    <div class="business-shell business-join-band__inner">
      <div><h2 id="events-join-title">Want access to what comes next?</h2><p>Become a member, then follow the events calendar and society channels for confirmed activity.</p></div>
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="business-button">Join the society</a>
    </div>
  </section>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-event-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-event-card]'));
    filters.forEach((filter) => filter.addEventListener('click', () => {
      const active = filter.dataset.eventFilter || 'all';
      filters.forEach((candidate) => {
        const selected = candidate === filter;
        candidate.classList.toggle('is-active', selected);
        candidate.setAttribute('aria-pressed', String(selected));
      });
      cards.forEach((card) => card.toggleAttribute('hidden', active !== 'all' && card.dataset.category !== active));
    }));
  </script>
</Layout>
