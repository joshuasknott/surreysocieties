---
export const prerender = false;
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import eventsProgramme from '../assets/generated/business-events-programme.png';
import '../styles/global.css';

const SOCIETY_ID = 'business';
const society = getSocietyById(SOCIETY_ID)!;

const events: any[] = (
  await queryPublicConvex<any[]>('events:listPublished', { societySlug: SOCIETY_ID }, [])
).filter((event: any) => event.status === 'published');

const categories = [...new Set(events.map((event) => event.category || 'Event'))];

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};

const formatEventTime = (event: any) => {
  if (!event.startTime) return '';
  return `${event.startTime}${event.endTime ? ` - ${event.endTime}` : ''}`;
};

const programmeLanes = [
  {
    title: 'Career direction',
    copy: 'Sessions that help students understand sectors, applications, interviews, and professional expectations.',
  },
  {
    title: 'Enterprise thinking',
    copy: 'Conversations around ideas, pitching, venture-building, and how commercial opportunities are shaped.',
  },
  {
    title: 'Networking confidence',
    copy: 'Formats that make meeting peers and speaking professionally feel more approachable.',
  },
  {
    title: 'Practical skills',
    copy: 'Workshops focused on communication, CVs, commercial awareness, presentation, and leadership habits.',
  },
];

const eventFormats = [
  {
    title: 'Skill workshops',
    copy: 'Practical sessions for CVs, applications, interviews, presentations, and commercial awareness.',
  },
  {
    title: 'Speaker evenings',
    copy: 'Talks and Q&A formats that help members understand real sectors, routes, and professional stories.',
  },
  {
    title: 'Enterprise sessions',
    copy: 'Idea-focused activity around pitching, customer thinking, problem framing, and early venture confidence.',
  },
  {
    title: 'Social connection',
    copy: 'Low-pressure ways to meet other students who are also building career direction and professional confidence.',
  },
];
---

<Layout
  title="Events"
  description="Confirmed Surrey Business Society events, programme updates, and practical careers, enterprise, networking, and skills activity."
>
  <section class="club-hero" aria-labelledby="events-title">
    <div class="club-hero__inner">
      <div class="max-w-4xl reveal">
        <h1 id="events-title" class="heading-serif text-5xl leading-none text-text-on-dark sm:text-6xl lg:text-7xl">
          Events with<br /><span class="text-gold">a practical purpose.</span>
        </h1>
        <p class="mt-7 max-w-2xl border-l border-gold/60 pl-5 text-lg leading-8 text-text-on-dark-secondary">
          Confirmed society events appear here. Every listing should help members understand what is happening, where it is happening, and how to take part.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface px-5 py-20 sm:px-6 sm:py-28" aria-labelledby="event-ledger-title">
    <div class="business-shell">
      <div class="business-feature mb-16 reveal">
        <div class="business-feature__media">
          <Image
            src={eventsProgramme}
            alt="An illustrated event planning board with calendar cards, lanyards, notebooks, and a lecture room backdrop."
            class="business-feature__image"
            loading="lazy"
          />
        </div>
        <div class="business-feature__body">
          <h2 class="heading-serif text-3xl leading-tight text-text-primary sm:text-4xl">
            A programme built around useful reasons to show up.
          </h2>
          <div class="business-mini-grid mt-7">
            {eventFormats.map((format) => (
              <article>
                <h3>{format.title}</h3>
                <p>{format.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="reveal">
          <h2 id="event-ledger-title" class="heading-serif text-4xl leading-tight text-text-primary sm:text-5xl">
            The society programme, once published.
          </h2>
        </div>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="btn-secondary reveal">
          Follow updates
        </a>
      </div>

      {events.length > 0 ? (
        <>
          {categories.length > 1 && (
            <div class="mb-8 flex flex-wrap gap-3 reveal" aria-label="Filter events by category">
              <button type="button" class="btn-primary text-sm" data-event-filter="all" aria-pressed="true">All</button>
              {categories.map((category) => (
                <button type="button" class="btn-secondary text-sm" data-event-filter={category} aria-pressed="false">{category}</button>
              ))}
            </div>
          )}

          <div class="ledger-list reveal" data-event-list>
            {events.map((event) => (
              <article class="ledger-row" data-event-card data-category={event.category || 'Event'}>
                <div>
                  <p class="ledger-row__meta">{event.category || 'Event'}</p>
                  <time class="mt-3 block font-bold text-text-primary">{formatEventDate(event.date)}</time>
                  {formatEventTime(event) && (
                    <p class="mt-2 text-sm font-semibold text-text-muted">{formatEventTime(event)}</p>
                  )}
                  {event.location && (
                    <p class="mt-2 text-sm font-semibold text-text-muted">{event.location}</p>
                  )}
                </div>
                <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
                  <div>
                    <h3 class="mb-3 font-serif text-2xl font-bold text-text-primary">{event.title}</h3>
                    {event.description ? (
                      <p class="max-w-3xl text-base leading-7 text-text-secondary">{event.description}</p>
                    ) : (
                      <p class="max-w-3xl text-base leading-7 text-text-secondary">Further details will be confirmed soon.</p>
                    )}
                  </div>
                  {event.registrationUrl && (
                    <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">
                      Register
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </>
      ) : (
        <div class="business-dashed-panel business-dashed-panel--light reveal">
          <div>
            <span class="business-icon-disc mx-auto" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4"/><path d="M16 3v4"/><path d="M4 10h16"/></svg>'} />
            <h2 class="mt-5 font-serif text-3xl font-bold text-text-primary">Events will appear here once confirmed.</h2>
            <p class="mx-auto mt-3 max-w-xl text-base leading-7 text-text-secondary">
              The public schedule is kept factual. When a date, location, and joining route are ready, they will be listed here with the details members need.
            </p>
            <div class="business-action-strip mt-7 justify-center">
              <a href="/join" class="btn-primary">Join for updates</a>
              <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">Students' Union page</a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <div class="business-ornament bg-surface" aria-hidden="true">
    <svg viewBox="0 0 80 56" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M40 56V28"/>
      <path d="M40 28c-8-16-20-24-36-26"/>
      <path d="M40 28c8-16 20-24 36-26"/>
      <path d="M18 8c-6-4-12-6-18-7"/>
      <path d="M62 8c6-4 12-6 18-7"/>
      <path d="M28 14c-6 0-13-2-18-6"/>
      <path d="M52 14c6 0 13-2 18-6"/>
    </svg>
  </div>

  <section class="bg-surface-alt px-5 py-20 sm:px-6 sm:py-28" aria-labelledby="programme-lanes-title">
    <div class="business-shell">
      <div class="business-section-title mx-auto mb-12 max-w-3xl reveal">
        <h2 id="programme-lanes-title" class="heading-serif text-4xl leading-tight text-text-primary sm:text-5xl">
          What the events are designed to support.
        </h2>
      </div>

      <div class="programme-grid reveal">
        {programmeLanes.map((lane) => (
          <article>
            <h3 class="mb-4 font-serif text-2xl font-bold text-text-primary">{lane.title}</h3>
            <p class="text-base leading-7 text-text-secondary">{lane.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-event-filter]'));
    const eventCards = Array.from(document.querySelectorAll<HTMLElement>('[data-event-card]'));

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const activeCategory = button.dataset.eventFilter || 'all';

        filterButtons.forEach((candidate) => {
          const isActive = candidate === button;
          candidate.setAttribute('aria-pressed', String(isActive));
          candidate.classList.toggle('btn-primary', isActive);
          candidate.classList.toggle('btn-secondary', !isActive);
        });

        eventCards.forEach((card) => {
          const shouldShow = activeCategory === 'all' || card.dataset.category === activeCategory;
          card.toggleAttribute('hidden', !shouldShow);
        });
      });
    });
  </script>
</Layout>
