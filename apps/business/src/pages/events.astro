---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'business';
const client = createConvexClient();
const events: any[] = (await client.query('events:listPublished', { societySlug: SOCIETY_ID }))
  .filter((event: any) => event.status === 'published');

const formatEventDate = (date?: string) => {
  if (!date) return 'Date TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};
---

<Layout
  title="Programme & Events"
  description="Upcoming and planned events from Surrey Business Society - careers evenings, founder talks, networking socials, and workshops."
>

  <!-- Section 1: Hero -->
  <section class="bg-navy-deep text-text-on-dark pt-32 pb-24 sm:pt-40 sm:pb-32 px-6 border-b border-border-dark relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gold/30" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-tight reveal">
        Programme & Events
      </h1>
    </div>
  </section>

  <!-- Section 2: The Ledger -->
  <section class="py-24 sm:py-32 px-6 bg-surface">
    <div class="mx-auto max-w-5xl">

      {events.length > 0 ? (
        <div class="flex flex-col border-t border-border-dark reveal">
          {events.map(event => (
            <div class="flex flex-col md:flex-row gap-6 md:gap-16 py-12 border-b border-border-dark">
              <div class="shrink-0 md:w-48">
                <p class="text-xs font-bold uppercase tracking-widest text-gold-dark mb-2">{event.category || 'Event'}</p>
                <p class="text-base font-semibold text-text-primary mb-1">{formatEventDate(event.date)}</p>
                {event.startTime && (
                  <p class="text-sm text-text-muted">
                    {event.startTime}{event.endTime ? ` - ${event.endTime}` : ''}
                  </p>
                )}
                {event.location && (
                  <p class="text-sm text-text-muted mt-2">{event.location}</p>
                )}
              </div>
              <div class="flex-1">
                <h3 class="font-serif text-2xl font-bold text-text-primary mb-4">{event.title}</h3>
                {event.description && (
                  <p class="text-base text-text-secondary leading-relaxed max-w-2xl">{event.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <!-- Section 3: Our Programme Areas (Empty State) -->
        <div class="reveal">
          <header class="mb-16">
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-text-primary mb-6">Our Upcoming Programme</h2>
            <p class="text-lg text-text-secondary max-w-2xl leading-relaxed">
              While our schedule for the current period is being finalised, the Surrey Business Society runs a robust series of events designed to provide distinct professional advantages.
            </p>
          </header>
          
          <div class="grid md:grid-cols-3 gap-x-12 gap-y-16 border-t border-border-dark pt-16">
            <div>
              <h3 class="text-xs font-bold uppercase tracking-widest text-text-primary mb-4 border-b border-border-dark pb-4">Industry Guest Lectures</h3>
              <p class="text-base text-text-secondary leading-loose">
                Talks and discussions that help students understand sectors, roles, recruitment expectations, and the current commercial landscape.
              </p>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-widest text-text-primary mb-4 border-b border-border-dark pb-4">Networking Evenings</h3>
              <p class="text-base text-text-secondary leading-loose">
                Sessions designed to make professional conversations easier, helping students meet peers across disciplines and practise networking in a supportive environment.
              </p>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-widest text-text-primary mb-4 border-b border-border-dark pb-4">Skills & CV Workshops</h3>
              <p class="text-base text-text-secondary leading-loose">
                Preparation meets opportunity. We run intensive clinics focused on CV optimisation, rigorous interview preparation, and the development of core commercial awareness competencies.
              </p>
            </div>
          </div>

          <div class="mt-16 pt-12 border-t border-border flex flex-col sm:flex-row items-start sm:items-center gap-6">
            <a href="/join" class="btn-primary">Join for updates <span aria-hidden="true">&rarr;</span></a>
            <p class="text-sm text-text-muted">
              Follow us on <a href="https://www.instagram.com/surreybusinesssociety/" target="_blank" rel="noopener noreferrer" class="text-gold-dark hover:text-navy-deep font-semibold">Instagram</a> or check the <a href="https://surreyunion.org" target="_blank" rel="noopener noreferrer" class="text-gold-dark hover:text-navy-deep font-semibold">Students' Union</a> for the latest.
            </p>
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
