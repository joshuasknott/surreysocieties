---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Join" description="Join Surrey Business Society — find out how to become a member, what you'll get, and how to connect with us.">

  <section class="bg-navy-deep text-text-on-dark py-24 sm:py-32 px-6 relative border-b-4 border-gold overflow-hidden gsap-section">
    <!-- Geometric Background Shapes -->
    <div class="absolute top-[20%] right-[10%] w-96 h-96 rounded-full bg-gold/5 blur-3xl mix-blend-screen gsap-parallax-shape pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-72 h-72 rounded-full bg-blue-500/10 blur-[80px] mix-blend-screen gsap-parallax-shape pointer-events-none" data-speed="0.8"></div>

    <div class="absolute inset-0 bg-grid-pattern-dark opacity-50 pointer-events-none"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="inline-flex items-center gap-3 mb-6 gsap-fade-up">
        <span class="w-12 h-0.5 bg-gold"></span>
        <span class="text-gold text-xs font-bold uppercase tracking-widest backdrop-blur-sm bg-navy/30 px-2 py-1">Membership</span>
      </div>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-text-on-dark gsap-fade-up">Join Us</h1>
      <p class="mt-8 text-xl text-text-on-dark-secondary max-w-2xl border-l-2 border-gold/50 pl-4 leading-relaxed gsap-fade-up">
        Membership is open to all University of Surrey students through Surrey Students' Union.
      </p>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight mb-8 text-navy">Why Join?</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-8 h-8 bg-navy flex items-center justify-center text-gold shrink-0 border border-gold/30 text-sm font-bold mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Access to careers events, networking socials, and professional workshops</p>
            </div>
            <div class="flex gap-4">
              <div class="w-8 h-8 bg-navy flex items-center justify-center text-gold shrink-0 border border-gold/30 text-sm font-bold mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Hear from founders, industry professionals, and alumni</p>
            </div>
            <div class="flex gap-4">
              <div class="w-8 h-8 bg-navy flex items-center justify-center text-gold shrink-0 border border-gold/30 text-sm font-bold mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Build your professional network with like-minded students</p>
            </div>
            <div class="flex gap-4">
              <div class="w-8 h-8 bg-navy flex items-center justify-center text-gold shrink-0 border border-gold/30 text-sm font-bold mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Develop real skills — presentation, negotiation, commercial awareness</p>
            </div>
            <div class="flex gap-4">
              <div class="w-8 h-8 bg-navy flex items-center justify-center text-gold shrink-0 border border-gold/30 text-sm font-bold mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Join a supportive, ambitious community across all disciplines</p>
            </div>
          </div>
        </div>

        <div class="bg-surface-alt p-10 border border-border-light relative">
          <div class="absolute top-0 left-0 w-full h-1 bg-gold"></div>
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight mb-6 text-navy">Who Can Join?</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            Any student at the University of Surrey. We welcome students from all courses and all years — business knowledge is not required.
          </p>
          <p class="text-text-secondary leading-relaxed">
            Membership is managed through Surrey Students' Union. You can sign up on their website — the link will be available once our membership page is live.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-navy-deep py-24 sm:py-32 px-6 border-y border-border-dark relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern-dark opacity-30"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="bg-navy-deep border border-border-dark shadow-xl p-10 sm:p-16 text-center text-text-on-dark max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight mb-6">Become a Member</h2>
        <p class="text-text-on-dark-secondary mb-10 text-lg leading-relaxed">Membership is handled through Surrey Students' Union.</p>
        <a href="#" class="inline-block px-10 py-5 bg-gold hover:bg-gold-light text-navy-deep font-bold text-sm tracking-widest uppercase transition-all shadow-md">
          Surrey Union Link — Coming Soon
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-surface">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 class="text-3xl font-black uppercase tracking-tight mb-8 text-navy">Stay Connected</h2>
          <div class="grid gap-px bg-border-light border border-border-light">
            <div class="bg-surface-card p-6 hover:bg-surface-alt transition-colors">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">Instagram</h3>
              <p class="text-text-muted text-sm leading-relaxed">Coming soon — follow us for event announcements and updates.</p>
            </div>
            <div class="bg-surface-card p-6 hover:bg-surface-alt transition-colors">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">LinkedIn</h3>
              <p class="text-text-muted text-sm leading-relaxed">Coming soon — connect with us professionally.</p>
            </div>
            <div class="bg-surface-card p-6 hover:bg-surface-alt transition-colors">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">Email</h3>
              <p class="text-text-muted text-sm leading-relaxed">Contact details coming soon.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-3xl font-black uppercase tracking-tight mb-8 text-navy">FAQ</h2>
          <div class="space-y-8">
            <div class="border-l-2 border-gold pl-6">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">Do I need to study business?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">No. We welcome students from all courses. Commercial skills and professional development are valuable for everyone.</p>
            </div>
            <div class="border-l-2 border-gold pl-6">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">Is there a membership fee?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Fees are set through Surrey Students' Union and will be confirmed on our membership page.</p>
            </div>
            <div class="border-l-2 border-gold pl-6">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">What kind of events do you run?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Careers evenings, founder talks, networking socials, workshops, and more. See our events page for what's planned.</p>
            </div>
            <div class="border-l-2 border-gold pl-6">
              <h3 class="font-bold uppercase tracking-wide mb-2 text-navy">Can I get involved in organising events?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Yes — as a member, you can volunteer to help with events. Committee elections happen through the Students' Union.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof window.gsap !== 'undefined' && typeof window.ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);

        gsap.utils.toArray('.gsap-fade-up').forEach((elem: any) => {
          gsap.fromTo(elem, 
            { y: 40, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 1,
              ease: "power3.out",
              scrollTrigger: {
                trigger: elem,
                start: "top 85%",
                toggleActions: "play none none reverse"
              }
            }
          );
        });

        gsap.utils.toArray('.gsap-parallax-shape').forEach((shape: any) => {
          const speed = shape.getAttribute('data-speed') || 0.5;
          gsap.to(shape, {
            y: () => (ScrollTrigger.maxScroll(window) - (ScrollTrigger.maxScroll(window) * speed)),
            ease: "none",
            scrollTrigger: {
              trigger: shape.closest('.gsap-section') || document.body,
              start: "top bottom",
              end: "bottom top",
              scrub: 1
            }
          });
        });
      }
    });
  </script>
</Layout>
