---
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const society = getSocietyById('business')!;
---

<Layout
  title="Become a Member"
  description="Join Surrey Business Society - find out how to become a member, what you'll get, and how to connect with us."
>

  <!-- Section 1: Hero & Value (Split layout) -->
  <section class="bg-navy-deep text-text-on-dark pt-32 pb-24 sm:pt-40 sm:pb-32 px-6 border-b border-border-dark relative">
    <div class="bg-dot-dark absolute inset-0 pointer-events-none opacity-60" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-gold/30" aria-hidden="true"></div>
    
    <div class="mx-auto max-w-6xl relative z-10 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div class="reveal">
        <p class="eyebrow mb-6" style="color:var(--color-gold)">Membership</p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight leading-tight mb-8">
          Become a Member
        </h1>
        <p class="text-lg text-text-on-dark-secondary leading-relaxed mb-10 max-w-xl">
          Membership is open to all University of Surrey students through Surrey Students' Union. No prior business knowledge is required—only ambition and a willingness to learn.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={society.membershipUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary rounded-none"
          >
            Join via Students' Union <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      
      <div class="reveal">
        <h2 class="text-xs font-bold uppercase tracking-widest text-gold-dark mb-6 border-b border-border-dark pb-4">Membership Privileges</h2>
        <ul class="space-y-6 text-base text-text-on-dark-secondary" role="list">
          <li class="flex items-start">
            <span class="text-gold font-bold mr-4">—</span>
            <span>Priority access to highly subscribed careers events, founder talks, and guest lectures.</span>
          </li>
          <li class="flex items-start">
            <span class="text-gold font-bold mr-4">—</span>
            <span>Exclusive invitations to structured networking evenings with alumni and corporate partners.</span>
          </li>
          <li class="flex items-start">
            <span class="text-gold font-bold mr-4">—</span>
            <span>Entry to practical skills workshops, covering commercial awareness, negotiation, and interview technique.</span>
          </li>
          <li class="flex items-start">
            <span class="text-gold font-bold mr-4">—</span>
            <span>The opportunity to run for committee positions and directly shape the society's strategy.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 2: Contact & FAQ -->
  <section class="py-24 sm:py-32 px-6 bg-surface">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-12 gap-16 lg:gap-24">

        <!-- Contact Links -->
        <div class="lg:col-span-4 reveal">
          <h2 class="font-serif text-3xl font-bold text-text-primary mb-8">Connect</h2>
          <div class="flex flex-col gap-6">
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between border-b border-border pb-6">
              <span class="text-sm font-bold uppercase tracking-widest text-text-primary group-hover:text-gold-dark transition-colors">Instagram</span>
              <span class="text-gold" aria-hidden="true">→</span>
            </a>
            <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between border-b border-border pb-6">
              <span class="text-sm font-bold uppercase tracking-widest text-text-primary group-hover:text-gold-dark transition-colors">LinkedIn</span>
              <span class="text-gold" aria-hidden="true">→</span>
            </a>
            <a href={`mailto:${society.contactEmail}`} class="group flex items-center justify-between border-b border-border pb-6">
              <span class="text-sm font-bold uppercase tracking-widest text-text-primary group-hover:text-gold-dark transition-colors">Email</span>
              <span class="text-gold" aria-hidden="true">→</span>
            </a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between border-b border-border pb-6">
              <span class="text-sm font-bold uppercase tracking-widest text-text-primary group-hover:text-gold-dark transition-colors">Students' Union</span>
              <span class="text-gold" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- FAQ via <details> -->
        <div class="lg:col-span-8 reveal">
          <h2 class="font-serif text-3xl font-bold text-text-primary mb-8">Frequently Asked Questions</h2>
          <div class="border-t border-border-dark">
            {[
              {
                q: 'Do I need to be studying a business degree?',
                a: 'Absolutely not. The society is explicitly cross-disciplinary. Commercial skills, strategic thinking, and a strong professional network are vital whether you are studying engineering, law, the arts, or the sciences.',
              },
              {
                q: 'How much does membership cost?',
                a: 'Membership fees are standardised and administered by the Surrey Students\' Union. Current pricing is always listed directly on the official union checkout page.',
              },
              {
                q: 'How long does membership last?',
                a: 'Standard membership lasts for the duration of the academic year. You will need to renew your membership each autumn to retain access to events and voting rights.',
              },
              {
                q: 'How can I join the committee?',
                a: 'Committee positions are determined via democratic elections held annually through the Students\' Union. To be eligible to run or vote, you must first be an active, registered member of the society.',
              },
            ].map(({ q, a }) => (
              <details class="group border-b border-border-dark py-6">
                <summary class="flex justify-between items-center cursor-pointer list-none focus:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-4">
                  <h3 class="text-sm font-bold uppercase tracking-widest text-text-primary group-hover:text-gold-dark transition-colors pr-8">{q}</h3>
                  <span class="text-gold shrink-0 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <div class="mt-6 text-base text-text-secondary leading-relaxed max-w-3xl">
                  <p>{a}</p>
                </div>
              </details>
            ))}
          </div>
          
          <style>
            /* Hide the default marker for Webkit */
            details > summary::-webkit-details-marker {
              display: none;
            }
          </style>
        </div>

      </div>
    </div>
  </section>

</Layout>
