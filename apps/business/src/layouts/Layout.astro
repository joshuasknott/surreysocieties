---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import { getSocietyById } from '@surreysocieties/admin/config';

interface Props {
  title: string;
  description: string;
  /** Absolute URL to OG share image. Defaults to site-wide fallback. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const society = getSocietyById('business')!;
const siteName = society.name;
const fullTitle = `${title} — ${siteName}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/committee', label: 'Committee' },
  { href: '/events', label: 'Events' },
  { href: '/join', label: 'Join' },
];
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="bg-surface text-text-primary font-sans min-h-screen flex flex-col transition-colors duration-200"
  extraFontHrefs={[
    'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap',
  ]}
>
  <!-- Theme Init Script — runs before paint to prevent FOUC -->
  <script is:inline>
    const getTheme = () => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('surrey-biz-theme')) {
        return localStorage.getItem('surrey-biz-theme');
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };
    const theme = getTheme();
    document.documentElement.setAttribute('data-theme', theme);
  </script>
  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-navy-deep border-b-4 border-gold">
    <div class="mx-auto max-w-6xl px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-4 group">
        <img
          src="/logos/sbs-logo.png"
          alt="Surrey Business Society"
          width="40"
          height="40"
          class="h-10 w-10 transition-transform group-hover:scale-105"
        />
        <span class="text-text-on-dark font-bold text-lg tracking-widest uppercase hidden sm:block border-l border-gold/30 pl-4">
          Surrey <span class="text-gold">Business</span> Society
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-stretch h-full">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-5 flex items-center text-sm font-bold tracking-wider uppercase transition-all border-b-4 border-transparent hover:bg-white/5',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold border-gold bg-white/5'
                : 'text-text-on-dark-secondary hover:text-text-on-dark',
            ]}
          >
            {link.label}
          </a>
        ))}

        <!-- Theme Toggle -->
        <button
          type="button"
          id="theme-toggle"
          aria-label="Switch to dark mode"
          class="px-5 flex items-center text-text-on-dark-secondary hover:text-text-on-dark hover:bg-white/5 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <svg id="theme-icon-dark" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-text-on-dark p-2 hover:text-gold transition-colors"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gold/30 bg-navy-deep">
      <div class="flex flex-col">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-6 py-4 text-sm font-bold tracking-wider uppercase transition-colors border-l-4 border-transparent',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold bg-white/5 border-gold'
                : 'text-text-on-dark-secondary hover:text-text-on-dark hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
        <button
          type="button"
          id="mobile-theme-toggle"
          class="px-6 py-4 flex items-center gap-3 text-sm font-bold tracking-wider uppercase text-text-on-dark-secondary hover:text-text-on-dark hover:bg-white/5 transition-colors border-l-4 border-transparent text-left"
        >
          <svg id="mobile-theme-icon-dark" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg id="mobile-theme-icon-light" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span id="mobile-theme-text">Toggle Theme</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-navy-deep text-text-on-dark-secondary border-t border-border-dark relative">
    <div class="absolute inset-0 bg-grid-pattern-dark opacity-30 pointer-events-none"></div>
    <div class="mx-auto max-w-6xl px-6 py-16 relative z-10">
      <div class="grid sm:grid-cols-12 gap-8 mb-12">
        <div class="sm:col-span-5 lg:col-span-4">
          <div class="flex items-center gap-4 mb-6">
            <img
              src="/logos/sbs-logo.png"
              alt=""
              width="40"
              height="40"
              class="h-10 w-10"
            />
            <span class="text-text-on-dark font-bold uppercase tracking-widest text-sm">Surrey Business Society</span>
          </div>
          <p class="text-sm leading-relaxed border-l-2 border-gold pl-4 text-text-on-dark-secondary">
            A student-led professional network under Surrey Students' Union. Building a community for careers, enterprise, and commercial thinking.
          </p>
          <p class="mt-4 text-[10px] font-bold uppercase tracking-widest text-gold">Established {society.establishedYear}</p>
        </div>
        <div class="sm:col-span-3 lg:col-span-2 lg:col-start-7">
          <h4 class="text-gold font-bold mb-5 text-xs uppercase tracking-widest">Navigation</h4>
          <div class="flex flex-col gap-3">
            {navLinks.map(link => (
              <a href={link.href} class="text-sm font-medium hover:text-white transition-colors">{link.label}</a>
            ))}
          </div>
        </div>
        <div class="sm:col-span-4 lg:col-span-3">
          <h4 class="text-gold font-bold mb-5 text-xs uppercase tracking-widest">Connect</h4>
          <div class="flex flex-col gap-3 text-sm font-medium">
            <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a>
            <a href={`mailto:${society.contactEmail}`} class="hover:text-white transition-colors">Email Us</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Surrey Students' Union</a>
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Membership</a>
          </div>
        </div>
      </div>
      <div class="border-t border-border-dark pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium">
        <p>&copy; 2025 Surrey Business Society.</p>
        <p class="text-gold tracking-widest uppercase text-[10px]">{society.domain}</p>
      </div>
    </div>
  </footer>

  <script>
    // ── Theme toggle ──
    const themeBtn = document.getElementById('theme-toggle');
    const iconDark = document.getElementById('theme-icon-dark');
    const iconLight = document.getElementById('theme-icon-light');

    const mobileThemeBtn = document.getElementById('mobile-theme-toggle');
    const mobileIconDark = document.getElementById('mobile-theme-icon-dark');
    const mobileIconLight = document.getElementById('mobile-theme-icon-light');
    const mobileThemeText = document.getElementById('mobile-theme-text');

    function updateThemeUI(theme: string) {
      const isDark = theme === 'dark';

      document.documentElement.setAttribute('data-theme', theme);

      iconDark?.classList.toggle('hidden', !isDark);
      iconLight?.classList.toggle('hidden', isDark);
      
      mobileIconDark?.classList.toggle('hidden', !isDark);
      mobileIconLight?.classList.toggle('hidden', isDark);
      if (mobileThemeText) {
        mobileThemeText.textContent = isDark ? 'Light Mode' : 'Dark Mode';
      }

      const ariaLabel = isDark ? 'Switch to light mode' : 'Switch to dark mode';
      themeBtn?.setAttribute('aria-label', ariaLabel);
      mobileThemeBtn?.setAttribute('aria-label', ariaLabel);
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeUI(currentTheme);

    const toggleTheme = () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const newTheme = isDark ? 'light' : 'dark';
      localStorage.setItem('surrey-biz-theme', newTheme);
      updateThemeUI(newTheme);
    };

    themeBtn?.addEventListener('click', toggleTheme);
    mobileThemeBtn?.addEventListener('click', toggleTheme);
  </script>
</BaseLayout>
