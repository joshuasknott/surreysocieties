---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import AssistantWidget from '@surreysocieties/ui/components/AssistantWidget';
import { ASSISTANT_CONFIGS } from '@surreysocieties/ui';
import { getSocietyById } from '@surreysocieties/admin/config';
import defaultOgImage from '../assets/generated/business-campus-ledger-hero.optimized.webp';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const resolvedOgImage = ogImage ?? new URL(defaultOgImage.src, Astro.site).toString();
const society = getSocietyById('business')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#activities', label: 'Activities' },
  { href: '/#join', label: 'Join' },
];
---

<BaseLayout
  title={`${title} | ${society.name}`}
  description={description}
  ogImage={resolvedOgImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="business-site min-h-screen flex flex-col"
  extraFontHrefs={[
    'https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:wght@600;700;800&display=swap',
  ]}
>
  <script slot="head" is:inline>
    document.documentElement.classList.add('js-enabled');
  </script>

  <a href="#main-content" class="business-skip-link">Skip to content</a>

  <nav class="business-nav" aria-label="Main navigation">
    <div class="business-nav__inner">
      <a href="/" class="business-nav__brand" aria-label="Surrey Business Society home">
        <img src="/logos/sbs-logo.png" alt="" width="48" height="48" class="business-nav__mark" loading="eager" decoding="async" />
        <span>Surrey Business Society</span>
      </a>

      <div class="business-nav__links">
        {navLinks.map((link) => (
          <a href={link.href} class="business-nav__link">
            {link.label}
          </a>
        ))}
      </div>

      <button
        id="mobile-menu-btn"
        class="business-nav__menu"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>

    <div id="mobile-menu" class="business-mobile-menu hidden">
      <div class="business-mobile-menu__inner">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
  </nav>

  <main id="main-content" class="flex-1" tabindex="-1"><slot /></main>

  <footer class="business-footer">
    <div class="business-footer__inner">
      <a href="/" class="business-footer__brand">
        <img src="/logos/sbs-logo.png" alt="" width="34" height="34" class="business-footer__mark" loading="lazy" decoding="async" />
        Surrey Business Society
      </a>
      <div class="business-footer__links">
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={`mailto:${society.contactEmail}`}>Email</a>
        <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer">Join via the Union</a>
      </div>
      <small>&copy; {new Date().getFullYear()} Surrey Business Society</small>
    </div>
  </footer>

  <AssistantWidget config={ASSISTANT_CONFIGS.business} endpoint="/api/assistant/chat" />

  <script>
    const button = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    button?.addEventListener('click', () => {
      const isOpening = menu?.classList.contains('hidden') ?? false;
      menu?.classList.toggle('hidden', !isOpening);
      button.classList.toggle('is-open', isOpening);
      button.setAttribute('aria-expanded', String(isOpening));
      button.setAttribute('aria-label', isOpening ? 'Close navigation menu' : 'Open navigation menu');
    });

    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menu.classList.add('hidden');
      button?.classList.remove('is-open');
      button?.setAttribute('aria-expanded', 'false');
      button?.setAttribute('aria-label', 'Open navigation menu');
    }));

  </script>
</BaseLayout>
