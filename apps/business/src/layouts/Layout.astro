---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import { getSocietyById } from '@surreysocieties/admin/config';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const society = getSocietyById('business')!;
const siteName = society.name;
const fullTitle = `${title} — ${siteName}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/',          label: 'Home' },
  { href: '/about',     label: 'About' },
  { href: '/committee', label: 'Committee' },
  { href: '/events',    label: 'Events' },
  { href: '/join',      label: 'Join' },
];
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="bg-surface text-text-primary font-sans min-h-screen flex flex-col"
  extraFontHrefs={[
    'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap',
  ]}
>
  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-navy-deep border-b border-border-dark" role="navigation" aria-label="Main navigation">
    <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group" aria-label="Surrey Business Society — Home">
        <img
          src="/logos/sbs-logo.png"
          alt=""
          width="32"
          height="32"
          class="h-8 w-8"
          aria-hidden="true"
        />
        <span class="text-text-on-dark font-semibold text-sm tracking-widest uppercase hidden sm:block border-l border-border-dark pl-3">
          Surrey <span class="text-gold">Business</span> Society
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-stretch h-full gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 flex items-center text-xs font-semibold tracking-widest uppercase transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold'
                : 'text-text-on-dark-secondary hover:text-text-on-dark',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href="/join"
          class="ml-4 my-auto px-5 py-2 text-xs font-bold tracking-widest uppercase text-navy-deep bg-gold hover:bg-gold-light transition-colors"
        >
          Join
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-text-on-dark p-2 hover:text-gold transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5" id="hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-5 h-5 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border-dark bg-navy-deep">
      <div class="flex flex-col py-2">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-6 py-3 text-xs font-semibold tracking-widest uppercase transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-gold'
                : 'text-text-on-dark-secondary hover:text-text-on-dark',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-navy-deep text-text-on-dark-secondary border-t border-border-dark">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid sm:grid-cols-12 gap-10 mb-12">
        <div class="sm:col-span-5 lg:col-span-4">
          <div class="flex items-center gap-3 mb-5">
            <img src="/logos/sbs-logo.png" alt="" width="28" height="28" class="h-7 w-7" aria-hidden="true" />
            <span class="text-text-on-dark font-semibold uppercase tracking-widest text-xs">Surrey Business Society</span>
          </div>
          <p class="text-sm leading-relaxed border-l border-gold pl-4 text-text-on-dark-secondary max-w-xs">
            A student-led professional network under Surrey Students' Union. Building community across careers, enterprise, and commercial thinking.
          </p>
          <p class="mt-5 text-[10px] font-bold uppercase tracking-widest text-gold/70">Est. {society.establishedYear}</p>
        </div>
        <div class="sm:col-span-3 lg:col-span-2 lg:col-start-7">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-gold/80 mb-4">Navigation</h4>
          <div class="flex flex-col gap-2.5">
            {navLinks.map(link => (
              <a href={link.href} class="text-xs font-medium hover:text-white transition-colors">{link.label}</a>
            ))}
          </div>
        </div>
        <div class="sm:col-span-4 lg:col-span-3">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-gold/80 mb-4">Connect</h4>
          <div class="flex flex-col gap-2.5 text-xs font-medium">
            <a href={society.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a>
            <a href={`mailto:${society.contactEmail}`} class="hover:text-white transition-colors">Email</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Surrey Students' Union</a>
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Join via USSU</a>
          </div>
        </div>
      </div>
      <div class="border-t border-border-dark pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
        <p>&copy; {new Date().getFullYear()} Surrey Business Society. A society of Surrey Students' Union.</p>
        <p class="text-gold/60 tracking-widest uppercase text-[10px]">{society.domain}</p>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu toggle — no theme logic
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    btn?.addEventListener('click', () => {
      const isOpen = menu?.classList.toggle('hidden') === false;
      hamburger?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);
      btn.setAttribute('aria-expanded', String(isOpen));
    });

    // CSS-driven scroll reveal
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</BaseLayout>
