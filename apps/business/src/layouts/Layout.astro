---
import SocietyLayout from '@surreysocieties/ui/components/SocietyLayout';
interface Props { title: string; description: string; ogImage?: string; bodyClass?: string; hideCTA?: boolean; }
const { title, description, ogImage, bodyClass = 'business-site' } = Astro.props;
---
<SocietyLayout societyKey="business" title={title} description={description} ogImage={ogImage} bodyClass={bodyClass} extraFontHrefs={["https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:wght@600;700;800&display=swap"]}>
  <slot />
</SocietyLayout>
