---
import unionMark from '../assets/brand/surrey-students-union-mark.webp';

interface Props {
  name: 'instagram' | 'linkedin' | 'email' | 'union' | string;
}

const { name } = Astro.props;
---

<span class:list={['brand-icon', `brand-icon--${name}`]} aria-hidden="true">
  {name === 'instagram' && (
    <svg viewBox="0 0 24 24" role="img">
      <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
    </svg>
  )}

  {name === 'linkedin' && (
    <svg viewBox="0 0 24 24" role="img">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
    </svg>
  )}

  {name === 'email' && (
    <svg viewBox="0 0 24 24" role="img">
      <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 3.2v.48l8 4.86 8-4.86V7.2L12 12.06 4 7.2Zm0 2.82V18h16v-7.98l-7.04 4.28a1.85 1.85 0 0 1-1.92 0L4 10.02Z" />
    </svg>
  )}

  {name === 'union' && (
    <img src={unionMark.src} alt="" loading="lazy" decoding="async" />
  )}
</span>
