---
import { getImage } from "astro:assets";
import robotHead from "../../assets/generated/ai-robot-head.png";

const robotHeadTexture = await getImage({
  src: robotHead,
  width: 768,
  format: "webp",
  quality: 70,
});
---

<section class="home-hero" aria-labelledby="home-hero-title" data-ai-robot-hero>
  <div class="home-hero__backplate" aria-hidden="true"></div>

  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <p class="home-hero__kicker" data-hero-reveal>New website launching this September</p>
      <h1 id="home-hero-title" class="home-hero__title" data-hero-reveal>
        Surrey Artificial Intelligence Society
      </h1>
      <p class="home-hero__intro" data-hero-reveal>
        Welcome to the new online home for Surrey students curious about artificial intelligence, machine learning, data science, and responsible technology.
      </p>
      <p class="home-hero__domains" data-hero-reveal>
        Beginner-friendly learning / workshops / community updates / responsible artificial intelligence / careers
      </p>

      <div class="home-hero__actions" data-hero-reveal>
        <a href="/join" class="btn-primary">Join the Society</a>
        <a href="#events" class="btn-secondary">See what's coming</a>
      </div>
    </div>

    <div class="home-hero__stage" aria-hidden="true">
      <canvas class="home-hero__canvas" id="ai-robot-head-canvas" data-robot-head-src={robotHeadTexture.src}></canvas>
      <div class="home-hero__fallback">
        <div class="home-hero__fallback-head">
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <nav class="home-hero__rail" aria-label="Surrey Artificial Intelligence Society quick links" data-hero-reveal>
      <a href="#events" class="home-hero__rail-item">
        <span>Events</span>
        <strong>Launch updates and first sessions</strong>
      </a>
      <a href="#explore" class="home-hero__rail-item">
        <span>Learning</span>
        <strong>Skills, tools, and impact</strong>
      </a>
      <a href="#projects" class="home-hero__rail-item">
        <span>Preview</span>
        <strong>What the website will unlock</strong>
      </a>
    </nav>
  </div>
</section>

<script>
  const hero = document.querySelector("[data-ai-robot-hero]") as HTMLElement | null;
  const canvas = document.getElementById("ai-robot-head-canvas") as HTMLCanvasElement | null;
  const stage = canvas?.closest(".home-hero__stage") as HTMLElement | null;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const startRobot = async () => {
    if (hero && canvas && stage) {
      try {
        const { startRobotHero } = await import("./robotHero.client");
        startRobotHero({ hero, canvas, stage, prefersReducedMotion });
      } catch {
        hero.classList.remove("home-hero--ready");
      }
    }
  };

  if (hero && canvas && stage) {
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(() => { void startRobot(); }, { timeout: 1200 });
    } else {
      window.setTimeout(() => { void startRobot(); }, 200);
    }
  }
</script>

<style>
  .home-hero {
    --hero-scroll-progress: 0;
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 8rem);
    color: var(--ai-fg);
    background:
      linear-gradient(112deg, var(--ai-bg) 0%, var(--ai-bg) 44%, color-mix(in srgb, var(--ai-azure) 11%, var(--ai-bg)) 74%, color-mix(in srgb, var(--ai-coral) 12%, var(--ai-bg)) 100%);
    border-bottom: 1px solid var(--ai-border);
    isolation: isolate;
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--ai-fg) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ai-fg) 6%, transparent) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%);
    opacity: 0.32;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--ai-bg) 0%, color-mix(in srgb, var(--ai-bg) 96%, transparent) 42%, transparent 76%),
      linear-gradient(0deg, color-mix(in srgb, var(--ai-bg) 86%, transparent) 0%, transparent 32%);
  }

  .home-hero__backplate {
    position: absolute;
    inset: auto -12rem -9rem 36%;
    z-index: 0;
    height: 18rem;
    transform: skewY(-8deg);
    background: linear-gradient(90deg, color-mix(in srgb, var(--ai-sage) 22%, transparent), color-mix(in srgb, var(--ai-coral) 18%, transparent));
    opacity: 0.48;
    pointer-events: none;
  }

  .home-hero__stage {
    grid-area: stage;
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 380px;
    min-width: 0;
  }

  .home-hero__canvas,
  .home-hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__canvas {
    z-index: 2;
  }

  .home-hero__fallback {
    z-index: 1;
    display: grid;
    place-items: center;
    opacity: 0.86;
    transition: opacity 0.25s ease;
  }

  .home-hero--ready .home-hero__fallback {
    opacity: 0;
  }

  .home-hero__fallback-head {
    width: 17rem;
    height: 13rem;
    border: 1px solid color-mix(in srgb, var(--ai-azure) 42%, transparent);
    border-radius: 8px;
    background: linear-gradient(145deg, color-mix(in srgb, var(--ai-surface) 85%, var(--ai-azure)), color-mix(in srgb, var(--ai-surface) 92%, var(--ai-coral)));
    box-shadow: 0 1.6rem 5rem color-mix(in srgb, var(--ai-azure) 16%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
  }

  .home-hero__fallback-head span {
    width: 3.4rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--ai-azure);
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 82rem);
    min-height: calc(100svh - 8rem);
    margin: 0 auto;
    padding: 4rem 2rem 1.45rem;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-rows: 1fr auto;
    grid-template-areas:
      "copy stage"
      "rail rail";
    gap: 2rem 4rem;
    align-items: center;
  }

  .home-hero__copy {
    grid-area: copy;
    max-width: 42rem;
  }

  .home-hero__kicker {
    margin: 0 0 1rem;
    color: var(--ai-azure);
    font-size: 0.82rem;
    line-height: 1.2;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-hero__title {
    max-width: 13ch;
    margin: 0;
    color: var(--ai-fg);
    font-size: 4.45rem;
    line-height: 1;
    letter-spacing: 0;
    font-weight: 850;
    text-wrap: balance;
  }

  .home-hero__intro {
    max-width: 37rem;
    margin: 1.2rem 0 0;
    color: var(--ai-fg-muted);
    font-size: 1.18rem;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .home-hero__domains {
    max-width: 40rem;
    margin: 1.2rem 0 0;
    color: color-mix(in srgb, var(--ai-fg) 74%, var(--ai-fg-muted));
    font-size: 0.96rem;
    font-weight: 800;
    line-height: 1.55;
    letter-spacing: 0;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .home-hero__actions .btn-primary,
  .home-hero__actions .btn-secondary {
    min-height: 3.1rem;
  }

  .home-hero__rail {
    grid-area: rail;
    width: min(100%, 64rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    transform: translateY(calc(var(--hero-scroll-progress) * -0.6rem));
  }

  .home-hero__rail-item {
    min-height: 5.1rem;
    padding: 1rem;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--ai-surface) 82%, transparent);
    color: var(--ai-fg);
    text-decoration: none;
    backdrop-filter: blur(18px);
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .home-hero__rail-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--ai-azure) 42%, var(--ai-border));
    background: color-mix(in srgb, var(--ai-surface) 92%, var(--ai-azure) 8%);
  }

  .home-hero__rail-item:focus-visible {
    outline: 2px solid var(--ai-azure);
    outline-offset: 3px;
  }

  .home-hero__rail-item span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ai-fg-muted);
    font-size: 0.78rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__rail-item strong {
    display: block;
    color: var(--ai-fg);
    font-size: 0.98rem;
    line-height: 1.35;
    letter-spacing: 0;
  }

  :global(:root[data-theme="dark"]) .home-hero {
    background:
      linear-gradient(112deg, var(--ai-bg) 0%, var(--ai-bg) 44%, color-mix(in srgb, var(--ai-azure) 18%, var(--ai-bg)) 74%, color-mix(in srgb, var(--ai-coral) 16%, var(--ai-bg)) 100%);
  }

  :global(:root[data-theme="dark"]) .home-hero__rail-item {
    background: color-mix(in srgb, var(--ai-surface) 74%, transparent);
  }

  @media (max-width: 1040px) {
    .home-hero__title {
      font-size: 3.7rem;
    }

    .home-hero__copy {
      max-width: 36rem;
    }
  }

  @media (max-width: 760px) {
    .home-hero {
      min-height: calc(100svh - 6.5rem);
      background:
        linear-gradient(160deg, var(--ai-bg) 0%, var(--ai-bg) 56%, color-mix(in srgb, var(--ai-azure) 12%, var(--ai-bg)) 82%, color-mix(in srgb, var(--ai-coral) 12%, var(--ai-bg)) 100%);
    }

    .home-hero::before {
      mask-image: linear-gradient(180deg, #000 0%, transparent 96%);
      background-size: 3.2rem 3.2rem;
    }

    .home-hero__backplate {
      inset: auto -10rem -8rem 12%;
      height: 14rem;
    }

    .home-hero__stage {
      position: absolute;
      inset: 7rem -5rem 0 44%;
      opacity: 0.24;
      min-height: 0;
      height: auto;
      z-index: -1;
    }

    .home-hero::after {
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--ai-bg) 98%, transparent) 0%, color-mix(in srgb, var(--ai-bg) 92%, transparent) 62%, transparent 100%),
        linear-gradient(0deg, color-mix(in srgb, var(--ai-bg) 82%, transparent) 0%, transparent 34%);
    }

    .home-hero__inner {
      min-height: calc(100svh - 6.5rem);
      padding: 1.8rem 1.2rem 1rem;
      gap: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .home-hero__copy {
      max-width: 100%;
    }

    .home-hero__kicker {
      margin-bottom: 0.7rem;
      font-size: 0.72rem;
    }

    .home-hero__title {
      max-width: 12ch;
      font-size: 2.42rem;
      line-height: 1.02;
    }

    .home-hero__intro {
      max-width: 29rem;
      margin-top: 0.9rem;
      font-size: 1rem;
      line-height: 1.46;
    }

    .home-hero__domains {
      margin-top: 0.85rem;
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .home-hero__actions {
      margin-top: 1.1rem;
      gap: 0.6rem;
    }

    .home-hero__actions .btn-primary,
    .home-hero__actions .btn-secondary {
      width: 100%;
      min-height: 2.75rem;
      padding: 0.8rem 1rem;
    }

    .home-hero__rail {
      grid-template-columns: 1fr;
      gap: 0.42rem;
    }

    .home-hero__rail-item {
      min-height: 0;
      padding: 0.66rem 0.8rem;
    }

    .home-hero__rail-item span {
      margin-bottom: 0.16rem;
      font-size: 0.66rem;
    }

    .home-hero__rail-item strong {
      font-size: 0.88rem;
    }
  }

  @media (max-width: 380px) {
    .home-hero__title {
      font-size: 2.2rem;
    }

    .home-hero__intro {
      font-size: 0.94rem;
    }

    .home-hero__domains {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__rail,
    .home-hero__rail-item,
    .home-hero__fallback {
      transition: none;
      transform: none;
    }
  }
</style>
